{{!
    @template report_certaintyquizzes/quizselector

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * quizs Available quizzes
        * id Quiz id
        * title Quiz name
        * selected Whether this option is currently selected

    Example context (json):
    {
        "quizs": [
            {
                "id": 1,
                "title": "Quiz 1",
                "selected": true
            },
            {
                "id": 2,
                "title": "Quiz 2"
            }
        ]
    }
}}
<select name="quizid" class="custom-select w-100 {{# invalid}}is-invalid{{/ invalid}}" onchange="this.classList.toggle('is-invalid', this.value == '')">
    <option value="">{{# str}} selectaquiz, report_certaintyquizzes {{/ str}}</option>
    {{# quizs}}
        <option value="{{id}}" {{# selected}}selected{{/ selected}}>{{title}}</option>
    {{/ quizs}}
</select>
