{{!
    @template report_certaintyquizzes/groupselector

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * groups Available groups to be selected
        * id Group id
        * name Group name
        * selected Whether this option is currently selected

    Example context (json):
    {
        "groups": [
            {
                "id": 1,
                "name": "Group 1",
                "selected": true
            },
            {
                "id": 2,
                "name": "Group 2"
            }
        ]
    }
}}
<select name="group" class="custom-select">
    <option value="0">{{# str}} allgroups, report_certaintyquizzes {{/ str}}</option>
    {{# groups}}
    <option value="{{id}}" {{# selected}}selected="selected"{{/ selected}}>{{name}}</option>
    {{/ groups}}
</select>
