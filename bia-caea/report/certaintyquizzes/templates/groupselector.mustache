{{!
    @template report_certaintyquizzes/groupselector

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * groups Available groups to be selected
        * id Group id
        * name Group name
        * selected Whether this option is currently selected
    * separategroups Whether user is restricted to see its own groups only
    * onlycurrentgroup Whether user is restricted to see only one group

    Example context (json):
    {
        "groups": [
            {
                "id": 1,
                "name": "Group 1",
                "selected": true
            },
            {
                "id": 2,
                "name": "Group 2"
            }
        ],
        "separategroups": false,
        "onlycurrentgroup": false
    }
}}
<select name="group" class="custom-select" {{# onlycurrentgroup}}disabled="disabled"{{/ onlycurrentgroup}}>
    {{^ onlycurrentgroup}}<option value="0">{{^ separategroups}}{{# str}} allparticipants {{/ str}}{{/ separategroups}}{{# separategroups}}{{# str}} mygroups, group {{/ str}}{{/ separategroups}}</option>{{/ onlycurrentgroup}}
    {{# groups}}
    <option value="{{id}}" {{# selected}}selected="selected"{{/ selected}}>{{name}}</option>
    {{/ groups}}
</select>
