{{!
    @template report_certaintyquizzes/attemptselector

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * attempttypes Available attempt types
        * value Internal string value
        * label Localized label
        * selected Whether this option is currently selected

    Example context (json):
    {
        "attempttypes": [
            {
                "value": "last",
                "label": "Last attempt"
            },
            {
                "value": "first",
                "label": "First attempt",
                "selected": true
            },
            {
                "value": "best",
                "label": "Best attempt"
            }
        ]
    }
}}
<select name="attempttype" class="custom-select">
    {{# attempttypes}}
	    <option value="{{value}}" {{# selected}}selected{{/ selected}}>{{label}}</option>
    {{/ attempttypes}}
</select>
