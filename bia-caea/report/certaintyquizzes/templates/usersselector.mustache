{{!
    @template report_certaintyquizzes/usersselector

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * users Available users to be selected
        * id User id
        * name User name
        * selected Whether this option is currently selected
    * onlycurrentuser Whether only one option (current user) is selectable

    Example context (json):
    {
        "users": [
            {
                "id": 1,
                "name": "User 1",
                "selected": true
            },
            {
                "id": 2,
                "name": "User 2"
            }
        ],
        "onlycurrentuser": false
    }
}}
<select name="userid" class="custom-select" {{# onlycurrentuser}}disabled="disabled"{{/ onlycurrentuser}}>
    {{^ onlycurrentuser}}<option value="-1">{{# str}} allusers, report_certaintyquizzes {{/ str}}</option>{{/ onlycurrentuser}}
    {{# users}}
        <option value="{{id}}" {{# selected}}selected="selected"{{/ selected}}>{{name}}</option>
    {{/ users}}
</select>
