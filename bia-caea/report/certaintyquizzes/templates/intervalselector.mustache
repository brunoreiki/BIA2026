{{!
    @template report_certaintyquizzes/intervalselector

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * intervals Available intervals
        * value Interval value
        * selected Whether this option is currently selected

    Example context (json):
    {
        "intervals": [
            {
                "value": 50
            },
            {
                "value": 25
            },
            {
                "value": 20,
                "selected": true
            },
            {
                "value": 10
            },
            {
                "value": 5
            }
        ]
    }
}}
<label class="mb-0">
    {{# str}} interval, report_certaintyquizzes {{/ str}}
    <select name="interval" class="custom-select">
        {{# intervals}}
            <option value="{{value}}" {{# selected}}selected{{/ selected}}>{{value}}</option>
        {{/ intervals}}
    </select>
</label>
