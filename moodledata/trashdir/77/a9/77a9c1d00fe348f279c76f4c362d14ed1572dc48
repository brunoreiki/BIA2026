  <question type="multichoice">
    <name>
      <text>Une ville est située à l'est d'une chaîne de montagnes proche. L'effet de Fœhn se fera sentir sur la ville par vent:</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[Une ville est située à l'est d'une chaîne de montagnes proche. L'effet de Fœhn se fera sentir sur la ville par vent:]]></text>
    </questiontext>
    <answer fraction="0" format="html">
      <text><![CDATA[du nord]]></text>
      <feedback>
        <text/>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[du sud]]></text>
      <feedback>
        <text/>
