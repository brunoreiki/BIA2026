  <question type="multichoice">
    <name>
      <text>Un facteur de charge égal à 2 correspond à un virage:</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[Un facteur de charge égal à 2 correspond à un virage:]]></text>
    </questiontext>
    <answer fraction="0" format="html">
      <text><![CDATA[stabilisé à 30° d'inclinaison]]></text>
      <feedback>
