  <question type="multichoice">
    <name>
      <text>Dans l'atmosphère standard, la température au niveau de la mer est de:</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[Dans l'atmosphère standard, la température au niveau de la mer est de:]]></text>
