      <text>En virage symétrique en palier, le facteur de charge:</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[En virage symétrique en palier, le facteur de charge:]]></text>
    </questiontext>
    <answer fraction="0" format="html">
