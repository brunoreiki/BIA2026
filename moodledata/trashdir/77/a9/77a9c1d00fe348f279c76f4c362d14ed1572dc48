      <text>Dans un moteur à 4 temps, quel temps est celui qui fournit l'énergie?</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[Dans un moteur à 4 temps, quel temps est celui qui fournit l'énergie?]]></text>
    </questiontext>
    <answer fraction="0" format="html">
      <text><![CDATA[l’admission]]></text>
      <feedback>
        <text/>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[la compression]]></text>
