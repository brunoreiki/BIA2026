&lt;b&gt;Exemple de METAR&lt;/b&gt; : &lt;font color="red"&gt;LFPG 191030Z&lt;/font color="red"&gt; &lt;font color="blue"&gt;21017KT&lt;/font color="blue"&gt; &lt;font color="green"&gt;9999&lt;/font color="green"&gt; &lt;font color="DarkCyan"&gt;-DZRA BKN007&lt;/font color="DarkCyan"&gt; &lt;font color="Brown"&gt;05/04 Q1016&lt;/font color="Brown"&gt;

