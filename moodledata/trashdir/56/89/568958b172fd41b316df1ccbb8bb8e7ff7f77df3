eanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100" format="html"><text><text>20 h 04</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>20 h 44</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>21 h 24</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>19 h 44</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 679</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Au cap magnétique 100 l’ADF indique un gisement de 30° droite. Sur quel radial de la station se trouve l’aéronef:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>260°</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>130°</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>70°</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>310°</text></text><feedback><text>Bonne réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 680</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;À l’issue d’une opération d’entretien  ayant immobilisé l’avion, quelle est la  mention autorisant la remise en service qui doit être apposée sur le carnet de route:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>&lt;font color="blue"&gt;