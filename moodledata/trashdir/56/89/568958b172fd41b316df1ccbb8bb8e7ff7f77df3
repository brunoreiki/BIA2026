ntext format="html"><text>&lt;![CDATA[&lt;p&gt;Si un observateur se place face au vent dans l'hémisphère nord, la dépression et l'anticyclone se situent de la manière suivante:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>La question peut admettre c ou d comme réponse</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>anticyclone sur sa droite, dépression sur sa gauche</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>anticyclone devant lui, dépression derrière lui</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>anticyclone sur sa gauche, dépression sur sa droite</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>anticyclone derrière lui, dépression devant lui</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 159</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;La grêle est un type de précipitation qui se forme dans:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>les stratus</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>les nimbostratus</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>les cumulonimbus</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>les stratocumulus</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 161</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;La brise de pente (montante) se forme en région:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>côtière et de jour</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>côtière et de nuit</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>montagneuse et de nuit</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>montagneuse et de jour</text></text><feedback><text>Bonne réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 162</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Sur cette carte, la circulation du vent dénommé Mistral correspond à la flèche:&lt;/p&gt;&lt;p&gt;&lt;img src='@@PLUGINFILE@@/m4_2017.jpg' alt='Image de la question'&gt;&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Le mistral est un vent qui prend naissance dans la vallée du Rhône, entre l'est du Massif Central et l'ouest des Alpes, parcourt les basses vallées du Rhône et de la Durance du Nord vers le Sud. Le mistral souffle par rafales pouvant dépasser 100 km/h autour d'une vitesse moyenne qui atteint couramment une cinquantaine de km/h dans la journée, tout en se calmant sensiblement chaque nuit.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>1</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>2</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>3</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>4</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 164</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Le principal danger induit par le brouillard sur le vol est:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>&lt;font color="blue"&gt; Le &lt;b&gt; brouillard&lt;/b&gt; est un stratus qui touche le sol. Il masque les reliefs, les obstacles, les pistes d'atterrissage et est donc très dangereux pour l'aviation.&lt;/font color="blue"&gt; Il ne génère ni turbulences, ni risque systématique de givrage (cela va dépendre de la température), ni éclair.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>la formation de givrage possible en toutes saisons</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>la turbulence associée</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>la diminution de la visibilité</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>le risque de foudroiement</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 165</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Parmi les éléments suivants, une conséquence possible du givrage est:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>&lt;font color="blue"&gt;Le givrage en vol détériore la circulation normale de l'air, augmente la traînée et diminue la capacité de la structure à créer de la portance.&lt;/font color="blue"&gt; Une couche de givre ayant la rugosité d’un papier de verre à grain moyen peut réduire la portance de 30 % et augmenter la traînée de 40 %, surtout si elle se trouve près du bord d’attaque d’une surface portante. 
Le givre s'accumule sur toutes les surfaces exposées de l'avion : les ailes, les hélices, le pare-brise mais aussi sur les antennes, les prises d'air et le capot. Il peut faire vibrer les antennes si fortement qu'elles se brisent. Dans des conditions modérées à fortes, un aéronef léger peut devenir si givré qu'il est impossible de poursuivre le vol. L'avion peut décrocher à des vitesses beaucoup plus élevées et à des angles d'attaque inférieurs à la normale. Il peut rouler ou se cabrer de façon incontrôlable et la récupération peut s'avérer impossible.
Le givre peut également causer l'arrêt du moteur en givrant le carburateur ou, dans le cas d'un moteur à injection de carburant, en bloquant les entrées d'air du moteur.
&lt;b&gt;&lt;font color="blue"&gt;Le givre concerne 30% des accidents en aviation commerciale.&lt;/font color="blue"&gt;&lt;/b&gt;</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>gain d'altitude</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>altération des profils aérodynamiques</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>amélioration des performances de l'aéronef</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>diminution de la traînée</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 166</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Un brouillard d'advection est dû:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>au mélange de deux masses d'air de températures différentes et non saturées</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>à une masse d'air calme humide qui remonte la pente d'un terrain et se refroidit adiabatiquement</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>au refroidissement d'une masse d'air en mouvement passant sur une surface de sol plus froid</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>à un phénomène local en situation anticyclonique qui se produit par ciel clair généralement de nuit</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 167</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;La convection est un échange thermique qui s'effectue par:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>La convection est un transfert de chaleur par déplacement vertical de la matière dû à des différences de température. La convection se produit lorsque de l'air chaud et moins dense près du sol s'élève et est remplacé par de l'air plus froid et plus dense.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>conduction thermique adiabatique</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>une circulation de courants d'air verticaux</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>le rayonnement infrarouge du sol</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>une diminution de l'humidité de l'air</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 170</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Les conditions atmosphériques les plus favorables à l'apparition du givrage du carburateur sont:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>À la sortie du venturi, juste en avant du papillon des gaz, se produit un brutal refroidissement de l’air, dû à la combinaison de la détente de l’air, et de la chute de température consécutive à la vaporisation du carburant. L’abaissement de la température peut atteindre moins 30°C, et l'eau contenue dans le mélange air-carburant peut rapidement se transformer en givre et/ou en glace, et se déposer en périphérie du venturi et sur le papillon des gaz. Ce phénomène en obturant le venturi entraîne une perte de puissance et même l'arrêt du moteur.
&lt;font color="blue"&gt;Le givrage carburateur peut se produire dès une température de 30°C avec une humidité relative de seulement 50 %. Les conditions idéales de givrage sont une température extérieure comprise entre +5°C et 21°C et une humidité relative de 80 % ou plus. La possibilité de givrage diminue à partir de 0°C.&lt;/font color="blue"&gt;
&lt;b&gt;Source : l'Avionnaire.&lt;/b&gt;</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100" format="html"><text><text>forte humidité, température basse</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>faible humidité, température élevée</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>faible humidité, température basse</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>forte humidité, température élevée</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 171</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Sur le profil de l'aile, la vitesse de l'écoulement de l'air:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Sur l’extrados, l'écoulement de l'air est accéléré par la forme du profil, donc la pression diminue, créant une force qui tire l'aile vers le haut.
A l'inverse, sur l’intrados, il y a une surpression, qui pousse l’aile vers le haut.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>est constante sur l'intrados et l'extrados</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>diminue sur l'intrados et augmente sur l'extrados</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>diminue sur l'extrados et augmente sur l'intrados</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>diminue sur l'intrados et l'extrados</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 172</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;En vol normal, sur ce profil, l'écoulement entre le point A et le point T est:&lt;/p&gt;&lt;p&gt;&lt;img src='@@PLUGINFILE@@/a1_2017.gif' alt='Image de la question'&gt;&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>tourbillonnaire</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>turbulent</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>de vitesse constante</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>laminaire</text></text><feedback><text>Bonne réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 173</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;La force parallèle, de même sens que le vent relatif Vr est:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>la portance</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>la traînée</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>le poids</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>la résultante aérodynamique</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 174</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Si en vol la température extérieure augmente fortement, la portance:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>augmente fortement</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>reste constante</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>augmente faiblement</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>diminue</text></text><feedback><text>Bonne réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 175</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Les paramètres intervenant dans la formule de la portance sont:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>&lt;font color="red"&gt;Rz = ½.ρ.V².S.Cz&lt;/font color="red"&gt;
&lt;font color="blue"&gt;Rz est la portance (en Newton).
ρ masse volumique de l’air (en kg/m3) .
V vitesse de l’avion dans l’air (vitesse vraie en m/s).
S surface de l’aile (en m²).
Cz est le coefficient de portance de l’aile (sans unité).&lt;/font color="blue"&gt;

Ni le poids de l’avion, ni celui des ailes, ni le coefficient de traînée n’apparaissent dans la formule de la portance. En revanche, on y trouve la vitesse et la surface  de l'aile.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100" format="html"><text><text>la vitesse et la surface alaire de l'aile</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>la masse volumique et le poids de l'avion</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>le coefficient de portance et le poids des ailes</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>la vitesse et le coefficient de traînée</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 176</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Avec la polaire suivante, le Cz max est obtenu à:&lt;/p&gt;&lt;p&gt;&lt;img src='@@PLUGINFILE@@/a2_2017.jpg' alt='Image de la question'&gt;&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Le &lt;font color="blue"&gt;coefficient de portance (Cz)&lt;/font color="blue"&gt; est une mesure de la capacité de l'aéronef à générer une force de portance, qui lui permet de rester en l'air. Elle est obtenue en mesurant la portance et la traînée pour différentes valeurs d’incidence de l’aile.
&lt;font color="blue"&gt;Le coefficient de traînée (Cx)&lt;/font color="blue"&gt; est une mesure de la résistance de l'aéronef à l'écoulement de l'air qui freine son mouvement.
&lt;font color="blue"&gt;Une polaire&lt;/font color="blue"&gt; est un graphique indiquant pour chaque valeur de la traînée, la portance qui lui correspond.
Sur le graphique :
- &lt;font color="blue"&gt;L’angle d’incidence correspondant à la portance maximale est de 17°.&lt;/font color="blue"&gt;
- L’angle d’incidence de 4° est celui où le rapport Cz/Cx est à son maximum.
&lt;b&gt;Marin Descarrega&lt;/b&gt;</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>-1,3° d'incidence</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>4° de température</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>17° de température</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>17° d'incidence</text></text><feedback><text>Bonne réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 177</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Sur la figure suivante, l'angle Y représente:&lt;/p&gt;&lt;p&gt;&lt;img src='@@PLUGINFILE@@/a3_2017.jpg' alt='Image de la question'&gt;&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100" format="html"><text><text>l'angle de dièdre</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>l'angle de flèche</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>l'angle d'incidence</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>l'angle de calage</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 178</text></name><questiontext form