l"><text>&lt;![CDATA[&lt;p&gt;Le foyer d'un profil est:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>confondu avec le centre de poussée</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>situé au bord d'attaque</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>situé à 25% environ de la corde à partir du bord d'attaque</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>situé à 25% environ de la corde à partir du bord de fuite</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2510</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;A propos des volets hypersustentateurs de bord de fuite, quelle est la proposition fausse:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>&lt;font color="blue"&gt;Le braquage des volets hypersustentateurs de bord de fuite&lt;/font color="blue"&gt; sur les ailes d'un avion &lt;font color="blue"&gt;augmente le coefficient de portance (Cz)&lt;/font color="blue"&gt;, ce qui permet à l'avion de voler à des vitesses plus basses et à des incidences plus fortes sans risque de décrochage, comme lors du décollage et de l'atterrissage. Cependant, cette augmentation de la portance s'accompagne également d'une &lt;font color="blue"&gt;augmentation du coefficient de traînée (Cx)&lt;/font color="blue"&gt;, ce qui signifie que l'avion subit plus de résistance à son avancement dans l'air. &lt;font color="blue"&gt;Sa finesse diminue&lt;/font color="blue"&gt;, car le coefficient de traînée (Cx) augmente plus que le coefficient de portance (Cz). En descente, &lt;font color="blue"&gt;il lui devient possible de prendre une pente plus forte&lt;/font color="blue"&gt;. Enfin, la sortie des volets modifie le profil de l'aile et crée &lt;font color="blue"&gt;un couple piqueur&lt;/font color="blue"&gt;.
&lt;b&gt;Marin D.&lt;/b&gt;</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>leur braquage augmente le coefficient Cz de portance</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>leur braquage augmente le coefficient Cx de traînée</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>leur braquage crée un couple piqueur</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>ils autorisent une pente de descente plus faible</text></text><feedback><text>Bonne réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2511</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Les facteurs suivants, sauf un, améliorent les performances aérodynamiques d'un planeur. Lequel:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100" format="html"><text><text>une faible surface alaire</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>un grand allongement</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>une aile propre sans poussière ni insectes collés</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>un train rentrant (escamotable)</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2512</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Un planeur vole en air calme à 144 km/h, son variomètre indique 1,25 m/s. Quelle est sa finesse&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>La finesse d'un aéronef peut s'exprimer par les rapports:
&lt;font color="blue"&gt;- vitesse horizontale / vitesse verticale
- portance/traînée
- distance horizontale parcourue / hauteur perdue&lt;/font color="blue"&gt;

Utilisons la formule avec les vitesses :
&lt;font color="blue"&gt;finesse = vitesse horizontale / vitesse verticale&lt;/font color="blue"&gt;
convertissons la vitesse verticale en km/h : 1,25 x 3,6 = 4,5 km/h
Donc :
&lt;font color="red"&gt;finesse = 144 / 4,5 = 32&lt;/font color="red"&gt;</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>15</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>32</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>50</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>58</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2513</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Le décrochage d'une aile se produit:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>&lt;h4 align="center"&gt;Relation entre décrochage, incidence et vitesse&lt;/h4&gt;On a souvent tendance à associer le décrochage à une vitesse limite inférieure à ne pas dépasser alors que celui-ci est dû à une &lt;b&gt;valeur maximale de l’angle d’incidence&lt;/b&gt; empêchant les filets d’air de contourner  le profil pour générer la portance.

Lorsque l’on augmente progressivement la valeur de l’angle d’incidence (voir illustration ci-dessous) on constate :
 - l’augmentation de l’épaisseur de la couche limite turbulente (zone blanchâtre en &amp;#9312 et &amp;#9313).
- puis à 20° l’intégralité de l’écoulement turbulent au-dessus de l’extrados est responsable d’une chute brutale de portance et le décrochage survient (en &amp;#9314).

&lt;U&gt;Remarques:&lt;/U&gt;
- Le décrochage est annoncé par des signes précurseurs: bruit, vibrations, inefficacité des commandes…
- Sur une aile ayant une vitesse suffisante une augmentation brutale de l’incidence peut créer un décrochage dit «dynamique», lors d’une forte ressource par exemple.
- Sur un aérodyne, dans une configuration et avec une charge donnée, à chaque incidence correspond une vitesse de vol. En particulier lors du décrochage mais si l’on change la masse de l’avion cette vitesse de décrochage va changer… Il y a donc un angle d’incidence de valeur déterminé correspondant au décrochage mais la vitesse de décrochage correspondante est variable.
&lt;font color="blue"&gt;
Le décrochage se produit donc pour une valeur précise maximale de l’angle d’incidence et non pour une certaine vitesse&lt;/font&gt;

&lt;b&gt;Bruno Capelle&lt;/b&gt;</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>sans signe avertisseur</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>quand l'angle d'incidence diminue</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>toujours à faible vitesse</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>quand l'angle d'incidence devient très important</text></text><feedback><text>Bonne réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2514</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Sur la polaire d'aile dessinée ci-contre, on appelle point de portance maximale:&lt;/p&gt;&lt;p&gt;&lt;img src='@@PLUGINFILE@@/aerody-1_2010.jpg' alt='Image de la question'&gt;&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Le &lt;font color="blue"&gt;coefficient de portance (Cz)&lt;/font color="blue"&gt; est une mesure de la capacité de l'aéronef à générer une force de portance, qui lui permet de rester en l'air.
&lt;font color="blue"&gt;Le coefficient de traînée (Cx)&lt;/font color="blue"&gt; est une mesure de la résistance de l'aéronef à l'écoulement de l'air qui freine son mouvement.
&lt;font color="blue"&gt;Une polaire&lt;/font color="blue"&gt; est un graphique indiquant pour chaque valeur de la traînée, la portance qui lui correspond.
Sur le graphique :
- &lt;font color="blue"&gt;Le point correspondant à la portance maximum est le point "D".&lt;/font color="blue"&gt;
- Le point "C" est celui où le rapport Cz/Cx est à son maximum.
- Le point "A" est le point de traînée minimum.
&lt;b&gt;Marin Descarrega&lt;/b&gt;</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>le point A</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>le point B</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>le point C</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>le point D</text></text><feedback><text>Bonne réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2515</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Un avion vole à 180 km/h. La surface alaire est de 15 m&lt;SUP&gt;2&lt;/SUP&gt; tandis que le Cz est de 1,2. Sachant que la masse volumique de l'air est de 1,2 kg/m&lt;SUP&gt;3&lt;/SUP&gt; la portance est de:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>&lt;font color="red"&gt;Rz = ½.ρ.V².S.Cz&lt;/font color="red"&gt;
&lt;font color="blue"&gt;Rz est la portance (en Newton).
ρ masse volumique de l’air (en kg/m3) .
V vitesse de l’avion dans l’air (vitesse vraie en m/s).
S surface de l’aile (en m²).
Cz est le coefficient de portance de l’aile (sans unité).&lt;/font color="blue"&gt;
180km/h = 180 / 3,6 = 50 m/s
Donc :
&lt;font color="red"&gt;Rz = ½.1,2.50².15.1,2 = 27000 N&lt;/font color="red"&gt;</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>12 000 N</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>18 000 N</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>24 000 N</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>27 000 N</text></text><feedback><text>Bonne réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2516</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Le roulis induit apparaît lorsqu'on:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>actionne les ailerons</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>actionne la gouverne de profondeur</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>actionne la gouverne de direction</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>sort les volets</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2517</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Sur un planeur, les aérofreins permettent:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Les aérofreins sont des dispositifs utilisés sur certains avions pour augmenter la traînée (Cx) et parfois aussi, selon les dispositifs, de réduire la portance (Cz). En s'étendant hors de l'aile ou du fuselage, ils perturbent le flux d'air autour de l'avion, augmentant ainsi la résistance (traînée) et diminuant l'efficacité aérodynamique de l'aile, ce qui réduit la portance. L'objectif principal des aérofreins est de ralentir l'avion, notamment lors de la descente ou avant l'atterrissage. 
&lt;b&gt;Marin D.&lt;/b&gt;</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>de diminuer la pente d'approche</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>de diminuer la vitesse de décrochage</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>de diminuer la vitesse d'approche</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>d'augmenter le taux de roulis</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2518</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Une aile rectangulaire a une surface de 36,75 m² pour une envergure de 21 m. Quel est son allongement:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>&lt;font color="blue"&gt;allongement = envergure² / surface alaire&lt;/font color="blue"&gt;
Ici &lt;b&gt;allongement&lt;/b&gt; = &lt;font color="red"&gt;21² / 36,75 = 441 / 36,75 = &lt;b&gt;12&lt;/b&gt;&lt;/font color="red"&gt;

&lt;b&gt;Remarque n°1 :&lt;/b&gt;
&lt;font color="blue"&gt;Allongement = envergure² / surface alaire&lt;/font color="blue"&gt;
Pour une aile rectangulaire on a : &lt;font color="blue"&gt;l'allongement = envergure / corde&lt;/font color="blue"&gt;
En effet, si l'aile est rectangulaire sa &lt;font color="blue"&gt;surface alaire = envergure x corde&lt;/font color="blue"&gt;
donc : &lt;font color="blue"&gt;Allongement&lt;/font color="blue"&gt; = envergure² / surface alaire = envergure² / envergure x corde = &lt;font color="blue"&gt;envergure / corde&lt;/font color="blue"&gt;

&lt;b&gt;Remarque n°2 :&lt;/b&gt;
La formule de l'allongement nous dit que l'allongement est le rapport entre la surface qu'aurait une aile carrée de l'envergure de l'appareil et sa surface alaire.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>17,5</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>12</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>10</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>1,75</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2519</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;L'assiette longitudinale d'un avion se défini comme étant l'angle compris entre:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>&lt;h4 align="center"&gt;Angle d’incidence&lt;/h4&gt;&lt;U&gt;Voir illustration n° 1.&lt;/U&gt;
Les valeurs des coefficients de portance &lt;b&gt;Cz&lt;/b&gt; et de trainée &lt;b&gt;Cx&lt;/b&gt; et donc les performances aérodynamiques d’une aile donnée &lt;font color="red"&gt;dépendent uniquement de la valeur de l’angle d’incidence&lt;/font&gt; qui est l’&lt;font color="blue"&gt;angle entre&lt;/font&gt; la direction de l’écoulement et l’aile, plus précisément entre &lt;font color="blue"&gt;la direction du vent relatif et de la corde du profil de l’aile&lt;/font&gt;. Comme la direction du vent relatif est aussi celle de la trajectoire, &lt;font color="blue"&gt;l’angle d’incidence est aussi celui entre la trajectoire et la corde du profil.&lt;/font&gt;

&lt;h4 align="center"&gt;Angle d’incidence et Assiette&lt;/h4&gt;&lt;U&gt;Voir illustration n° 2.
&lt;/U&gt;&lt;font color="blue"&gt; L’assiette d’un avion&lt;/font&gt; (on pourrait étendre à une aile) a une référence horizontale: c’&lt;font color="blue"&gt;est l’angle entre l’axe longitudinal de l’avion et l’horizontale.&lt;/font&gt;
&lt;U&gt;Illustration 2-1 :&lt;/U&gt; l’axe de l’avion est horizontal , son assiette est nulle . l’angle d’incidence est ici de 10° (remarque ici l’angle de calage de l’aile par rapport au fuselage est aussi de 10° c’est un réglage du constructeur).
&lt;U&gt;Illustration 2-2 :&lt;/U&gt; l’axe de l’avion est cabré, son assiette est à cabrer de 10° Ici l’angle d’incidence est toujours de 10° mais pourrait être différent.
&lt;U&gt;Illustration 2-3 :&lt;/U&gt; L’axe de l’avion est piqué, son assiette est à piquer de -10° mais ici encore l’angle d’incidence est de 10°.

&lt;b&gt;Bruno Capelle&lt;/b&gt;
</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100" format="html"><text><text>l'axe longitudinal de l'avion et l'horizontale</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>la direction du vent relatif et la corde de profil</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>l'angle entre la corde de profil et l'horizontale</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>le bord d'attaque de l'aile et l'axe de l'avion</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2520</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;La longueur de roulage nécessaire au décollage augmente avec:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>La distance de décollage d'un avion dépend de plusieurs facteurs. La portance Fz est proportionnelle à &lt;font color="blue"&gt;ρ&lt;/font&gt; &lt;b&gt;la densité de l'air&lt;/b&gt; (&lt;font color="red"&gt;Fz = 1/2 &lt;font color="blue"&gt;ρ&lt;/font&gt;.V².S.Cz&lt;/font&gt;) qui dépend de la &lt;b&gt;La température&lt;/b&gt; et de &lt;b&gt;l'altitude&lt;/b&gt;. D'une part, l'air froid étant plus dense que l'air chaud (masse volumique &lt;font color="blue"&gt;ρ&lt;/font&gt; plus importante) la force de portance est donc plus importante. D'autre part,&lt;b&gt; L'altitude de l'aéroport&lt;/b&gt; est également importante car à une altitude plus élevée, l'air est moins dense, ce qui affecte la portance et la performance des moteurs. En effet, pour un moteur à explosion, lorsque l'air est moins dense, il y a moins de molécules d'air aspirées par le moteur qui équilibre en injectant moins d'essence dans les chambres de combustion. Il y a alors moins d'air et d'essence ce qui engendre moins de puissance. Enfin, &lt;b&gt;la composante de vent arrière&lt;/b&gt; est très importante car pour générer de la portance l'avion doit atteindre sa vitesse de décollage par rapport au vent relatif pas par rapport à la vitesse sol. Un vent arrière de 10kt peut augmenter de 50 % la distance de décollage.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>l'altitude</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>la température</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>la composante de vent arrière</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>dans les trois cas précédents</text></text><feedback><text>Bonne réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2521</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;En vol rectiligne horizontal stabilisé:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="100" format="html"><text><text>la traction équilibre la traînée</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>la traction équilibre la portance</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>la portance est supérieure au poids</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>la portance équilibre la traînée</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2522</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Un facteur de charge égal à 2 correspond à un virage:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>&lt;h4 align="center"&gt;Poids apparent et facteur de charge.&lt;/h4&gt;&lt;U&gt;Nota:&lt;/U&gt; les grandeurs en &lt;b&gt;gras&lt;/b&gt; dans le texte sont des grandeurs vectorielles (avec une flèche sur les schémas).

En virage, dans une voiture ou un manège, on se sent plus lourd, voire écrasé vers l’extérieur telle l’eau éjectée de l’essoreuse à salade… comme ce motocycliste collée sur la paroi verticale du tonneau infernal… comment peut il tenir en équilibre ?

Pour lui, à l’attraction de la terre, son &lt;b&gt;poids&lt;/b&gt; s’ajoute ce qui ressemble à une force (qui n’en est pas vraiment une car non créée par quelque chose qui agirait sur nous) et que l’on nomme force d’inertie centrifuge &lt;b&gt;Fi&lt;/b&gt;.  L’ensemble de &lt;b&gt;P&lt;/b&gt; et de &lt;b&gt;Fi&lt;/b&gt; constitue le poids apparent &lt;b&gt;Pa&lt;/b&gt; (de valeur supérieure à P en virage). Si il ne «tombe» pas, c’est que pour lui la somme des forces : &lt;b&gt;action du sol&lt;/b&gt; + &lt;b&gt;poids&lt;/b&gt; + &lt;b&gt;Force d’inertie&lt;/b&gt; = 0 ou &lt;b&gt;poids apparent&lt;/b&gt; + &lt;b&gt;Action du sol&lt;/b&gt; = 0

Le même phénomène s’observe à l’accélération et au freinage d’un véhicule par exemple.
&lt;font color="blue"&gt;
D’une façon  générale on appelle facteur de charge le nombre de fois que le poids apparent Pa est supérieur à P
&lt;font color="red"&gt;n = Pa / P&lt;/font&gt;
n est sans unité.
&lt;/font color="blue"&gt;
Par exemple si n = 2, le poids apparent (ressenti) est le double du poids «normal». On dit alors que l’on «prend» 2g c-a-d que tout se passe comme si la gravité, l’attraction terrestre g était multipliée par 2.
Pour une personne de masse 50 kg, avec g  = 10 N / kg son poids P = m × g = 500 N et Pa = 1000 N.

Dans le cas de l’avion en virage horizontal stabilisé avec une  inclinaison d’un angle α, 
on vérifie ici que le &lt;b&gt;poids apparent&lt;/b&gt;, somme de &lt;b&gt;P&lt;/b&gt; et de la &lt;b&gt;force d’inertie centrifuge Fi&lt;/b&gt; est égal à la &lt;b&gt;portance&lt;/b&gt; &lt;b&gt;R’z&lt;/b&gt;.
&lt;font color="red"&gt;
n = (poids apparent) / P = portance / P = R'z / P = 1 / cosα
&lt;/font color="red"&gt;
Il en résulte que plus l’avion est incliné, plus la portance doit être élevée. Le facteur de charge ne dépend que de l’inclinaison et augmente avec elle.
&lt;U&gt;Par exemple :&lt;/U&gt;
- pour une inclinaison de 30° n = 1 / cos30° = 1,15
- pour 45°  n = 1,4
- et pour 60°  n = 1 / cos60° = 2

Pour un avion de masse 1000kg,  son poids P = m*g = 10000N (en prenant g=10N/kg)
- en vol rectiligne horizontal: n = 1 donc portance = n * P = P = 10000 N
- en virage incliné à 60°: n=2 donc portance R’z = 2 * P = 20000 N

&lt;U&gt;Remarque :&lt;/U&gt; la portance étant multipliée par n, les efforts sur la structure le sont aussi et un risque de rupture est possible si n est trop important. 
Pour leur sécurité, les aérodynes ont des facteurs de charge limite, à ne pas dépasser, de l’ordre de 4-5(g) minimum.

&lt;b&gt;Bruno Capelle&lt;/b&gt;</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>stabilisé à 30° d'inclinaison</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>stabilisé à 45° d'inclinaison</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>stabilisé à 60° d'inclinaison</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>effectué à 2 fois la vitesse de décrochage</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2523</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;Un avion léger "centré arrière" sera:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>&lt;font color="blue"&gt;&lt;b&gt;Le centrage&lt;/b&gt; est la position du centre de gravité sur l’axe longitudinal de l’avion.&lt;/font color="blue"&gt; Pour qu’un avion vole en sécurité, son centre de gravité ne doit être ni trop vers l’avant ni trop vers l’arrière. Dans tous les cas il doit être plus vers l’avant que ne l'est &lt;b&gt;le foyer avion&lt;/b&gt;&lt;font color="red"&gt;*&lt;/font color="red"&gt;.
- &lt;b&gt;Plus le centrage est positionné vers l’avant&lt;/b&gt; plus l’appareil est stable donc, moins maniable, nécessitant un braquage plus important des gouvernes pour le manœuvrer. Sa traînée, sa consommation de carburant et sa vitesse de décrochage augmentent. Au-delà d’un certain point, appelé limite de centrage avant, les gouvernes de profondeurs ne sont plus capable de produire la rotation au décollage ou l'arrondi à l’atterrissage.
- &lt;b&gt;Plus le centrage est positionné en arrière&lt;/b&gt;, plus l’avion est maniable, réactif et instable. Sa traînée, la consommation de carburant et sa vitesse de décrochage diminuent. Au-delà d’un certain point, appelé limite de centrage arrière, l’avion devient impilotable.

&lt;font color="red"&gt;*&lt;/font color="red"&gt; &lt;b&gt;le foyer avion&lt;/b&gt; : c’est un point fixe et théorique de l’avion déterminé par le constructeur après calculs et / ou mesures en soufflerie. Pour analyser la stabilité de l’avion, c’est le point sur lequel on définit que s’applique non pas la portance (que l’on considère être à la verticale du centre de gravité) mais les variations de la portance. Cela permet de déterminer la stabilité de l’avion en ne considérant que la position relative de deux points : celui du foyer et celui du centre de gravité.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>plus stable qu'un avion "centré avant"</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="100" format="html"><text><text>plus maniable qu'un avion "centré avant"</text></text><feedback><text>Bonne réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>moins sensible à la turbulence qu'un avion "centré avant"</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer><answer fraction="0" format="html"><text><text>obligatoirement incontrôlable</text></text><feedback><text>Mauvaise réponse.</text></feedback></answer></question><question type="multichoice"><name><text>Question 2504</text></name><questiontext format="html"><text>&lt;![CDATA[&lt;p&gt;La résistance de l'air sur un corps:&lt;/p&gt;]]&gt;</text></questiontext><generalfeedback><text>Pas de feedback disponible.</text></generalfeedback><defaultgrade>1.0000000</defaultgrade><penalty>0.3333333</penalty><hidden>0</hidden><single>true</single><shuffleanswers>true</shuffleanswers><answernumbering>abc</answernumbering><answer fraction="0" format="html"><text><text>s'exprime en kilogrammes</text></text><feedback><text>Mauvaise répon