<question type="multichoice">
<name>
<text>Un facteur de charge égal à 2 correspond à un virage:</text>
</name>
<questiontext format="html">
<text>Un facteur de charge égal à 2 correspond à un virage:</text>
</questiontext>
<answer format="html" fraction="0">
<text>stabilisé à 30° d'inclinaison</text>
<feedback>
