a:7:{s:12:"alphachannel";s:11:"Canal Alpha";s:17:"alphachannel_help";s:156:"Cette valeur détermine le degré de transparence de l'image. Vous pouvez définir le canal alpha entre 0 (totalement transparent) et 1 (totalement opaque).";s:11:"courseimage";s:21:"Image de cours : {$a}";s:5:"image";s:5:"Image";s:10:"pluginname";s:5:"Image";s:16:"privacy:metadata";s:58:"Le plugin Image n’enregistre aucune donnée personnelle.";s:11:"systemimage";s:20:"Image de site : {$a}";}