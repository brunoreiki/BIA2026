a:190:{s:3:"ago";s:11:"Il y a {$a}";s:18:"allowanonymouspost";s:44:"Permettre de poster une question anonymement";s:24:"allowanonymouspost_descr";s:112:"If enabled, questions can be posted anonomously, and if approved for viewing heat votes can be made by everyone.";s:23:"allowanonymouspost_help";s:112:"If enabled, questions can be posted anonomously, and if approved for viewing heat votes can be made by everyone.";s:19:"allowauthorinfohide";s:31:"Allow authors name to be hidden";s:25:"allowauthorinfohide_descr";s:97:"If enabled, the name of the questions author can be visible to teachers but hidden from students.";s:24:"allowauthorinfohide_help";s:97:"If enabled, the name of the questions author can be visible to teachers but hidden from students.";s:13:"allowcomments";s:25:"Allow comments on entries";s:18:"allowcomments_help";s:117:"If enabled, all participants with permission to create comments will be able to add comments to hot question entries.";s:21:"alwaysshowdescription";s:31:"Toujours montrer la description";s:26:"alwaysshowdescription_help";s:89:"Si désactivé, la description de la question Hot ne sera pas visible pour les étudiants";s:9:"anonymous";s:7:"Anonyme";s:13:"approvallabel";s:30:"Approval required column label";s:19:"approvallabel_descr";s:46:"Enter a default label for the Approved column.";s:10:"approvedno";s:12:"Not approved";s:11:"approvedyes";s:8:"Approved";s:10:"authorinfo";s:35:"Posté par {$a->user} à {$a->time}";s:14:"authorinfohide";s:17:"Posted {$a->time}";s:11:"calendarend";s:11:"{$a} closes";s:13:"calendarstart";s:10:"{$a} opens";s:16:"cnfallowcomments";s:67:"Define if a hot question will accept comments on entries by default";s:21:"completiondetail:pass";s:19:"Passing grade: {$a}";s:21:"completiondetail:post";s:20:"Post questions: {$a}";s:21:"completiondetail:vote";s:15:"Give heat: {$a}";s:14:"completionpass";s:18:"Student must pass:";s:18:"completionpassdesc";s:42:"Student must receive passing grade of {$a}";s:19:"completionpassgroup