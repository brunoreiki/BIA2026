a:4:{s:10:"pluginname";s:24:"Champ de l’utilisateur";s:16:"privacy:metadata";s:70:"Le plugin Champ utilisateur n’enregistre aucune donnée personnelle.";s:9:"userfield";s:24:"Champ de l’utilisateur";s:14:"userfield_help";s:98:"Cet élément permet de choisir l’un des champs de l’utilisateur qui s’affichera sur le PDF.";}