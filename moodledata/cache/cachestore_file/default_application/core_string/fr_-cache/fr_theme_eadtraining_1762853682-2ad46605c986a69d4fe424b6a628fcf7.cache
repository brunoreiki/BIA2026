a:169:{s:13:"access_course";s:17:"Access the course";s:17:"access_course_buy";s:14:"Course details";s:29:"acctoolbar_access_declaration";s:23:"Accessibility statement";s:21:"acctoolbar_btn_bright";s:15:"Bright contrast";s:27:"acctoolbar_btn_cursor_black";s:16:"Big black cursor";s:27:"acctoolbar_btn_cursor_white";s:16:"Big white cursor";s:24:"acctoolbar_btn_font_down";s:13:"Decrease text";s:28:"acctoolbar_btn_font_readable";s:13:"Readable text";s:22:"acctoolbar_btn_font_up";s:13:"Increase text";s:28:"acctoolbar_btn_images_titles";s:13:"Images titles";s:21:"acctoolbar_btn_invert";s:16:"Reverse contrast";s:25:"acctoolbar_btn_monochrome";s:17:"Uncolored display";s:19:"acctoolbar_btn_open";s:18:"Accessibility menu";s:32:"acctoolbar_btn_underline_headers";s:17:"Underline headers";s:30:"acctoolbar_btn_underline_links";s:15:"Underline links";s:22:"acctoolbar_btn_zoom_in";s:11:"Zoom screen";s:31:"acctoolbar_content_block_header";s:20:"Highlighting content";s:32:"acctoolbar_contrast_block_header";s:14:"Color contrast";s:25:"acctoolbar_debug_contacts";s:31:"Report an accessibility problem";s:30:"acctoolbar_disable_animattions";s:16:"Block animations";s:19:"acctoolbar_dyslexic";s:21:"Dyslexia Legible Font";s:28:"acctoolbar_image_without_alt";s:18:"Image without text";s:24:"acctoolbar_keyboard_root";s:19:"keyboard navigation";s:29:"acctoolbar_reset_all_settings";s:14:"Reset settings";s:28:"acctoolbar_text_block_header";s:9:"Text size";s:18:"acctoolbar_toolbar";s:21:"Accessibility toolbar";s:28:"acctoolbar_zoom_block_header";s:7:"Zoom in";s:9:"add_block";s:15:"+ Add new block";s:16:"advancedsettings";s:17:"Advanced settings";s:24:"background_profile_image";s:31:"Default course background image";s:29:"background_profile_image_desc";s:178:"Sets a default background image for the header of all courses. This image will be displayed at the top of the course page and can be individually replaced in the course settings.";s:15:"backgroundimage";s:16:"Background image";s:20:"backgroundimage_desc";s:149:"The image to display as a background of the site. The background image you upload here will override the background image in your theme preset files.";s:10:"brandcolor";s:26:"Cor primária da interface";s:26:"brandcolor_background_menu";s:36:"Apply brand color to menu background";s:31:"brandcolor_background_menu_desc";s:221:"This setting defines whether the color set in "Brand color" will be applied to the menu items or to the menu background.<br>If applied to the background, the menu text will be displayed in white to ensure proper contrast.";s:15:"brandcolor_desc";s:88:"Set the highlight color using the selection above or by choosing from the palette below.";s:21:"cachedef_course_cache";s:17:"Course data cache";s:28:"cachedef_course_module_cache";s:20:"Course modules cache";s:18:"cachedef_css_cache";s:21:"CSS stylesheets cache";s:24:"cachedef_frontpage_cache";s:15:"Frontpage cache";s:12:"choosereadme";s:164:"Ead Training is a modern highly-customisable theme. This theme is intended to be used directly, or as a parent theme when creating new themes utilising Bootstrap 4.";s:11:"configtitle";s:12:"Ead Training";s:14:"course_summary";s:37:"Show course summary before the Course";s:21:"course_summary_banner";s:37:"Show course summary before the Course";s:29:"course_summary_banner_default";s:41:"Choose the default banner for all courses";s:34:"course_summary_banner_default_desc";s:86:"Within each course, you can set a different banner that will replace this default one.";s:26:"course_summary_banner_desc";s:99:"If enabled, the course summary will be displayed before the main course content on the course page.";s:26:"course_summary_banner_down";s:31:"Banner stays below the top menu";s:26:"course_summary_banner_edit";s:36:"Edit the banner image of this course";s:26:"course_summary_banner_none";s:9:"No header";s:27:"course_summary_banner_under";s:38:"Banner starts right after the top menu";s:28:"course_summary_banner_simple";s:30:"Simple header with information";s:27:"course_summary_banner_title";s:18:"Header with banner";s:19:"course_summary_desc";s:120:"Si ce réglage est activé, le résumé du cours sera affiché avant le contenu principal du cours sur la page du cours.";s:14:"coursesettings";s:5:"Cours";s:20:"delete_block_confirm";s:41:"Voulez-vous vraiment supprimer le bloc ?";s:20:"delete_block_success";s:27:"Bloc supprimé avec succès";s:18:"delete_block_title";s:17:"Supprimer le bloc";s:19:"details-completaram";s:14:"Cours terminé";s:19:"details-emprogresso";s:8:"En cours";s:18:"details-not-access";s:15:"Jamais accédé";s:16:"details-teachers";s:11:"Enseignants";s:13:"details-users";s:8:"Students";s:10:"edit_block";s:10:"Edit block";s:28:"editor_model_banner_no_video";s:17:"Banner - No video";s:25:"editor_model_banner_video";s:19:"Banner - With video";s:31:"editor_model_course_description";s:18:"Course Description";s:28:"editor_model_differentials_3";s:29:"Our Differentials - 3 Columns";s:28:"editor_model_differentials_4";s:29:"Our Differentials - 4 Columns";s:28:"editor_model_differentials_6";s:29:"Our Differentials - 6 Columns";s:28:"editor_model_differentials_8";s:29:"Our Differentials - 8 Columns";s:16:"editor_model_faq";s:3:"FAQ";s:21:"editor_model_faq_text";s:15:"FAQ Description";s:22:"editor_model_faq_title";s:9:"FAQ Title";s:23:"editor_model_features_3";s:20:"Features - 3 columns";s:23:"editor_model_features_4";s:20:"Features - 4 columns";s:23:"editor_model_features_6";s:20:"Features - 6 columns";s:23:"editor_model_features_8";s:20:"Features - 8 columns";s:22:"editor_model_form_info";s:153:"The blocks generated above will replace the <code>[[change-to-blocks]]</code> placeholder in the editor below. Therefore, do not edit or remove this key.";s:23:"editor_model_form_label";s:274:"This is a multiple-type module, where blocks are created dynamically and added to the item below. Add as many blocks as needed, and in each one, select the desired course. When displayed, the Theme will organize the courses according to the order of the blocks defined here.";s:24:"editor_model_form_label2";s:168:"Add as many blocks as needed, and in each one, select the desired course. When displayed, the Theme will organize the courses according to the block order defined here.";s:23:"editor_model_form_title";s:27:"Module with Multiple Blocks";s:21:"editor_model_prices_3";s:16:"Prices 3 columns";s:21:"editor_model_prices_4";s:16:"Prices 4 columns";s:26:"editor_model_select_course";s:15:"Select a course";s:24:"editor_model_top_courses";s:11:"Top courses";s:32:"editor_model_top_courses_eadflix";s:28:"Top courses Number - EadFlix";s:39:"editor_model_top_courses_number_eadflix";s:27:"Top cursos Number - EadFlix";s:26:"editor_model_youtube_video";s:37:"(Optional) A Youtube background video";s:23:"footer_background_color";s:23:"Footer background color";s:28:"footer_background_color_desc";s:137:"Sélectionner la couleur d’arrière-plan pour la section du pied de page du site Web. Laisser vide pour utiliser la couleur principale.";s:17:"footer_copywriter";s:16:"Made with ❤️";s:14:"footer_heading";s:10:"Block {$a}";s:31:"footer_heading_description_desc";s:423:"<ul>
  <li><strong>No blocks filled:</strong> the footer will not be displayed.</li>
  <li><strong>1 block filled:</strong> the content will be displayed as text, without block formatting.</li>
  <li><strong>2, 3, or 4 blocks filled:</strong> the theme will automatically adjust the layout to display the blocks responsively and proportionally.</li>
</ul>
Fill in only the blocks you need, the theme takes care of the rest.";s:32:"footer_heading_description_title";s:74:"The theme automatically adapts to the number of footer blocks you fill in:";s:11:"footer_html";s:22:"Footer Block {$a} HTML";s:16:"footer_html_desc";s:69:"Add the custom HTML code that will be displayed in footer block {$a}.";s:22:"footer_show_copywriter";s:21:"Show Made with ❤️";s:27:"footer_show_copywriter_desc";s:50:"Uncheck if you want to hide the "Made with ❤️"";s:12:"footer_title";s:18:"Titre du bloc {$a}";s:17:"footer_title_desc";s:75:"Set the title that will appear above the HTML content in footer block {$a}.";s:14:"footersettings";s:27:"Paramètres du pied de page";s:19:"frontpage_add_block";s:23:"Ajouter un nouveau bloc";s:25:"frontpage_add_block_title";s:30:"Select the sample block to add";s:23:"frontpage_change_editor";s:41:"Create the homepage with the Page editor?";s:24:"frontpage_enable_editing";s:43:"Enable editing to add items to the homepage";s:15:"generalsettings";s:16:"General settings";s:12:"homesettings";s:13:"Home Settings";s:18:"imageacceptedtypes";s:41:"Only image files of type {$a} are allowed";s:12:"language_all";s:23:"All available languages";s:20:"loginbackgroundimage";s:27:"Login page background image";s:25:"loginbackgroundimage_desc";s:56:"The image to display as a background for the login page.";s:10:"pluginname";s:12:"Ead Training";s:7:"preview";s:13:"Block preview";s:25:"privacy:drawerblockclosed";s:54:"The current preference for the block drawer is closed.";s:23:"privacy:drawerblockopen";s:52:"The current preference for the block drawer is open.";s:25:"privacy:drawerindexclosed";s:54:"The current preference for the index drawer is closed.";s:23:"privacy:drawerindexopen";s:52:"The current preference for the index drawer is open.";s:16:"privacy:metadata";s:71:"The Ead Training theme does not store any personal data about any user.";s:43:"privacy:metadata:preference:draweropenblock";s:67:"The user's preference for hiding or showing the drawer with blocks.";s:43:"privacy:metadata:preference:draweropenindex";s:73:"The user's preference for hiding or showing the drawer with course index.";s:41:"privacy:metadata:preference:draweropennav";s:71:"The user's preference for hiding or showing the drawer menu navigation.";s:23:"quickstart_alert_notadd";s:170:"It is not possible to change the homepage banner after it has been added. To modify it, you need to go to the <a href="{$a}/">homepage</a> and delete the existing banner.";s:26:"quickstart_alert_notdelete";s:144:"It is not possible to remove blocks added here. To delete them, go to the <a href="{$a}/">homepage</a> and remove the blocks you no longer want.";s:26:"quickstart_banner-backpack";s:8:"Backpack";s:22:"quickstart_banner-blue";s:4:"Blue";s:36:"quickstart_banner-footer_block_count";s:23:"Number of footer blocks";s:22:"quickstart_banner-gray";s:4:"Gray";s:23:"quickstart_banner-green";s:5:"Green";s:25:"quickstart_banner-kitchen";s:7:"Kitchen";s:27:"quickstart_banner-lifestyle";s:9:"Lifestyle";s:25:"quickstart_banner-medical";s:7:"Medical";s:23:"quickstart_banner-nurse";s:5:"Nurse";s:24:"quickstart_banner-orange";s:6:"Orange";s:33:"quickstart_banner-recreation-room";s:15:"Recreation room";s:21:"quickstart_banner-red";s:3:"Red";s:23:"quickstart_banner-relex";s:5:"Relex";s:23:"quickstart_banner-saved";s:42:"The settings have been saved successfully.";s:24:"quickstart_banner-school";s:6:"School";s:26:"quickstart_banner-security";s:8:"Security";s:28:"quickstart_banner-tecnologie";s:10:"Tecnologie";s:24:"quickstart_banner-yellow";s:6:"Yellow";s:30:"quickstart_course_choose_below";s:24:"Or choose a banner below";s:34:"quickstart_course_upload_or_choose";s:53:"Upload an image or choose the type of banner you want";s:32:"quickstart_course_with_animation";s:14:"With animation";s:35:"quickstart_course_without_animation";s:17:"Without animation";s:27:"quickstart_home_pagebuilder";s:21:"Home with Page Editor";s:32:"quickstart_home_pagebuilder_desc";s:46:"Customizable interface with editable sections.";s:30:"quickstart_home_selectsections";s:28:"Select the desired sections:";s:27:"quickstart_home_selectstyle";s:21:"Choose the Home style";s:27:"quickstart_home_traditional";s:23:"Traditional Moodle Home";s:32:"quickstart_home_traditional_desc";s:96:"Default Moodle homepage with blocks and courses. Click the button below to edit system settings.";s:24:"quickstart_settings_link";s:250:"<div class="card mb-5">
