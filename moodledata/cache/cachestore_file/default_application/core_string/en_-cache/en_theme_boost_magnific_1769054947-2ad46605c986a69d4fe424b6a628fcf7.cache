;s:149:"The image to display as a background of the site. The background image you upload here will override the background image in your theme preset files.";s:10:"brandcolor";s:23:"Primary interface color";s:26:"brandcolor_background_menu";s:36:"Apply brand color to menu background";s:31:"brandcolor_background_menu_desc";s:221:"This setting defines whether the color set in "Brand color" will be applied to the menu items or to the menu background.<br>If applied to the background, the menu text will be displayed in white to ensure proper contrast.";s:15:"brandcolor_desc";s:88:"Set the highlight color using the selection above or by choosing from the palette below.";s:21:"cachedef_course_cache";s:17:"Course data cache";s:28:"cachedef_course_module_cache";s:20:"Course modules cache";s:18:"cachedef_css_cache";s:21:"CSS stylesheets cache";s:19:"cachedef_data_cache";s:10:"Data cache";s:24:"cachedef_frontpage_cache";s:15:"Frontpage cache";s:12:"choosereadme";s:166:"Boost Magnific is a modern highly-customisable theme. This theme is intended to be used directly, or as a parent theme when creating new themes utilising Bootstrap 4.";s:11:"configtitle";s:14:"Boost Magnific";s:14:"course_summary";s:37:"Show course summary before the Course";s:21:"course_summary_banner";s:37:"Show course summary before the Course";s:26:"course_summary_banner_desc";s:99:"If enabled, the course summary will be displayed before the main course content on the course page.";s:26:"course_summary_banner_edit";s:36:"Edit the banner image of this course";s:26:"course_summary_banner_none";s:9:"No header";s:28:"course_summary_banner_simple";s:30:"Simple header with information";s:27:"course_summary_banner_title";s:18:"Header with banner";s:19:"course_summary_desc";s:99:"If enabled, the course summary will be displayed before the main course content on the course page.";s:18:"courseindexoptions";s:20:"Course index options";s:14:"coursesettings";s:6:"Course";s:20:"delete_block_confirm";s:42:"Are you sure you want to delete the block?";s:20:"delete_block_success";s:26:"Block successfully deleted";s:18:"delete_block_title";s:12:"Delete block";s:19:"details-completaram";s:20:"Completed the course";s:19:"details-emprogresso";s:11:"In progress";s:18:"details-not-access";s:14:"Never accessed";s:16:"details-teachers";s:8:"Teachers";s:13:"details-users";s:8:"Students";s:10:"edit_block";s:10:"Edit block";s:17:"error_invalidscss";s:18:"Invalid SCSS: {$a}";s:7:"favicon";s:7:"Favicon";s:12:"favicon_desc";s:134:"The favicon is displayed next to the page title in the browser tab. A Moodle favicon is displayed if a custom favicon is not provided.";s:23:"footer_background_color";s:23:"Footer background color";s:28:"footer_background_color_desc";s:101:"Select the background color for the website’s footer section. Leave blank to use the primary color.";s:17:"footer_copywriter";s:19:"Made with ❤️ by";s:14:"footer_heading";s:10:"Block {$a}";s:31:"footer_heading_description_desc";s:423:"<ul>
  <li><strong>No blocks filled:</strong> the footer will not be displayed.</li>
  <li><strong>1 block filled:</strong> the content will be displayed as text, without block formatting.</li>
  <li><strong>2, 3, or 4 blocks filled:</strong> the theme will automatically adjust the layout to display the blocks responsively and proportionally.</li>
</ul>
Fill in only the blocks you need, the theme takes care of the rest.";s:32:"footer_heading_description_title";s:74:"The theme automatically adapts to the number of footer blocks you fill in:";s:11:"footer_html";s:22:"Footer Block {$a} HTML";s:16:"footer_html_desc";s:69:"Add the custom HTML code that will be displayed in footer block {$a}.";s:22:"footer_show_copywriter";s:21:"Show Made with ❤️";s:27:"footer_show_copywriter_desc";s:50:"Uncheck if you want to hide the "Made with ❤️"";s:12:"footer_title";s:16:"Block Title {$a}";s:17:"footer_title_desc";s:75:"Set the title that will appear above the HTML content in footer block {$a}.";s:14:"footersettings";s:15:"Footer Settings";s:19:"frontpage_add_block";s:13:"Add new block";s:25:"frontpage_add_block_title";s:30:"Select the sample block to add";s:23:"frontpage_change_editor";s:41:"Create the homepage with the Page editor?";s:24:"frontpage_enable_editing";s:43:"Enable editing to add items to the homepage";s:15:"generalsettings";s:16:"General settings";s:12:"homesettings";s:13:"Home Settings";s:18:"imageacceptedtypes";s:41:"Only image files of type {$a} are allowed";s:12:"language_all";s:23:"All available languages";s:20:"loginbackgroundimage";s:27:"Login page background image";s:25:"loginbackgroundimage_desc";s:56:"The image to display as a background for the login page.";s:9:"loginlogo";s:29:"PNG/SVG logo for login screen";s:14:"loginlogo_desc";s:234:"Upload the logo in PNG or SVG format to be displayed on the login screen. The logo should be clear and representative of your institution or company's visual identity, ensuring a professional and consistent login experience for users.";s:13:"loginsettings";s:14:"Login Settings";s:10:"logintheme";s:18:"Login canvas theme";s:17:"logintheme_aurora";s:6:"Aurora";s:24:"logintheme_clean-minimal";s:13:"Clean Minimal";s:24:"logintheme_clean-outline";s:13:"Clean Outline";s:24:"logintheme_dark-elegante";s:13:"Dark Elegante";s:15:"logintheme_desc";s:61:"Select a visual theme that will be shown in the login canvas.";s:23:"logintheme_selva-canopy";s:13:"Forest Canopy";s:10:"pluginname";s:14:"Boost Magnific";s:7:"preview";s:13:"Block preview";s:25:"privacy:drawerblockclosed";s:54:"The current preference for the block drawer is closed.";s:23:"privacy:drawerblockopen";s:52:"The current preference for the block drawer is open.";s:25:"privacy:drawerindexclosed";s:54:"The current preference for the index drawer is closed.";s:23:"privacy:drawerindexopen";s:52:"The current preference for the index drawer is open.";s:16:"privacy:metadata";s:73:"The Boost Magnific theme does not store any personal data about any user.";s:43:"privacy:metadata:preference:draweropenblock";s:67:"The user's preference for hiding or showing the drawer with blocks.";s:43:"privacy:metadata:preference:draweropenindex";s:73:"The user's preference for hiding or showing the drawer with course index.";s:41:"privacy:metadata:preference:draweropennav";s:71:"The user's preference for hiding or showing the drawer menu navigation.";s:23:"quickstart_alert_notadd";s:170:"It is not possible to change the homepage banner after it has been added. To modify it, you need to go to the <a href="{$a}/">homepage</a> and delete the existing banner.";s:26:"quickstart_alert_notdelete";s:144:"It is not possible to remove blocks added here. To delete them, go to the <a href="{$a}/">homepage</a> and remove the blocks you no longer want.";s:33:"quickstart_banner-recreation-room";s:15:"Recreation room";s:23:"quickstart_banner-saved";s:42:"The settings have been saved successfully.";s:30:"quickstart_course_choose_below";s:24:"Or choose a banner below";s:34:"quickstart_course_upload_or_choose";s:53:"Upload an image or choose the type of banner you want";s:27:"quickstart_home_pagebuilder";s:21:"Home with Page Editor";s:32:"quickstart_home_pagebuilder_desc";s:46:"Customizable interface with editable sections.";s:30:"quickstart_home_selectsections";s:28:"Select the desired sections:";s:27:"quickstart_home_selectstyle";s:21:"Choose the Home style";s:27:"quickstart_home_traditional";s:23:"Traditional Moodle Home";s:32:"quickstart_home_traditional_desc";s:96:"Default Moodle homepage with blocks and courses. Click the button below to edit system settings.";s:24:"quickstart_settings_link";s:252:"<div class="card mb-5">
<div class="card-header">Quick Start</div>
<div class="card-body"><a href="{$a}">Access the Quick Start Guide</a> and use the intuitive configurator to customize these and other settings of the Boost Magnific theme.</div>
</div>";s:16:"quickstart_title";s:21:"Theme Settings Center";s:15:"region-side-pre";s:5:"Right";s:22:"settings_accessibility";s:28:"Enable accessibility options";s:27:"settings_accessibility_desc";s:120:"Allows customization of options to improve platform accessibility, such as contrast, font size, and keyboard navigation.";s:30:"settings_accessibility_heading";s:13:"Accessibility";s:27:"settings_icons_change_icons";s:42:"Change the default icon in the course list";s:25:"settings_icons_color_icon";s:32:"Set a custom color for the icon.";s:30:"settings_icons_color_icon_desc";s:116:"Select the background color for the icon displayed in the course list. Leave blank to use the theme's default color.";s:26:"settings_icons_upload_icon";s:23:"Upload the custom icon.";s:27:"settings_icons_upload_image";s:11:"Block Image";s:32:"settings_icons_upload_image_desc";s:152:"If an image is provided, the theme will convert the module row into a block, using the image as its background. The image must have a 16:9 aspect ratio.";s:10:"showfooter";s:11:"Show footer";s:17:"top_color_heading";s:16:"Scroll Top Color";s:27:"top_scroll_background_color";s:38:"Background Color of Top Menu on Scroll";s:32:"top_scroll_background_color_desc";s:49:"Set the background color when scrolling the page.";s:14:"top_scroll_fix";s:36:"Pin the menu when scrolling the page";s:19:"top_scroll_fix_desc";s:127:"When enabled, the menu will be pinned to the top of the screen while you scroll the page, ensuring easy access to menu options.";s:19:"userprofilesettings";s:12:"User Profile";}