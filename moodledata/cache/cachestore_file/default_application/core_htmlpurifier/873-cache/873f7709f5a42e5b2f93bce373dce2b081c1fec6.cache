s:5594:"<div class="no-overflow"><p></p>
<h3>1.Aircraft types</h3>
<p><img src="https://bia-facile.fr/manuel-bia-2021_files/Image_122.jpg" alt="image" width="764" height="544" /></p>
<table style="border-collapse:collapse;border-spacing:0px;background-color:#ecf0f1;border:1px solid #000000;" border="1" cellspacing="0">
<tbody>
<tr>
<td style="border-width:1px;border-color:#000000;padding:3px;" colspan="2">
<p class="s50" style="text-align:center;"><strong>Commercial Aircraft</strong></p>
</td>
</tr>
<tr>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Avion d’affaires</p>
</td>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Corporate/executive/business aircraft</p>
</td>
</tr>
<tr>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Avion de ligne</p>
</td>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Liner aircraft</p>
</td>
</tr>
<tr>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Avion régional</p>
</td>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Commuter aircraft</p>
</td>
</tr>
<tr>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Court/moyen/long courrier</p>
</td>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Short/medium/long haul aircraft</p>
</td>
</tr>
<tr>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Mono/bi-couloir</p>
</td>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Single/twin aisle</p>
</td>
</tr>
<tr>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Avion militaire</p>
</td>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Military aircraft (surveillance, recognition, bombing, combat, transportation)</p>
</td>
</tr>
<tr>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Aérostat</p>
</td>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Aerostat</p>
</td>
</tr>
<tr>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Autogire</p>
</td>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Autogyro</p>
</td>
</tr>
<tr>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Convertible</p>
</td>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Tilt rotor aircraft</p>
</td>
</tr>
<tr>
<td style="border-width:1px;border-color:#000000;padding:3px;">
<p class="s51">Delta-plane</p>
</td>
<td style="border-width:1px;border-color:#000000;padding:3px;">
