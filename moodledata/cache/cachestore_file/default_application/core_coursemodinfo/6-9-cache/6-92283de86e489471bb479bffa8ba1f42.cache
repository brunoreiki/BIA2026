s:1:"2";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:4:"test";}i:245;O:8:"stdClass":17:{s:2:"id";s:2:"76";s:2:"cm";s:3:"245";s:3:"mod";s:4:"quiz";s:7:"section";s:1:"7";s:13:"sectionnumber";s:1:"7";s:9:"sectionid";s:2:"72";s:6:"module";s:2:"17";s:5:"added";s:10:"1737502355";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:9:"groupmode";s:1:"2";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:14:"Lancez le test";}i:278;O:8:"stdClass":17:{s:2:"id";s:3:"107";s:2:"cm";s:3:"278";s:3:"mod";s:4:"quiz";s:7:"section";s:1:"7";s:13:"sectionnumber";s:1:"7";s:9:"sectionid";s:2:"72";s:6:"module";s:2:"17";s:5:"added";s:10:"1741562486";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:9:"groupmode";s:1:"2";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:56:"Passez au niveau suivant avec cinq nouvelles questions !";}i:279;O:8:"stdClass":17:{s:2:"id";s:3:"108";s:2:"cm";s:3:"279";s:3:"mod";s:4:"quiz";s:7:"section";s:1:"7";s:13:"sectionnumber";s:1:"7";s:9:"sectionid";s:2:"72";s:6:"module";s:2:"17";s:5:"added";s:10:"1741562586";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:9:"groupmode";s:1:"2";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:94:"Testez si vous êtes prêt avec 10 questions et atteignez 100 % de certitude à votre niveau !";}i:314;O:8:"stdClass":17:{s:2:"id";s:3:"141";s:2:"cm";s:3:"314";s:3:"mod";s:4:"quiz";s:7:"section";s:1:"7";s:13:"sectionnumber";s:1:"7";s:9:"sectionid";s:2:"72";s:6:"module";s:2:"17";s:5:"added";s:10:"1743102080";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:9:"groupmode";s:1:"2";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:26:"Le défi des 100 questions";}}s:12:"sectioncache";a:8:{i:22;O:8:"stdClass":6:{s:2:"id";s:2:"22";s:7:"section";s:1:"0";s:4:"name";s:12:"Introduction";s:12:"availability";N;s:9:"component";N;s:6:"itemid";N;}i:23;O:8:"stdClass":6:{s:2:"id";s:2:"23";s:7:"section";s:1:"1";s:4:"name";s:28:"Cours partie 1 : Les débuts";s:12:"availability";N;s:9:"component";N;s:6:"itemid";N;}i:24;O:8:"stdClass":6:{s:2:"id";s:2:"24";s:7:"section";s:1:"2";s:4:"name";s:44:"Cours partie 2 : D’une guerre à l’autre";s:12:"availability";N;s:9:"component";N;s:6:"itemid";N;}i:25;O:8:"stdClass":6:{s:2:"id";s:2:"25";s:7:"section";s:1:"3";s:4:"name";s:37:"Cours partie 3 : De 1945 à nos jours";s:12:"availability";N;s:9:"component";N;s:6:"itemid";N;}i:26;O:8:"stdClass":6:{s:2:"id";s:2:"26";s:7:"section";s:1:"4";s:4:"name";s:43:"Cours partie 4 : La conquête de l’espace";s:12:"availability";N;s:9:"component";N;s:6:"itemid";N;}i:94;O:8:"stdClass":7:{s:2:"id";s:2:"94";s:7:"section";s:1:"5";s:4:"name";s:47:"Frise chronologique de l'histoire de l'aviation";s:7:"summary";s:32788:"<div class="timeline">
<div class="event"><span class="year">1752</span> – En 1752 Benjamin Franklin démontre l'origine électrique de la foudre à l'aide d'un cerf volant en vol dans un ciel d'orage. </div>
<div class="event"><span class="year">1783</span> – Le ballon qui transporta pour la première fois des êtres humains en 1783 était gonflé : à l'air chaud.</div>
<div class="event"><span class="year">1783</span> – En 1783, le premier vol d'un ballon à air chaud est rendu possible grâce au travail des frères : Montgolfier.</div>
<div class="event"><span class="year">1783</span> – La première ascension en ballon gonflé à l'air chaud en 1783 est effectuée par : Pilâtre de Rozier et le marquis d'Arlandes.</div>
<div class="event"><span class="year">1783</span> – Le 21 novembre 1783, Benjamin Franklin était au Bois de Boulogne pour être le témoin d'un évènement : Pilatre de Rozier and his friend the marquis d'Arlandes, were planning to ascend in a Montgolfier air balloon.</div>
<div class="event"><span class="year">1783</span> – Le physicien Jacques CHARLES conçoit et essaye le ballon à hydrogène sur le Champ de Mars en l'année : 1783.</div>
<div class="event"><span class="year">1785</span> – La première traversée de la Manche avec un aéronef a été réalisée : en 1785 par Jean-Pierre BLANCHARD et John JEFFRIES.</div>
<div class="event"><span class="year">1794</span> – La Compagnie des aérostiers, première unité aérienne du monde s'est illustrée en utilisant des ballons d'observation : en 1794, lors de la bataille de Fleurus.</div>
<div class="event"><span class="year">1796</span> – En 1796, un homme fut le premier à représenter les forces aérodynamiques. Il s'agit de : Georges CAYLEY.</div>
<div class="event"><span class="year">1797</span> – En 1797, un aérostier effectue depuis la nacelle d'une montgolfière le premier saut en parachute de l'Histoire. Cet aéronaute s'appelle : André-Jacques Garnerin.</div>
<div class="event"><span class="year">1804</span> – En 1804, le physicien et chimiste GAY LUSSAC effectue deux ascensions en ballon dans le but : les trois propositions ci-dessus sont exactes.</div>
<div class="event"><span class="year">1852</span> – Le 24 septembre 1852,un appareil volant piloté par Henry Giffard effectue une première. Il s'agit : du premier vol en dirigeable.</div>
<div class="event"><span class="year">1852</span> – Le premier vol d'un dirigeable fut réalisé en 1852, ce dirigeable était piloté par : Henry GIFFARD.</div>
<div class="event"><span class="year">1857</span> – En 1857, le Français Félix DU TEMPLE est resté dans l'Histoire de l'aéronautique pour avoir : réussi le décollage autonome d'un aérodyne modèle réduit.</div>
<div class="event"><span class="year">1858</span> – En 1858, Felix Tournachon dit "Nadar", fut le premier à réussir depuis la nacelle d'un ballon à gaz : une photographie aérienne de Paris.</div>
<div class="event"><span class="year">1871</span> – En 1871, Paris est assiégé par les prussiens. Toutefois, Léon Gambetta ministre du gouvernement provisoire parvient à s'évader grâce à : un ballon à gaz.</div>
<div class="event"><span class="year">1890</span> – Clément ADER a : réussi le premier décollage d'un plus lourd que l'air motorisé en 1890 (l'Eole), son aile ressemble à une aile : de chauve-souris.</div>
<div class="event"><span class="year">1893</span> – Le terme « cellule d'un avion » provient de l'invention en 1893, du cerf-volant cellulaire. Ce cerf-volant est l'invention de : Laurence HARGRAVE.</div>
<div class="event"><span class="year">1894</span> – L'aile à structure cellulaire, aujourd'hui très utilisée pour les voilures souples (parapentes et paramoteur), est dérivée du cerf-volant mis au point en 1894 par l'ingénieur : Lawrence HARGRAVE.</div>
<div class="event"><span class="year">1900</span> – Début 1900, quels frères célèbres sont les pionniers de l’aviation : les frères WRIGHT.</div>
<div class="event"><span class="year">1901</span> – Le premier dirigeable qui, partant de Saint-Cloud, parvint à contourner la Tour Eiffel en 1901 était piloté par : Alberto Santos Dumont.</div>
<div class="event"><span class="year">1903</span> – En 1903, les frères Wright ont réalisé le premier vol : d'un "plus lourd que l'air" motorisé. Le premier vol du Flyer des frères Wright s'est déroulé aux États-Unis</div>
<div class="event"><span class="year">1906</span> – On considère généralement que le manche à balai a été inventé en 1906 par : Robert ESNAUT-PELTERIE.</div>
<div class="event"><span class="year">1907</span> – En 1907, Santos-Dumont conçoit un aéroplane qu'il construit en série, et qu'il appelle : Demoiselle.</div>
<div class="event"><span class="year">1907</span> – En 1907, une machine à 2 rotors s’élève de 1,5 mètre marquant ainsi la naissance de l'hélicoptère. Son inventeur s'appelle Paul Cornu.</div>
<div class="event"><span class="year">1907</span> – En 1907, Santos-Dumont conçut un aéroplane construit en série et commercialisé. Il s'agit de : la Demoiselle.</div>
<div class="event"><span class="year">1907</span> – Louis Breguet, connu pour ses avions, développa en 1907 le gyroplane Breguet Richet N°1, il s’agissait d’un : quadri rotor monomoteur.</div>
<div class="event"><span class="year">1907</span> – En 1907, Paul Cornu décolle avec un engin de son invention : l'hélicoptère.</div>
<div class="event"><span class="year">1908</span> – Les premières liaisons commerciales aériennes avec passagers ont commencé : en 1908 avec des dirigeables.</div>
<div class="event"><span class="year">1908</span> – L'un de ces événements aéronautiques a été réalisé en 1908. Indiquez lequel : Le kilomètre en circuit fermé, par Henry Farman.</div>
<div class="event"><span class="year">1909</span> – En 1909, l'aviateur Louis Blériot se rend célèbre en traversant la Manche.</div>
<div class="event"><span class="year">1910</span> – En 1910, Henri Fabre effectue une première mondiale en décollant d'un hydravion sur l'étang de Berre, en Provence.</div>
<div class="event"><span class="year">1910</span> – En 1910 est créée l'Inspection de l'aéronautique militaire, avec pour chef le Général ROQUES.</div>
<div class="event"><span class="year">1910</span> – Le 1er janvier 1910, les seize premiers brevets sont décernés, sans examen, à des aviateurs confirmés. Cette liste est rédigée dans l’ordre alphabétique des pilotes. Le brevet n°1 incombe à Louis BLERIOT.</div>
<div class="event"><span class="year">1910</span> – L'ancêtre du simulateur de vol était destiné aux pilotes des avions Antoinette en 1910, il était : fabriqué à partir d'un tonneau de vin scié en deux et réassemblé à l'envers.</div>
<div class="event"><span class="year">1912</span> – Ce brillant ingénieur fut le concepteur du monocoque Deperdussin qui, grâce son aérodynamique et de la supériorité en ce domaine du monoplan sur le multiplan. Il dépasse les 200 km/h en 1912. Il conçu également les célèbres avions de chasse "SPAD" qui s'illustrèrent durant la guerre de 14-18. Il s'agit de : Louis BECHEREAU.</div>
<div class="event"><span class="year">1913</span> – L'une de ces performances aéronautiques a été réalisée en 1913. Laquelle : la traversée de la Méditerranée par Roland Garros.</div>
<div class="event"><span class="year">1913</span> – Le pilote français PEGOUD réalise en 1913 une première mondiale. Laquelle : le premier looping à bord de son Blériot XI.</div>
<div class="event"><span class="year">1913</span> – Par qui a été effectuée la première traversée de la Méditerranée entre Saint-Raphaël et Bizerte en 1913 : Roland GARROS.</div>
<div class="event"><span class="year">1914</span> – Pendant la Grande Guerre (1914-1918), l'escadrille française la plus prestigieuse, celle où servirent Guynemer et Fonck, et qui existe toujours avait pour emblème : la cigogne.</div>
<div class="event"><span class="year">1914</span> – En 1914, l'avion avait vaincu tous ces obstacles, sauf un, lequel : les Andes.</div>
<div class="event"><span class="year">1914</span> – Le plus célèbre des avions de chasse de la guerre de 1914-1918 est le : SPAD XIII.</div>
<div class="event"><span class="year">1914</span> – Le pilote de chasse qui détient le plus grand nombre de victoires confirmées en 1914-1918 s'appelle : Manfred Von Richtoffen.</div>
<div class="event"><span class="year">1914</span> – Vers 1914, Lawrence Sperry met au point : le premier pilote automatique.</div>
<div class="event"><span class="year">1915</span> – Le premier avion "tout métal" entièrement revêtu (aile et fuselage) est né en 1915. Cet appareil est : le monomoteur Junkers « J-1 ».</div>
<div class="event"><span class="year">1915</span> – En 1915, le tir synchronisé de la mitrailleuse à travers l'hélice a été mis au point par : Antony FOKKER.</div>
<div class="event"><span class="year">1915</span> – Le premier avion métallique de l'histoire est né en 1915. Cet appareil est : Le monomoteur Junkers «J-1».</div>
<div class="event"><span class="year">1916</span> – En 1916, Marcel Dassault (qui s'appelait Marcel Bloch à l'époque) a conçu : une hélice "l'éclaire".</div>
<div class="event"><span class="year">1917</span> – Le premier appontage d'un avion de chasse sur un porte-avions a eu lieu en 1917 par un avion : Sopwith Pup.</div>
<div class="event"><span class="year">1917</span> – En 1917, l'as allemand Mandfred Von Richtofen s'illustre aux commandes de son Fokker DRI. Cet avion connu pour sa maniabilité était équipé de : trois ailes.</div>
<div class="event"><span class="year">1917</span> – L'escadrille que commandait Manfred VON RICHTOFEN en 1917-1918 était appelée : le Cirque Volant.</div>
<div class="event"><span class="year">1918</span> – Dès novembre 1918, profitant des avancées techniques issues de la Grande Guerre, Pierre Latécoère fonde l'Aéropostale avec des avions Breguet XIV.. Elle a pour but de développer des lignes aériennes vers : l'Afrique et l'Amérique du Sud.</div>
<div class="event"><span class="year">1919</span> – Les premières liaisons commerciales aériennes sont apparues : entre les deux guerres mondiales, dès les années 1919 et 1920.</div>
<div class="event"><span class="year">1920</span> – Il y a 100 ans, en 1920, toute jeune brevetée, René Caudron l'engage et en fait la première femme pilote d'essai. Elle passe à la postérité pour avoir vaincu la Cordillère des Andes en 1921 un an plus tard. Elle s'appelait : Adrienne Bolland.</div>
<div class="event"><span class="year">1920</span> – Le directeur d'exploitation des ligues de l'aéropostale de 1920 à 1931 était : Didier DAURAT.</div>
<div class="event"><span class="year">1920</span> – Dans les années 1920, la recherche s'oriente en particulier vers le pilotage sans visibilité. Le premier instrument étudié à cet effet et utilisé par Lindbergh lors de sa célèbre traversée de l'Atlantique, est : le contrôleur de vol Badin.</div>
<div class="event"><span class="year">1926</span> – Le premier lancement d’une fusée à propergol liquide a été effectué : en 1926 par GODDARD.</div>
<div class="event"><span class="year">1927</span> – Charles Lindbergh a traversé l'Atlantique nord : d'Ouest en Est en 1927 à bord du Spirit of Saint Louis il se pose : au Bourget.</div>
<div class="event"><span class="year">1927</span> – Lors de son illustre vol New-York-Paris de mai 1927, Charles Lindbergh : devait se servir d'un périscope pour voir devant lui.</div>
<div class="event"><span class="year">1928</span> – Les premières inventions de la propulsion à réaction ont eu lieu dans l'Entre-deux-guerre : c'est l'Anglais Franck Whittle qui invente le turboréacteur 1928.</div>
<div class="event"><span class="year">1929</span> – En juin 1929, l'avion transatlantique l'« Oiseau Canari » a été contraint de se dérouter vers l'Espagne alors que sa destination initiale était Paris à cause : de la surcharge résultant d'un passager clandestin.</div>
<div class="event"><span class="year">1929</span> – En 1929, un équipage français réussit la première traversée de l’Atlantique Nord dans le sens Etats Unis - Europe aux commandes du : Bernard 191 « Oiseau Canari ».</div>
<div class="event"><span class="year">1929</span> – Le roman de Saint-Exupéry, écrit en 1929, évoquant la ligne Latécoère entre Toulouse et Dakar a pour titre : Courrier Sud.</div>
<div class="event"><span class="year">1930</span> – Dans les années 1930, les Allemands deviennent les leaders mondiaux dans la construction des planeurs. Ce succès est dû en grande partie : à l'interdiction qui leur est imposée de constituer une aviation militaire motorisée après la guerre 14-18.</div>
<div class="event"><span class="year">1930</span> – Elle obtient son premier brevet de pilote en 1930 et reçoit le commandement de la première escadrille de convoyage en 1939 avec Maryse Bastié. Cette célèbre aviatrice de l'Entre-deux-Guerres est : Jacqueline AURIOL.</div>
<div class="event"><span class="year">1930</span> – Dans les années 1930 en France, un plan d'eau a servi de base aux hydravions pour les traversées de l'Atlantique, devenant ainsi un aéroport international c'est : le lac de Biscarosse.</div>
<div class="event"><span class="year">1930</span> – Paris — New-York est effectué en avion pour la 1ère fois en 1930 par : Dieudonné Costes et Maurice Bellonte.</div>
<div class="event"><span class="year">1930</span> – Jean Mermoz effectue en 1930, la première traversée postale de l'Atlantique Sud de Saint-Louis-du-Sénégal à Natal (Brésil) avec un avion : Latécoère 28.</div>
<div class="event"><span class="year">1930</span> – En 1930, les pilotes français Costes et Bellonte traversent l'Atlantique Nord dans le sens Paris New-York aux commandes du : Breguet 19 « Point d'Interrogation ».</div>
<div class="event"><span class="year">1931</span> – En 1931, en France, a eu lieu la première démonstration de vol en patrouille avec 3 appareils d’entrainement de type monoplan parasol. Cet avion était un : Morane-Saulnier.</div>
<div class="event"><span class="year">1932</span> – En 1932, l'américaine Amelia Earhart a été la première femme à réaliser une traversée aérienne océanique en solitaire. Ce fut : l'Atlantique Nord.</div>
<div class="event"><span class="year">1932</span> – Quelle est l'aviatrice qui a traversé la première l'Atlantique entre Terre-Neuve et l'Irlande en 1932 : Amélie EARHART.</div>
<div class="event"><span class="year">1932</span> – En 1932, l'américaine Amélia Earhart a été la première femme à réaliser une traversée aérienne en solitaire. Laquelle : l'Atlantique Nord.</div>
<div class="event"><span class="year">1933</span> – L'armée de l'air française a été créée en : fin de l’année 1933 et mise en œuvre durant l’hiver 1934.</div>
<div class="event"><span class="year">1933</span> – L'Aéropostale fut à l'origine de la création d'une grande compagnie aérienne en 1933, elle s'appelait : Air France.</div>
<div class="event"><span class="year">1933</span> – La compagnie Air France a été créée en : 1933.</div>
<div class="event"><span class="year">1933</span> – En janvier 1933, sur quel nouvel avion Jean MERMOZ réalise un vol direct entre le Sénégal et Natal au Brésil : le Latécoère 28 Comte de La Vaulx.</div>
<div class="event"><span class="year">1933</span> – Quel groupe français a été créé en 1933 : Air France.</div>
<div class="event"><span class="year">1933</span> – Considéré comme le père de l’aviation populaire, Henri Mignet développe en 1933 un aéronef original qui ne peut se mettre en vrille, il s’agissait du : pou du Ciel.</div>
<div class="event"><span class="year">1935</span> – Le Douglas DC-3 a effectué son premier vol en : 1935.</div>
<div class="event"><span class="year">1935</span> – Le Messerschmitt Bf 109, a été le plus construit des avions de combat allemands de la seconde guerre mondiale et le Focke-Wulf 190 le meilleur. Ils ont respectivement effectué leur premier vol en : 1935 et 1939.</div>
<div class="event"><span class="year">1935</span> – Considéré par les historiens comme l'avion du 20ème siècle, le Douglas DC-3 a effectué son premier vol en : 1935.</div>
<div class="event"><span class="year">1936</span> – Jean Mermoz disparut au large des côtes de Dakar en 1936 à bord de quel appareil : La croix du Sud.</div>
<div class="event"><span class="year">1936</span> – En 1936, disparaît Jean-Mermoz à bord de son Latécoère 300 lors d'une traversée de l'Atlantique Dakar-Natal en équipage. L'avion s'appelait : la Croix du sud.</div>
<div class="event"><span class="year">1936</span> – Maryse Bastié fut la première aviatrice à traverser l'Atlantique sud de Dakar à Natal en : 1936.</div>
<div class="event"><span class="year">1937</span> – En 1937, le "LZ 129 Hindenburg" est le plus gros dirigeable jamais construit jusqu'alors. Il fut détruit, à son arrivée à Lakehurst (New York), par un incendie dans lequel périrent 39 passagers. Cet appareil est de la marque : allemande "Zeppelin".</div>
<div class="event"><span class="year">1937</span> – En 1937 le dirigeable Hindenburg brûle en faisant 36 victimes. Il était gonflé au : dihydrogène.</div>
<div class="event"><span class="year">1937</span> – En 1937, avant l'entrée des Etats Unis dans le conflit mondial, l'américaine Amélia Earhart disparaît en effectuant une traversée aérienne maritime du Pacifique.</div>
<div class="event"><span class="year">1939</span> – Le Heinkel "He-178" : fut le premier avion à réaction à avoir volé en 1939.</div>
<div class="event"><span class="year">1940</span> – Lequel de ces avions n'était pas encore en service en mai 1940, lors de la campagne de France : De Havilland 98 "Mosquito".</div>
<div class="event"><span class="year">1940</span> – Durant la bataille d'Angleterre de juillet à septembre 1940, lequel de ces avions n'a pas été engagé : Spad XIII.</div>
<div class="event"><span class="year">1940</span> – En 1940, lors de la bataille de France, l’armée de l’air utilisa : des Dewoitine 520.</div>
<div class="event"><span class="year">1941</span> – L'attaque japonaise contre Pearl Harbor, le 7 décembre 1941, fut effectuée : par des avions embarqués sur des porte-avions.</div>
<div class="event"><span class="year">1941</span> – Le 7 décembre 1941, les Japonais déclarent la guerre aux Etats Unis en attaquant la base de Pearl Harbor au moyen de : chasseurs et bombardiers lancés depuis des porte-avions.</div>
<div class="event"><span class="year">1941</span> – Des femmes-pilotes soviétiques participèrent à la guerre dans les airs entre 1941 et 1945 : en participant aux combats du front de l'Est où elles furent surnommées "les sorcières de la nuit".</div>
<div class="event"><span class="year">1942</span> – Le premier lancement d'une fusée balistique stratosphérique appelée "V2", a été effectué : en 1942 par Wernher VON BRAUN.</div>
<div class="event"><span class="year">1943</span> – En juin 1943, les forces nazies mettent en service les premières bombes volantes V1. Le pulso-réacteur de ces fusées était alimenté par : de l'acétylène.</div>
<div class="event"><span class="year">1944</span> – En 1944, la Luftwaffe met en service un avion construit par Messerschmitt dont la particularité est d'être : à réaction.</div>
<div class="event"><span class="year">1944</span> – St-Exupery disparait en 1944 avec un avion de type : Lockheed P-38 Lightning.</div>
<div class="event"><span class="year">1944</span> – L'Organisation Internationale de l'Aviation Civile (OACI) a été créée en : 1944.</div>
<div class="event"><span class="year">1944</span> – Les pilotes de l'escadrille des Red Tails (US Air Force) se sont brillamment distingués en 1944 dans la lutte contre la Luftwaffe. Leur recrutement avait pourtant été discuté car : ils étaient noirs.</div>
<div class="event"><span class="year">1944</span> – Le 6 juin 1944 du côté des alliés, le nombre d'avions engagés fut de : 11590 appareils.</div>
<div class="event"><span class="year">1944</span> – En 1944, l'OACI fut créée. Le sigle O.A.C.I. signifie : organisation de l'aviation civile internationale.</div>
<div class="event"><span class="year">1945</span> – En 1945, la première bombe atomique a été larguée sur Hiroshima par un quadrimoteur : Boeing B-29.</div>
<div class="event"><span class="year">1945</span> – Quelle est la société française créée en 1945 : Société Nationale d'Etude et de Construction de Moteurs d'Avions.</div>
<div class="event"><span class="year">1946</span> – L'avion Lockheed "Constellation" a été mis en service au sein de la compagnie Air France en : 1946.</div>
<div class="event"><span class="year">1946</span> – Le premier siège éjectable opérationnel est apparu en : 1946.</div>
<div class="event"><span class="year">1947</span> – En quelle année le mur du son a-t-il été franchi pour la première fois : 1947.</div>
<div class="event"><span class="year">1947</span> – Chuck YEAGER est le premier pilote au monde à avoir franchi le mur du son en 1947 sur : le BELL X-1.</div>
<div class="event"><span class="year">1948</span> – En France, le premier essai en vol d'un siège éjectable a été réalisé en 1948 par : Robert CARTIER.</div>
<div class="event"><span class="year">1948</span> – L'avion le plus utilisé par les Occidentaux pour assurer le ravitaillement de Berlin par pont aérien lors du blocus soviétique entre juin 1948 et mai 1949 fut : le Douglas C-54 "Skymaster".</div>
<div class="event"><span class="year">1950</span> – L'ingénieur français René Leduc a mis au point dans les années 1950 : le statoréacteur.</div>
<div class="event"><span class="year">1950</span> – Le succès de la Caravelle, à la fin des années 1950, s'explique principalement par : le silence en cabine obtenu en plaçant les réacteurs à l'arrière du fuselage.</div>
<div class="event"><span class="year">1950</span> – Cet avion est de conception des années : 1950.</div>
<div class="event"><span class="year">1953</span> – Le 1er pilote français à avoir franchi le "mur" du son en 1953 était : Constantin ROZANOFF.</div>
<div class="event"><span class="year">1953</span> – La Patrouille de France (PAF) a été créée en : 1953.</div>
<div class="event"><span class="year">1955</span> – Trois aéronefs ont effectué leur premier vol en 1955. Ce sont les trois aéronefs suivants : Fokker 27, Alouette II et Caravelle.</div>
<div class="event"><span class="year">1955</span> – Lors de sa première présentation publique en 1955, le prototype du quadriréacteur de transport civil BOEING 707 a fait : Un tonneau lent.</div>
<div class="event"><span class="year">1957</span> – Spoutnik, le premier satellite artificiel, a été lancé en : 1957.</div>
<div class="event"><span class="year">1957</span> – La première mise en orbite par les Soviétiques d'un satellite artificiel dénommé Spoutnik eut lieu en : 1957.</div>
<div class="event"><span class="year">1957</span> – Spoutnik 1, le premier satellite artificiel, a été lancé en : 1957.</div>
<div class="event"><span class="year">1960</span> – Depuis les années 1960, création du seul avion opérationnel à décollage et atterrissage vertical (A.D.A.V.).</div>
<div class="event"><span class="year">1961</span> – Le premier homme qui effectua une orbite complète dans l’espace en 1961 fut : le Soviétique Youri Gagarine (programme Vostok).</div>
<div class="event"><span class="year">1961</span> – En 1961, la France se lance dans la course à l'espace en décidant de construire la fusée à trois étages "Diamant". Cette dernière lancera et satellisera le premier satellite français « Astérix » en 1965, depuis la base de : d'Hammaguir.</div>
<div class="event"><span class="year">1962</span> – En quelle année John GLENN a effectué sa première mission spatiale autour de la Terre : 1962.</div>
<div class="event"><span class="year">1962</span> – Le premier satellite de télécommunication a été lancé le 10 juillet 1962. Ce satellite a été appelé : Telstar 1.</div>
<div class="event"><span class="year">1963</span> – Depuis 1963, le record d'altitude est détenu par l'avion fusée North American X15. Quelle est l'attitude atteinte : 107960 mètres.</div>
<div class="event"><span class="year">1963</span> – En 1963, l'avion-fusée North American X-15 atteignit l'altitude record de : 107 960 m.</div>
<div class="event"><span class="year">1965</span> – Le premier satellite français a été lancé en 1965 par une fusée française appelée : Diamant.</div>
<div class="event"><span class="year">1965</span> – Le premier homme à avoir quitté son vaisseau spatial en orbite fut : Alexeï LEONOV en 1965.</div>
<div class="event"><span class="year">1968</span> – Le BIA qui offre aux jeunes un accès à l’aéronautique via l'éducation nationale a été créé le : 04 octobre 1968.</div>
<div class="event"><span class="year">1969</span> – Le premier homme à avoir posé le pied sur la Lune le 21 juillet 1969 est : Neil ARMSTRONG.</div>
<div class="event"><span class="year">1969</span> – Le 2 mars 1969, le supersonique "Concorde" effectuait son premier vol. Le commandant de bord de ce vol était : André TURCAT.</div>
<div class="event"><span class="year">1969</span> – Le programme qui a permis la conquête de la Lune par les Américains en 1969 s'appelait : Apollo.</div>
<div class="event"><span class="year">1969</span> – Le Concorde a fait son premier vol en 1969. Quel autre avion mythique a également volé pour la première fois cette année-là : Boeing 747.</div>
<div class="event"><span class="year">1969</span> – Quel évènement historique qui s’est déroulé en 1969, est retracé dans le film "First Man" : la mission Apollo 11 et les premiers pas sur la Lune.</div>
<div class="event"><span class="year">1969</span> – Depuis sa mise en service, aucun avion commercial n'a encore remplacé le supersonique franco-britanique “ Concorde ”, éclatante preuve du savoir faire technologique européen. Cet appareil dont le prototype 001 est conservé au musée de l'air et de l'Espace du Bourget a effectué son premier vol en : 1969.</div>
<div class="event"><span class="year">1970</span> – L'équipage de la mission spatiale Apollo 13 menée en 1970 par les Etats-Unis pour explorer la Lune a été : victime d'une grave avarie le mettant en péril.</div>
<div class="event"><span class="year">1977</span> – Le vaisseau spatial lancé par la NASA en 1977 et qui est officiellement sorti du système solaire en 2013 est : Voyager 1.</div>
<div class="event"><span class="year">1979</span> – Les premières images filmées de la planète Saturne ont été transmises le 1er septembre 1979 par la sonde spatiale : Viking 1.</div>
<div class="event"><span class="year">1979</span> – La fusée Ariane a été tirée pour la première fois.</div>
<div class="event"><span class="year">1981</span> – La navette spatiale américaine qui a été la première à voler le 12 avril 1981 s'appelait : Columbia.</div>
<div class="event"><span class="year">1982</span> – Quel est le premier cosmonaute français à être allé dans l'espace en 1982 : Jean-Loup CHRETIEN.</div>
<div class="event"><span class="year">1986</span> – Le Dassault Rafale a effectué son premier vol en : 1986.</div>
<div class="event"><span class="year">1986</span> – En décembre 1986, le "Voyager" construit par RUTAN a effectué : le premier vol autour du monde sans escale et sans ravitaillement.</div>
<div class="event"><span class="year">1990</span> – Le premier télescope spatial mis en exploitation est : Hubble, lancé en 1990.</div>
<div class="event"><span class="year">1992</span> – l’Europe via son agence spatiale a travaillé sur le développement, abandonné en 1992, d’une navette spatiale, il s’agissait du projet : Hermès.</div>
<div class="event"><span class="year">1997</span> – Jusqu'en 1997, les liaisons aériennes intérieures françaises étaient assurées principalement par : Air Inter.</div>
<div class="event"><span class="year">1999</span> – Le premier tour du monde sans escale en ballon s'est déroulé en : 1999.</div>
<div class="event"><span class="year">2000</span> – En 2000, où a-t-on retrouvé les restes de l’avion de Saint-Exupéry : la mer Méditerranée.</div>
<div class="event"><span class="year">2003</span> – Quelle compagnie a fêté en 2003 ses 70 ans : Air France.</div>
<div class="event"><span class="year">2003</span> – Pour répondre aux futurs enjeux environnementaux, le suisse Bertrand Picard a lancé en 2003 le projet : « Solar impulse ».</div>
<div class="event"><span class="year">2004</span> – L'objectif de la sonde Rosetta, lancée en 2004 et parvenue à destination 10 ans plus tard, était : de poser un atterrisseur sur une comète pour analyser sa composition.</div>
<div class="event"><span class="year">2005</span> – L'Airbus A-380 a effectué son vol initial en : 2005.</div>
<div class="event"><span class="year">2005</span> – Le premier vol de l'A380 a eu lieu en : 2005.</div>
<div class="event"><span class="year">2007</span> – Le premier Airbus A380 mis en service a été livré a la compagnie : Singapore Airlines en 2007.</div>
<div class="event"><span class="year">2007</span> – L'Airbus A-380 est entré en service commercial en : 2007.</div>
<div class="event"><span class="year">2009</span> – En 2009, Airbus inaugure le premier vol commercial du plus grand avion civil au monde. Cet avion s'appelle : A380.</div>
<div class="event"><span class="year">2009</span> – Quel exploit, réalisé par le pilote Chesley Sullenberger en 15 janvier 2009, a permis de sauver tous ses passagers : il a fait amerrir un airbus A320 sur le fleuve Hudson suite à une collision aviaire.</div>
<div class="event"><span class="year">2012</span> – Le passage du mur du son en chute libre est : réalisé pour la première fois par l’autrichien Félix Baumgartner en 2012.</div>
<div class="event"><span class="year">2013</span> – La compagnie aérienne qui aura 80 ans en 2013 est : Air France.</div>
<div class="event"><span class="year">2013</span> – En 2013, nous avons fêté l'anniversaire du premier vol effectué par les frères Wright, il y a : 110 ans.</div>
<div class="event"><span class="year">2014</span> – En novembre 2014, la sonde Roseta a déposé sur la comète Churyumov un robot appelé : Philae.</div>
<div class="event"><span class="year">2014</span> – Issu du plan pour une « nouvelle France industrielle », l’avion électrique E-fan effectue son premier vol en : 2014.</div>
<div class="event"><span class="year">2015</span> – En 2015, la société américaine SpaceX a été à l'origine d'une importante innovation dans le lancement de charges utiles dans l'espace : au retour du vol, le lanceur est revenu sur son pas de tir et a pu être récupéré.</div>
<div class="event"><span class="year">2016</span> – En 2016, l'avion Solar Impulse 2 a bouclé le premier tour du monde aérien : sans consommer de carburant fossile.</div>
<div class="event"><span class="year">2016</span> – En novembre 2016, le dixième spationaute français a rejoint la station spatiale internationale (ISS), à bord de Soyouz MS-03, pour une mission de six mois. Il est d'ailleurs en 2018, le parrain des 50 ans du B.I.A. Il s'agit de : Thomas Pesquet.</div>
<div class="event"><span class="year">2019</span> – Le 1er janvier 2019, une sonde a survolé Ultima Thulé, l'objet le plus lointain jamais survolé par un objet de fabrication humaine, il s'agissait de : New horizons.</div>
<div class="event"><span class="year">2022</span> – L'Agence spatiale européenne (ESA) a annoncé en 2022 qu'une astronaute française faisait désormais partie de la nouvelle promotion d'astronautes il s'agit de : Sophie ADENOT.</div>
<div class="event"><span class="year">2022</span> – Le DR 400 fête ses 50 ans cette année (en 2022), quel constructeur l'a commercialisé à sa sortie en mars 1972 : ROBIN.</div>
</div>";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}i:71;O:8:"stdClass":6:{s:2:"id";s:2:"71";s:7:"section";s:1:"6";s:4:"name";s:72:"Les annales des examens du BIA et leurs corrigées sur cette thématique";s:12:"availability";N;s:9:"component";N;s:6:"itemid";N;}i:72;O:8:"stdClass":7:{s:2:"id";s:2:"72";s:7:"section";s:1:"7";s:4:"name";s:23:"Test de positionnement ";s:7:"summary";s:307:"<p></p>
<p>Pour aborder plus efficacement les cours et les notions de ce chapitre, commencez par réaliser un test de positionnement pour évaluer vos connaissances sur les aéronefs et les engins spatiaux. Les résultats de ce test nous permettront de vous proposer des cours adaptés à votre niveau.</p>";s:12:"availability";s:28:"{"op":"&","c":[],"showc":[]}";s:9:"component";N;s:6:"itemid";N;}}s:9:"shortname";s:3:"HCA";s:8:"fullname";s:54:"Histoire et culture de l’aéronautique et du spatial";s:6:"format";s:5:"tiles";s:16:"enablecompletion";s:1:"1";s:9:"groupmode";s:1:"2";s:14:"groupmodeforce";s:1:"0";s:8:"cacherev";s:10:"1758522014";}s:7:"version";i:1758522014;}