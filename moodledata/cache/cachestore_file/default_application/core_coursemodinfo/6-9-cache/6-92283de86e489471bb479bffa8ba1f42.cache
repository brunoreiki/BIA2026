</div></div>";}i:323;O:8:"stdClass":17:{s:2:"id";s:3:"150";s:2:"cm";s:3:"323";s:3:"mod";s:4:"quiz";s:7:"section";s:1:"4";s:13:"sectionnumber";s:1:"4";s:9:"sectionid";s:2:"26";s:6:"module";s:2:"17";s:5:"added";s:10:"1743439155";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:9:"groupmode";s:1:"2";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:39:"Évaluez vos connaissances sur ce cours";}i:250;O:8:"stdClass":17:{s:2:"id";s:2:"81";s:2:"cm";s:3:"250";s:3:"mod";s:4:"quiz";s:7:"section";s:1:"6";s:13:"sectionnumber";s:1:"6";s:9:"sectionid";s:2:"71";s:6:"module";s:2:"17";s:5:"added";s:10:"1740383328";s:7:"visible";s:1:"1";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"1";s:9:"groupmode";s:1:"2";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:12:"Annales 2024";}i:249;O:8:"stdClass":17:{s:2:"id";s:2:"80";s:2:"cm";s:3:"249";s:3:"mod";s:4:"quiz";s:7:"section";s:1:"6";s:13:"sectionnumber";s:1:"6";s:9:"sectionid";s:2:"71";s:6:"module";s:2:"17";s:5:"added";s:10:"1737416732";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"0";s:9:"groupmode";s:1:"2";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:12:"Annales 2024";}i:237;O:8:"stdClass":17:{s:2:"id";s:2:"68";s:2:"cm";s:3:"237";s:3:"mod";s:4:"quiz";s:7:"section";s:1:"6";s:13:"sectionnumber";s:1:"6";s:9:"sectionid";s:2:"71";s:6:"module";s:2:"17";s:5:"added";s:10:"1737416732";s:7:"visible";s:1:"0";s:19:"visibleoncoursepage";i:1;s:10:"visibleold";s:1:"0";s:9:"groupmode";s:1:"2";s:10:"completion";s:1:"1";s:19:"completionpassgrade";s:1:"0";s:15:"downloadcontent";s:1:"1";s:4:"lang";s:0:"";s:4:"name";s:12:"Annales 2024";}i:253;O:8:"stdClass":17:{s:2:"id";s:2:"83";s:2:"cm";s:3:"253";s:3:"mod";s:4:"quiz";s:7:"section";s:1:"6";s:13:"sectionnumber";s:1:"6";