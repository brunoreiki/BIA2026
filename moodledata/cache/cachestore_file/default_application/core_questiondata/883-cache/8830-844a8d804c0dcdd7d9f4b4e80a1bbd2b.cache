O:8:"stdClass":26:{s:2:"id";s:4:"8830";s:8:"category";s:3:"516";s:6:"parent";s:1:"0";s:4:"name";s:51:"La formation la plus commune du brouillard est due:";s:12:"questiontext";s:51:"La formation la plus commune du brouillard est due:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:901:"Le brouillard le plus commun se forme généralement en hivers, la nuit ou tôt le matin et par temps clair et sans vent, lorsque le sol perd sa chaleur par rayonnement dans l'atmosphère plus froide. Cette perte de chaleur refroidit, par conduction, l'air proche de la surface, ce qui peut amener la température de l'air à atteindre ou à descendre sous son point de rosée, conduisant à la condensation de la vapeur d'eau présente dans l'air et à la formation de brouillard. Ce brouillard et d'épaisseur faible (500 ft). Il se dissipe par réchauffement à sa base et évolue en stratus puis cumulus.
Les autres options ne décrivent pas correctement la formation commune du brouillard:
A) implique un réchauffement, qui est contraire au processus de formation du brouillard
C) et D) décrivent des processus qui ne sont pas typiquement associés à la formation du brouillard le plus commun.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143230+TPnGar";s:11:"timecreated";s:10:"1732113150";s:12:"timemodified";s:10:"1732113150";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8830";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8825";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"516";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143230+VBnCEC";s:6:"parent";s:3:"515";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8830";s:10:"questionid";s:4:"8830";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:33570;O:8:"stdClass":7:{s:2:"id";s:5:"33570";s:8:"question";s:4:"8830";s:6:"answer";s:65:"au réchauffement nocturne de la masse d’air et sa condensation";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33571;O:8:"stdClass":7:{s:2:"id";s:5:"33571";s:8:"question";s:4:"8830";s:6:"answer";s:73:"au rayonnement nocturne du sol et à la condensation de la vapeur d’eau";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33572;O:8:"stdClass":7:{s:2:"id";s:5:"33572";s:8:"question";s:4:"8830";s:6:"answer";s:54:"à la marée barométrique qui détend l’atmosphère";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33573;O:8:"stdClass":7:{s:2:"id";s:5:"33573";s:8:"question";s:4:"8830";s:6:"answer";s:75:"à la convection de fin de nuit qui déclenche une condensation adiabatique";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}