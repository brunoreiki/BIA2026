O:8:"stdClass":26:{s:2:"id";s:5:"17670";s:8:"category";s:4:"1410";s:6:"parent";s:1:"0";s:4:"name";s:188:"Un avion de ligne effectue la liaison New York - Paris à la vitesse propre de 900 km/h. Il évolue dans un Jet Stream de 300 km/h orienté d'ouest en est. Quelle est alors sa vitesse-sol?";s:12:"questiontext";s:188:"Un avion de ligne effectue la liaison New York - Paris à la vitesse propre de 900 km/h. Il évolue dans un Jet Stream de 300 km/h orienté d'ouest en est. Quelle est alors sa vitesse-sol?";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:365:"Lorsque lors d’un vol, <b>le vent est face</b>à nous, alors <b>on soustrait</b> sa vitesse à notre vitesse air. Au contraire, lorsque <b>le vent est de dos, on additionne</b> sa vitesse à notre vitesse air, ce qui nous donne notre vitesse sol. <b>Noa Rolland</b><br><img width="100%" src='https://bia-caea.fr/images/vitessesol1.jpg' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+250513070315+nN9pO7";s:11:"timecreated";s:10:"1747119795";s:12:"timemodified";s:10:"1747119795";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"800";s:6:"status";s:5:"ready";s:9:"versionid";s:5:"17670";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:5:"17629";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:4:"1410";s:4:"name";s:48:"Navigation, réglementation, sécurité des vols";s:9:"contextid";s:3:"800";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+250513070315+qskfVw";s:6:"parent";s:4:"1406";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:5:"17663";s:10:"questionid";s:5:"17670";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycor