O:8:"stdClass":26:{s:2:"id";s:4:"4223";s:8:"category";s:3:"263";s:6:"parent";s:1:"0";s:4:"name";s:60:"Le décollage d'un avion se fait toujours face au vent pour:";s:12:"questiontext";s:60:"Le décollage d'un avion se fait toujours face au vent pour:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:526:"Un avion décolle toujours à la même vitesse par rapport au vent relatif <b>Vd</b>. Si le vent <b>Vv</b> est de face, la vitesse sol <b>Vs</b> nécessaire pour que le vent relatif soit suffisant pour décoller est moindre que s’il n’y a pas de vent. En effet, <font color="blue">Vs = Vd – Vv</font>. Si le vent est nul : <font color="blue">Vs = Vd</font>. Si le vent est arrière : <font color="blue">Vs = Vd + Vv</font>.
Donc, plus il y de vent de face, plus la distance de roulage est faible.
<b>Godefroy Reynaud</b>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241115093555+I2lHn9";s:11:"timecreated";s:10:"1731663355";s:12:"timemodified";s:10:"1731663355";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"801";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"4223";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"4218";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"263";s:4:"name";s:49:"Aérodynamique, aérostatique et principes du vol";s:9:"contextid";s:3:"801";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241115093555+lMaEpd";s:6:"parent";s:3:"261";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"4223";s:10:"questionid";s:4:"4223";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:15142;O:8:"stdClass":7:{s:2:"id";s:5:"15142";s:8:"question";s:4:"4223";s:6:"answer";s:38:"décoller sur une distance plus courte";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:15143;O:8:"stdClass":7:{s:2:"id";s:5:"15143";s:8:"question";s:4:"4223";s:6:"answer";s:20:"diminuer la portance";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:15144;O:8:"stdClass":7:{s:2:"id";s:5:"15144";s:8:"question";s:4:"4223";s:6:"answer";s:27:"éviter de dépasser la VNE";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:15145;O:8:"stdClass":7:{s