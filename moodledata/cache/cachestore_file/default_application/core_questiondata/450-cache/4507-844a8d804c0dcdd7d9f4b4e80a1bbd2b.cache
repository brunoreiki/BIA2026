";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:16281;O:8:"stdClass":7:{s:2:"id";s:5:"16281";s:8:"question";s:4:"4507";s:6:"answer";s:50:"la corde du profil et la direction du vent relatif";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}