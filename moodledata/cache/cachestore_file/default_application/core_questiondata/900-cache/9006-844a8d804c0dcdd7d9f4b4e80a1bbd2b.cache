O:8:"stdClass":26:{s:2:"id";s:4:"9006";s:8:"category";s:3:"523";s:6:"parent";s:1:"0";s:4:"name";s:23:"Le Mistral est un vent:";s:12:"questiontext";s:23:"Le Mistral est un vent:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:481:"Le mistral est un vent qui prend naissance dans la vallée du Rhône, entre l'est du Massif Central et l'ouest des Alpes, parcourt les basses vallées du Rhône et de la Durance du Nord vers le Sud. Le mistral souffle par rafales pouvant dépasser 100 km/h autour d'une vitesse moyenne qui atteint couramment une cinquantaine de km/h dans la journée, tout en se calmant sensiblement chaque nuit.<br><img src='https://bia-caea.fr/images/meteo2022_6.jpg' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143231+aShCWw";s:11:"timecreated";s:10:"1732113151";s:12:"timemodified";s:10:"1732113151";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"9006";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"9001";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"523";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143231+LlVDIj";s:6:"parent";s:3:"522";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"9006";s:10:"questionid";s:4:"9006";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:34274;O:8:"stdCla