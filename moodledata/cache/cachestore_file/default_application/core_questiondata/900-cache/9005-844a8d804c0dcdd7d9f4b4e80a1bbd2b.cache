O:8:"stdClass":26:{s:2:"id";s:4:"9005";s:8:"category";s:3:"523";s:6:"parent";s:1:"0";s:4:"name";s:119:"Dans le dossier météorologique du pilote, on trouve un certain nombre de messages. Parmi eux le METAR est un message:";s:12:"questiontext";s:119:"Dans le dossier météorologique du pilote, on trouve un certain nombre de messages. Parmi eux le METAR est un message:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:1557:"<b>METAR</b> : (METeorological Aerodrome Report ou METeorological Airport Report) est un message d’observation (et non de prévision) météorologique du temps sur un Aérodrome. Il est donc très fiable. Il est réédité toutes les heures ou toutes les demi-heures. C’est un message codé, toujours organisé de la même façon. 
Source : manuel BIA - CIRAS de Toulouse - http://www.ciras.fr/

<b>Exemple de METAR</b> : <font color="red">LFPG 191030Z</font color="red"> <font color="blue">21017KT</font color="blue"> <font color="green">9999</font color="green"> <font color="DarkCyan">-DZRA BKN007</font color="DarkCyan"> <font color="Brown">05/04 Q1016</font color="Brown">

<b>Décodage de ce METAR</b> :
<font color="red">LFPG 191030Z</font color="red"> : Aéroport de Paris Charles de Gaulles, le 19 du mois en cours à 10h30 Zulu (heure universelle).
<font color="blue">21017KT</font color="blue"> : Vent venant du 210° pour une vitesse de 17 Knots (noeuds).
<font color="green">9999</font color="green"> : Visibilité horizontale dominante supérieure à 10km.
<font color="DarkRed">-DZRA</font color="DarkRed"> : Faible ( – ) bruine (DZ pour Drizzle en anglais) avec de la pluie (RA pour RAin en anglais).
<font color="DarkCyan">BKN007</font color="DarkCyan"> : Couverture nuageuse fragmentée (BKN pour BroKeN en anglais) comprise entre 5 et 7 octas à une hauteur par rapport au sol de 700 pieds.
<font color="Brown">05/04 Q1016</font color="Brown"> : Température de 05° Celsius / Point de rosée de 04° Celsius et un QNH à 1016 hPa.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143231+ePaNcs";s:11:"timecreated";s:10:"1732113151";s:12:"timemodified";s:10:"1732113151";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"9005";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"9000";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"523";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143231+LlVDIj";s:6:"parent";s:3:"522";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"9005";s:10:"questionid";s:4:"9005";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:34270;O:8:"stdClass":7:{s:2:"id";s:5:"34270";s:8:"question";s:4:"9005";s:6:"answer";s:42:"d’observation du temps en un lieu donné";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34271;O:8:"stdClass":7:{s:2:"id";s:5:"34271";s:8:"question";s:4:"9005";s:6:"answer";s:40:"de prévision du temps en un lieu donné";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34272;O:8:"stdClass":7:{s:2:"id";s:5:"34272";s:8:"question";s:4:"9005";s:6:"answer";s:47:"de prévision du temps sous forme d’une carte