O:8:"stdClass":26:{s:2:"id";s:4:"9002";s:8:"category";s:3:"523";s:6:"parent";s:1:"0";s:4:"name";s:144:"Compte tenu des observations des précipitations et des impacts de foudre, on peut conclure que l’atmosphère au niveau du front étudié est:";s:12:"questiontext";s:229:"Compte tenu des observations des précipitations et des impacts de foudre, on peut conclure que l’atmosphère au niveau du front étudié est:<br><img src='https://bia-caea.fr/images/doc_m1_2022.jpg' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:955:"- La carte des fronts nous indique l’avancée d’Ouest en Est d’un front froid.
- La carte des précipitations montre qu’il pleut le long du front froid.
- La carte des impacts de foudre signale de l’orage sur toute la ligne du front froid.
Il existe des fronts froids stables et d’autres instables. Ici, la présence d’orages suffit à nous indiquer que ce front froid est instable.
<b>Bonus : qu’est ce que l’instabilité ?</b>
La nature stable ou instable d’une masse d’air est dépendante à la décroissance de la température de l’atmosphère avec l’altitude à un endroit et à un moment donné.
On dit que l’air est instable lorsque la décroissance de la température avec l’altitude est supérieure à la déperdition en chaleur d’une bulle d’air ascendante. Dans ce cas, la température d’une l’ascendance thermique restera toujours supérieure à celle de l’air environnant et son ascension continuera.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143231+BzvEbZ";s:11:"timecreated";s:10:"1732113151";s:12:"timemodified";s:10:"1732113151";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"9002";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8997";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"523";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143231+LlVDIj";s:6:"parent";s:3:"522";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"9002";s:10:"questionid";s:4:"9002";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:34258;O:8:"stdClass":7:{s:2:"id";s:5:"34258";s:8:"question";s:4:"9002";s:6:"answer";s:6:"chaude";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34259;O:8:"stdClass":7:{s:2:"id";s:5:"34259";s:8:"question";s:4:"9002";s:6:"answer";s:6:"stable";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34260;O:8:"stdClass":7:{s:2:"id";