O:8:"stdClass":26:{s:2:"id";s:4:"4941";s:8:"category";s:3:"298";s:6:"parent";s:1:"0";s:4:"name";s:80:"Pour calculer la distance de décollage d’un avion, il faut prendre en compte:";s:12:"questiontext";s:80:"Pour calculer la distance de décollage d’un avion, il faut prendre en compte:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:1133:"Le calcul de la distance de décollage d'un avion dépend de plusieurs facteurs. <b>La masse de l'avion</b> est cruciale car, un avion plus lourd nécessitera une plus grande distance pour atteindre la vitesse nécessaire à ce que la force de portance soit supérieure à la masse de l'avion. D'autre part La portance Fz est proportionnelle à <font color="blue">ρ</font> <b>la densité de l'air</b> (<font color="red">Fz = 1/2 <font color="blue">ρ</font>.V².S.Cz</font>) qui dépend de la <b>La température</b>. L'air froid étant plus dense que l'air chaud (masse volumique <font color="blue">ρ</font> plus importante) la force de portance est donc plus importante. Enfin,<b> L'altitude de l'aéroport</b> est également importante car à une altitude plus élevée, l'air est moins dense, ce qui affecte la portance et la performance des moteurs. En effet, pour un moteur à explosion, lorsque l'air est moins dense, il y a moins de molécules d'air aspirées par le moteur qui équilibre en injectant moins d'essence dans les chambres de combustion. Il y a alors moins d'air et d'essence ce qui engendre moins de puissance.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241115093603+3rCmeb";s:11:"timecreated";s:10:"1731663363";s:12:"timemodified";s:10:"1731663363";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"801";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"4941";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"4936";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"298";s:4:"name";s:49:"Aérodynamique, aérostatique et principes du vol";s:9:"contextid";s:3:"801";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241115093603+YDrQpj";s:6:"parent";s:3:"296";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"4941";s:10:"questionid";s:4:"4941";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:18014;O:8:"stdClass":7:{s:2:"id";s:5:"18014";s:8:"question";s:4:"4941";s:6:"answer";s:32:"la masse de l’avion uniquement";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:18015;O:8:"stdClass":7:{s:2:"id";s:5:"18015";s:8:"question";s:4:"4941";s:6:"answer";s:69:"la température, l’altitude de l’aéroport, la masse de l’avion";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:18016;O:8:"stdClass":7:{s:2:"id";s:5:"18016";s:8:"question";s:4:"4941";s:6:"answer";s:40:"l’altitude de l’aéroport uniquement";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:18017;O:8:"stdClass":7:{s:2:"id";s:5:"18017";s:8:"question";s:4:"4941";s:6:"answer";s:23:"aucun de ces éléments";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}