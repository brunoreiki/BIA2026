O:8:"stdClass":26:{s:2:"id";s:4:"4946";s:8:"category";s:3:"298";s:6:"parent";s:1:"0";s:4:"name";s:99:"Parmi les éléments suivants, celui qui a une influence sur la position du centre de gravité est:";s:12:"questiontext";s:99:"Parmi les éléments suivants, celui qui a une influence sur la position du centre de gravité est:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:1705:"<font color="blue"><b>Le centrage</b> est la position du centre de gravité sur l’axe longitudinal de l’avion.</font color="blue"> Pour qu’un avion vole en sécurité, son centre de gravité ne doit être ni trop vers l’avant ni trop vers l’arrière. Dans tous les cas il doit être plus vers l’avant que ne l'est <b>le foyer avion</b><font color="red">*</font color="red">.
- <b>Plus le centrage est positionné vers l’avant</b> plus l’appareil est stable donc, moins maniable, nécessitant un braquage plus important des gouvernes pour le manœuvrer. Sa traînée, sa consommation de carburant et sa vitesse de décrochage augmentent. Au-delà d’un certain point, appelé limite de centrage avant, les gouvernes de profondeurs ne sont plus capable de produire la rotation au décollage ou l'arrondi à l’atterrissage.
- <b>Plus le centrage est positionné en arrière</b>, plus l’avion est maniable, réactif et instable. Sa traînée, la consommation de carburant et sa vitesse de décrochage diminuent. Au-delà d’un certain point, appelé limite de centrage arrière, l’avion devient impilotable.

<font color="red">*</font color="red"> <b>le foyer avion</b> : c’est un point fixe et théorique de l’avion déterminé par le constructeur après calculs et / ou mesures en soufflerie. Pour analyser la stabilité de l’avion, c’est le point sur lequel on définit que s’applique non pas la portance (que l’on considère être à la verticale du centre de gravité) mais les variations de la portance. Cela permet de déterminer la stabilité de l’avion en ne considérant que la position relative de deux points : celui du foyer et celui du centre de gravité.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241115093603+GVTxCE";s:11:"timecreated";s:10:"1731663363";s:12:"timemodified";s:10:"1731663363";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"801";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"4946";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"4941";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"298";s:4:"name";s:49:"Aérodynamique, aérostatique et principes du vol";s:9:"contextid";s:3:"801";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241115093603+YDrQpj";s:6:"parent";s:3:"296";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"4946";s:10:"questionid";s:4:"4946";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:18034;O:8:"stdClass":7:{s:2:"id";s:5:"18034";s:8:"question";s:4:"4946";s:6:"answer";s:42:"la trajectoire (palier, montée, descente)";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:18035;O:8:"stdClass":7:{s:2:"id";s:5:"18035";s:8:"question";s:4:"4946";s:6:"answer";s:10:"la vitesse";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:18036;O:8:"stdClass":7:{s:2:"id";s:5:"18036";s:8:"question";s:4:"4946";s:6:"answer";s:43:"le niveau de carburant dans les réservoirs";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:18037;O:8:"stdClass":7:{s:2:"id";s:5:"18037";s:8:"question";s:4:"4946";s:6:"answer";s:15:"l’inclinaison";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}