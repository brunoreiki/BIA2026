O:8:"stdClass":26:{s:2:"id";s:4:"8887";s:8:"category";s:3:"518";s:6:"parent";s:1:"0";s:4:"name";s:28:"Le dièdre de cet avion est:";s:12:"questiontext";s:116:"Le dièdre de cet avion est:<br><img src='https://bia-caea.fr/images/aeronef-1-2021.jpg' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:549:"Le dièdre positif signifie que les ailes de l'avion sont inclinées vers le haut par rapport à l'horizontale lorsqu'on les regarde de face. Cette configuration contribue à la stabilité latérale de l'avion, c’est la configuration la plus courante pour les avions qui cherchent à être stable pour le confort. Mais le Fouga est fait pour l'entraînement au combat aérien. On voit sur les photos que ses ailes sont parfaitement horizontales. Le dièdre est nul.<br><img src='https://bia-caea.fr/images/diedre01.png' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143230+SEz2Rj";s:11:"timecreated";s:10:"1732113150";s:12:"timemodified";s:10:"1732113150";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8887";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8882";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"518";s:4:"name";s:43:"Étude des aéronefs et des engins spatiaux";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143230+v1BKF5";s:6:"parent";s:3:"515";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8887";s:10:"questionid";s:4:"8887";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23: