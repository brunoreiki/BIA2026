O:8:"stdClass":26:{s:2:"id";s:4:"8886";s:8:"category";s:3:"518";s:6:"parent";s:1:"0";s:4:"name";s:99:"Cet avion est biplace. En examinant la photo 2, quelle est la configuration des  places des pilotes";s:12:"questiontext";s:187:"Cet avion est biplace. En examinant la photo 2, quelle est la configuration des  places des pilotes<br><img src='https://bia-caea.fr/images/aeronef-1-2021.jpg' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:647:"Dans une configuration en tandem, les sièges sont disposés l'un derrière l'autre. C'est le cas pour le Fouga Magister, un avion d'entraînement militaire où l'élève et l'instructeur sont assis l'un derrière l'autre.
Les autres options ne décrivent pas correctement la configuration des sièges dans le Fouga Magister: A) en côte à côte signifie que les sièges sont situés l'un à côté de l'autre, ce qui n'est pas le cas ici
C) push-pull désigne une configuration de moteurs et non de sièges
D) vis-à-vis impliquerait que les sièges sont face à face, ce qui n'est pas une configuration courante dans les avions.
<b>Marin D.</b>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143230+GuLmJM";s:11:"timecreated";s:10:"1732113150";s:12:"timemodified";s:10:"1732113150";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8886";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8881";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"518";s:4:"name";s:43:"Étude des aéronefs et des engins spatiaux";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143230+v1BKF5";s:6:"parent";s:3:"515";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8886";s:10:"questionid";s:4:"8886";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:33794;O:8:"stdClass":7:{s:2:"id";s:5:"33794";s:8:"question";s:4:"8886";s:6:"answer";s:17:"en côte à côte";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33795;O:8:"stdClass":7:{s:2:"id";s:5:"33795";s:8:"question";s:4:"8886";s:6:"answer";s:9:"en tandem";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33796;O:8:"stdClass":7:{s:2:"id";s:5:"33796";s:8:"question";s:4:"8886";s:6:"answer";s:12:"en push-pull";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33797;O:8:"stdClass":7:{s:2:"id";s:5:"33797";s:8:"question";s:4:"8886";s:6:"answer";s:1