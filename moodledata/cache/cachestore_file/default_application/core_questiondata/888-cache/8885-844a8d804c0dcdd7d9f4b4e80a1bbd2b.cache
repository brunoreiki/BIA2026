O:8:"stdClass":26:{s:2:"id";s:4:"8885";s:8:"category";s:3:"518";s:6:"parent";s:1:"0";s:4:"name";s:30:"Le train d’atterrissage est:";s:12:"questiontext";s:118:"Le train d’atterrissage est:<br><img src='https://bia-caea.fr/images/aeronef-1-2021.jpg' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:869:"<font color="blue">Un train d'atterrissage tricycle</font color="blue"> signifie qu'il y a trois points d'appui principaux : une roue sous le nez de l'avion et deux roues principales sous les ailes ou le fuselage. Le Fouga Magister est équipé de ce type de train d'atterrissage, ce qui est courant pour de nombreux avions à réaction modernes.
Les autres options ne sont pas correctes pour le Fouga Magister:
A) un train d'atterrissage classique a deux roues principales et une roulette de queue;
C) "fixe" signifie que le train d'atterrissage ne se rétracte pas, ce qui n'est pas le cas du Fouga Magister;
D) "amovible" n'est pas un terme habituellement utilisé pour décrire les trains d'atterrissage. À ne pas confondre avec rétractable ce qui est bien le cas du train du Fouga.<br><img src='https://bia-caea.fr/images/train01.png' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143230+MnAu1N";s:11:"timecreated";s:10:"1732113150";s:12:"timemodified";s:10:"1732113150";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8885";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8880";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"518";s:4:"name";s:43:"Étude des aéronefs et des engins spatiaux";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143230+v1BKF5";s:6:"parent";s:3:"515";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8885";s:10:"questionid";s:4:"8885";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:33790;O:8:"stdClass":7:{s:2:"id";s:5:"33790";s:8:"question";s:4:"8885";s:6:"answer";s:9:"classique";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33791;O:8:"stdClass":7:{s:2:"id";s:5:"33791";s:8:"question";s:4:"8885";s:6:"answer";s:8:"tricycle";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33792;O:8:"stdClass":7:{s:2:"id";s:5:"33792";s:8:"question";s