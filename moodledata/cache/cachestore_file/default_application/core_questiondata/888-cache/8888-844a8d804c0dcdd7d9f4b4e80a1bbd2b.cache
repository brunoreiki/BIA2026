O:8:"stdClass":26:{s:2:"id";s:4:"8888";s:8:"category";s:3:"518";s:6:"parent";s:1:"0";s:4:"name";s:67:"Sur le schéma, en vue de dessus, quelle désignation est correcte:";s:12:"questiontext";s:155:"Sur le schéma, en vue de dessus, quelle désignation est correcte:<br><img src='https://bia-caea.fr/images/aeronef-1-2021.jpg' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:795:"A) <font color="blue">Bord d'attaque</font color="blue">: C'est le côté avant de l'aile d'un avion, la première partie à entrer en contact avec l'air en vol. Il est généralement arrondi ou peu épais pour optimiser la pénétration dans l'air.
B) <font color="blue">Bord de fuite</font color="blue">: C'est l'arrière de l'aile, où l'air qui a glissé sur l'aile s'échappe. Il est généralement fin.
C) <font color="blue">Saumon</font color="blue">: C'est l'extrémité de l'aile, la partie la plus éloignée du fuselage. Le saumon peut avoir différentes formes et est souvent conçu pour réduire les turbulences et améliorer l'efficacité aérodynamique de l'aile. Ici il est équipé de réservoirs.
D) <font color="blue">Nez</font color="blue">: C'est la partie avant de l'avion.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143230+NxCb2E";s:11:"timecreated";s:10:"1732113150";s:12:"timemodified";s:10:"1732113150";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8888";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8883";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"518";s:4:"name";s:43:"Étude des aéronefs et des engins spatiaux";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143230+v1BKF5";s:6:"parent";s:3:"515";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8888";s:10:"questionid";s:4:"8888";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:33802;O:8:"stdClass":7:{s:2:"id";s:5:"33802";s:8:"question";s:4:"8888";s:6:"answer";s:40:"A = bord d’attaque et B= bord de fuite";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33803;O:8:"stdClass":7:{s:2:"id";s:5:"33803";s:8:"question";s:4:"8888";s:6:"answer";s:41:"A = bord d’attaque et C = bord de fuite";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33804;O:8:"stdClass":7:{s:2:"id";s:5:"33804";s:8:"question";s:4:"8888";s:6:"answer";s:41:"D = bord d’attaque et A = bord de fuite";s:12:"answerformat";s:1:"1";s:8:"fraction"