O:8:"stdClass":26:{s:2:"id";s:5:"17158";s:8:"category";s:4:"1382";s:6:"parent";s:1:"0";s:4:"name";s:215:"Le code OACI de l'aéroport de Nice-Côte d'Azur est indiqué sur la carte VAC (doc. n°1) il s'agit de LFMN. L'OACI est un organisme chargé d'établir le cadre réglementaire de la sécurité de l'aviation civile:";s:12:"questiontext";s:215:"Le code OACI de l'aéroport de Nice-Côte d'Azur est indiqué sur la carte VAC (doc. n°1) il s'agit de LFMN. L'OACI est un organisme chargé d'établir le cadre réglementaire de la sécurité de l'aviation civile:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:933:"l'<font color="blue">OACI (Organisation de l'aviation civile internationale)</font color="blue">à pour rôle de maintenir un haut niveau de sécurité dans l'aviation civile internationale en élaborant un ensemble de normes et recommandations et en s'assurant que tout le monde suive les mêmes règles. Son travail touche les domaines de la navigation, du partage des fréquences radio, des brevets du personnel d'aviation, de la circulation aérienne, etc. L'OACI définit aussi les protocoles à suivre lors des enquêtes sur les accidents aériens.
<font color="blue">Son siège social est situé à Montréal.</font color="blue"><font color="green">Remarque : Dans l'énoncé, le mot "siège" est surprenant. On s'attend à un lieu, mais aucun n'est proposé ! Il s'agit probablement d'une coquille, "siège" est écrit à la place de "sigle". A partir de là, il est facile de répondre à la question.</font color="green">";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+250513070307+BWe7ka";s:11:"timecreated";s:10:"1747119787";s:12:"timemodified";s:10:"1747119787";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"800";s:6:"status";s:5:"ready";s:9:"versionid";s:5:"17158";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:5:"17117";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:4:"1382";s:4:"name";s:48:"Navigation, réglementation, sécurité des vols";s:9:"contextid";s:3:"800";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+250513070307+KPB89j";s:6:"parent";s:4:"1378";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:5:"17151";s:10:"questionid";s:5:"17158";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:66838;O:8:"stdClass":7:{s:2:"id";s:5:"66838";s:8:"question";s:5:"17158";s:6:"answer";s:33:"uniquement au niveau de la France";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:66839;O:8:"stdClass":7:{s:2:"id";s:5:"66839";s:8:"question";s:5:"17158";s:6:"answer";s:52:"sous la responsabilité du mi