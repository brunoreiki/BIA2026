O:8:"stdClass":26:{s:2:"id";s:5:"17129";s:8:"category";s:4:"1380";s:6:"parent";s:1:"0";s:4:"name";s:66:"En finale, le braquage des volets de courbure a pour conséquence:";s:12:"questiontext";s:66:"En finale, le braquage des volets de courbure a pour conséquence:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:1107:"<font color="blue">Le braquage des volets hypersustentateurs de bord de fuite</font color="blue"> sur les ailes d'un avion <font color="blue">augmente le coefficient de portance (Cz)</font color="blue">, ce qui permet à l'avion de voler à des vitesses plus basses et à des incidences plus fortes sans risque de décrochage, comme lors du décollage et de l'atterrissage. Cependant, cette augmentation de la portance s'accompagne également d'une <font color="blue">augmentation du coefficient de traînée (Cx)</font color="blue">, ce qui signifie que l'avion subit plus de résistance à son avancement dans l'air. <font color="blue">Sa finesse diminue</font color="blue">, car le coefficient de traînée (Cx) augmente plus que le coefficient de portance (Cz). En descente, <font color="blue">il lui devient possible de prendre une pente plus forte</font color="blue">. Enfin, la sortie des volets modifie le profil de l'aile et crée <font color="blue">un couple piqueur</font color="blue">.
<b>Marin D.</b><br><img width="100%" src='https://bia-caea.fr/images/volet01.png' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+250513070307+YHfkpV";s:11:"timecreated";s:10:"1747119787";s:12:"timemodified";s:10:"1747119787";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"800";s:6:"status";s:5:"ready";s:9:"versionid";s:5:"17129";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:5:"17088";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:4:"1380";s:4:"name";s:49:"Aérodynamique, aérostatique et principes du vol";s:9:"contextid";s:3:"800";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+250513070307+oW2F8t";s:6:"parent";s:4:"1378";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:5:"17122";s:10:"questionid";s:5:"17129";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:66722;O:8:"stdClass":7:{s:2:"id";s:5:"66722";s:8:"question";s:5:"17129";s:6:"answer";s:65:"une augmentation de la portance et une diminution de la traînée";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:66723;O:8:"stdClass":7:{s:2:"id";s:5:"66723";s:8:"question";s:5:"17129";s:6:"answer";s:67:"une augmentation de la portance et une augmentation de la traînée";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:66724;O:8:"stdClass":7:{s:2:"id";s:5:"66724";s:8:"question";s:5:"17129";s:6:"an