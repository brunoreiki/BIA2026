O:8:"stdClass":26:{s:2:"id";s:4:"8993";s:8:"category";s:3:"523";s:6:"parent";s:1:"0";s:4:"name";s:123:"Les TAF émis quelques heures avant le passage d'un front froid secondaire indiquent la présence de phénomènes tels que:";s:12:"questiontext";s:123:"Les TAF émis quelques heures avant le passage d'un front froid secondaire indiquent la présence de phénomènes tels que:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:693:"Un TAF (Terminal Aerodrome Forecast) est un message de prévision météorologique concernant un aérodrome.
Un TAF court est émis toutes les 3h et est valide 9h.
Un TAF long est émis toutes les 6h et est valide 24h ou 30h.
La forme d'un TAF et constante. Il y est indiqué sous forme codée:
- le lieu
- le vent en surface
- la visibilité
- les phénomènes météorologiques
- les nuages ou la visibilité verticale
- les changements significatifs prévus

Exemple : LFLS 010800Z 0109/0209 02006KT 9999 SCT025 PROB40 TEMPO 0109/0111 BKN025 BECMG 0111/0113 CAVOK BECMG 0113/0116 09005KT BECMG 0207/0209 VRB03KT<br><img src='https://bia-caea.fr/images/TAF1.png' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143231+2mDVHf";s:11:"timecreated";s:10:"1732113151";s:12:"timemodified";s:10:"1732113151";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8993";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8988";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"523";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143231+LlVDIj";s:6:"parent";s:3:"522";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8993";s:10:"questionid";s:4:"8993";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:34222;O:8:"stdClass":7:{s:2:"id";s:5:"34222";s:8:"question";s:4:"8993";s:6:"answer";s:38:"TH (Orage), SH (Averses) , GR (Grêle)";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34223;O:8:"stdClass":7:{s:2:"id";s:5:"34223";s:8:"question";s:4:"8993";s:6:"answer";s:38:"OR (Orage), AV (Averses) , GR (Grêle)";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34224;O:8:"stdClass":7:{s:2:"id";s:5:"3422