O:8:"stdClass":26:{s:2:"id";s:4:"8604";s:8:"category";s:3:"504";s:6:"parent";s:1:"0";s:4:"name";s:33:"Un altimètre mesure la pression:";s:12:"questiontext";s:33:"Un altimètre mesure la pression:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:790:"<font color="blue"><b>L'altimètre</b> mesure l'altitude en comparant la pression statique de l'air extérieur avec une pression de référence connue.</font color="blue"> En effet, la pression atmosphérique diminuant avec l'augmentation de l'altitude, l'altimètre utilise cette relation pour calculer et afficher l'altitude de l'avion. On dit que l'altimètre indique une d'altitude-pression.
- <font color="blue">la pression dynamique</font color="blue"> est exercé par le vent relatif. Elle dépend de la vitesse et de la densité de l'air
- <font color="blue">la pression totale</font color="blue"> est la somme de la pression statique et de la pression dynamique
- <font color="blue">la pression différentielle</font color="blue"> est la différence entre deux mesures de pression.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143228+58fUSC";s:11:"timecreated";s:10:"1732113148";s:12:"timemodified";s:10:"1732113148";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8604";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8599";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"504";s:4:"name";s:43:"Étude des aéronefs et des engins spatiaux";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143227+d8OFYU";s:6:"parent";s:3:"501";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8604";s:10:"questionid";s:4:"8604";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:32666;O:8:"stdClass":7:{s:2:"id";s:5:"32666";s:8:"question";s:4:"8604";s:6:"answer";s:8:"statique";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:32667;O:8:"stdClass":7:{s:2:"id";s:5:"32667";s:8:"question";s:4:"8604";s:6:"answer";s:9:"dynamique";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:32668;O:8:"stdClass":7:{s:2:"id";s:5:"32668";s:8:"question";s:4:"8604";s:6:"answer";s:6:"totale";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i