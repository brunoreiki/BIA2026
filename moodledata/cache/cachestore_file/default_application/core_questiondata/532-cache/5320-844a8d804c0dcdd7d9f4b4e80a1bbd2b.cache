O:8:"stdClass":26:{s:2:"id";s:4:"5320";s:8:"category";s:3:"314";s:6:"parent";s:1:"0";s:4:"name";s:85:"En cas de rapprochement de face, chaque appareil effectue un changement de direction:";s:12:"questiontext";s:85:"En cas de rapprochement de face, chaque appareil effectue un changement de direction:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:547:"Règles de priorité en vol :
- priorité à l'aéronef venant de la droite
- dépassement par la droite d'un autre aéronef
