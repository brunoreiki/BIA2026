O:8:"stdClass":26:{s:2:"id";s:4:"5325";s:8:"category";s:3:"314";s:6:"parent";s:1:"0";s:4:"name";s:14:"L'ATIS permet:";s:12:"questiontext";s:14:"L'ATIS permet:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:745:"<font color="blue">L'ATIS (de l'anglais Automatic Terminal Information Service)</font color="blue"> est un service automatique de diffusion. <b>Il permet aux pilotes de recevoir en continu des informations sur les aéroports les plus fréquentés.</b>
Les messages ATIS, mis à jour toutes les demi-heures, contiennent les informations essentielles, comme les données météorologiques, la ou les pistes en service, l'approche disponible et toute information nécessaire aux pilotes. Les pilotes écoutent généralement l'ATIS avant de contacter le contrôle, ce qui réduit la charge de travail des contrôleurs et diminue la durée d'occupation de la fréquence.<br><img src='https://bia-caea.fr/images/atis1.png' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241115093607+rdd8wj";s:11:"timecreated";s:10:"1731663367";s:12:"timemodified";s:10:"1731663367";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"5325";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"5320";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"314";s:4:"name";s:48:"Navigation, réglementation, sécurité des vols";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241115093607+TCkyD2";s:6:"parent";s:3:"310";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"5325";s:10:"questionid";s:4:"5325";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:19550;O:8:"stdClass":7:{s:2:"id";s:5:"19550";s:8:"question";s:4:"5325";s:6:"answer";s:62:"au contrôleur aérien de connaître la position de l'aéronef";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackf