O:8:"stdClass":26:{s:2:"id";s:4:"4231";s:8:"category";s:3:"263";s:6:"parent";s:1:"0";s:4:"name";s:65:"Sur la polaire représentée en figure 1, le point D représente:";s:12:"questiontext";s:146:"Sur la polaire représentée en figure 1, le point D représente:<br><img src='https://bia-caea.fr/images/a2_2016.gif' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:988:"Le rapport <font color="blue">Cz/Cx</font color="blue"> appelé rapport de finesse, est une mesure de l'efficacité d'un aéronef. Cz représente le coefficient de portance et Cx représente le coefficient de traînée.
Le <font color="blue">coefficient de portance (Cz)</font color="blue"> est une mesure de la capacité de l'aéronef à générer une force de portance, qui lui permet de rester en l'air.
<font color="blue">Le coefficient de traînée (Cx)</font color="blue"> est une mesure de la résistance de l'aéronef à l'écoulement de l'air qui freine son mouvement.
Le graphique est <font color="blue">une polaire</font color="blue"> qui indique pour chaque valeur de la traînée, la portance qui lui correspond.
Sur le graphique :
- "A" est le point de traînée minimum.
- "B" est le point de finesse max.
- Le point correspondant à la portance maximum "C".
- Au-delà du point "D", il n’y a plus de portance, l’aéronef ne vole plus. "D" est le point de décrochage.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241115093556+b4BwHs";s:11:"timecreated";s:10:"1731663356";s:12:"timemodified";s:10:"1731663356";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"801";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"4231";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"4226";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"263";s:4:"name";s:49:"Aérodynamique, aérostatique et principes du vol";s:9:"contextid";s:3:"801";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241115093555+lMaEpd";s:6:"parent";s:3:"261";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"4231";s:10:"questionid";s:4:"4231";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:15174;O:8:"stdClass":7:{s:2:"id";s:5:"15174";s:8:"question";s:4:"4231";s:6:"answer";s:21:"la traînée minimale";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:15175;O:8:"stdClass":7:{s:2:"id";s:5:"15175";s:8:"question";s:4:"4231";s:6:"answer";s:19:"la finesse maximale";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:15176;O:8:"stdClass":7:{s:2:"id";s:5:"15176";s:8:"question";s:4:"4231";s:6:"answer";s:20:"la portance maximale";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:""