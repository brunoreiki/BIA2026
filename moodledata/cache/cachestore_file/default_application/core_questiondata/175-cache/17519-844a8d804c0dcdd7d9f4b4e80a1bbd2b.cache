O:8:"stdClass":26:{s:2:"id";s:5:"17519";s:8:"category";s:4:"1402";s:6:"parent";s:1:"0";s:4:"name";s:58:"Le rotor anticouple des hélicoptères est contrôlé par:";s:12:"questiontext";s:58:"Le rotor anticouple des hélicoptères est contrôlé par:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:720:"Sans rotor de queue, un hélicoptère pivoterait sur lui-même dans le sens contraire du rotor principal. C'est pour compenser cette force de rotation que la plupart des hélicoptères sont équipés d'un rotor anti-couple aussi appelé d'un rotor de queue. Le palonnier contrôle la direction vers laquelle l’hélicoptère se dirige en modifiant l'angle d’incidence de ses pales pour contrecarrer l'effet de couple.
En appuyant sur la pédale de droite, le pilote fait pivoter le nez de l’hélicoptère vers la droite et en appuyant sur la pédale de gauche, le nez de l’hélicoptère pivote vers la gauche.<br><img width="100%" src='https://bia-caea.fr/images/rotor anti couple.jpg' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+250513070313+uucTet";s:11:"timecreated";s:10:"1747119793";s:12:"timemodified";s:10:"1747119793";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"800";s:6:"status";s:5:"ready";s:9:"versionid";s:5:"17519";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:5:"17478";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:4:"1402";s:4:"name";s:43:"Étude des aéronefs et des engins spatiaux";s:9:"contextid";s:3:"800";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+250513070313+cZa5jY";s:6:"parent";s:4:"1399";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:5:"17512";s:10:"questionid";s:5:"17519";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:68282;O:8:"stdClass":7:{s:2:"id";s:5:"68282";s:8:"question";s:5:"17519";s:6:"answer";s:14:"les palonniers";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:68283;O:8:"stdClass":7:{s:2:"id";s:5:"68283";s:8:"question";s:5:"17519";s:6:"answer";s:26:"le levier du pas collectif";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1: