O:8:"stdClass":26:{s:2:"id";s:5:"17501";s:8:"category";s:4:"1401";s:6:"parent";s:1:"0";s:4:"name";s:261:"Sous son ballon à air chaud, l'aérostier (le pilote) après son décollage, constate au GPS qu'à 200 m, le vent est du Nord pour 10 kt. Il l'annonce par radio à son coéquipier au sol pour venir le récupérer. Puis, ils perdent le contact radio. Après ...";s:12:"questiontext";s:318:"Sous son ballon à air chaud, l'aérostier (le pilote) après son décollage, constate au GPS qu'à 200 m, le vent est du Nord pour 10 kt. Il l'annonce par radio à son coéquipier au sol pour venir le récupérer. Puis, ils perdent le contact radio. Après un vol prévu de 90 min, où ce dernier va-t-il le chercher?";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:259:"Le déplacement latéral d'une montgolfière ne dépend que du vent dans la zone où elle se situe. Ici, le vent vient du Nord à une vitesse de 10 kt soit environ 20 km/h. En 90 mn soit une 1,5 heure, le ballon va donc parcourir 30 km. Calcul: 20 x 1,5 = 30.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+250513070312+s8tl94";s:11:"timecreated";s:10:"1747119792";s:12:"timemodified";s:10:"1747119792";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"800";s:6:"status";s:5:"ready";s:9:"versionid";s:5:"17501";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:5:"17460";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:4:"1401";s:4:"name";s:49:"Aérodynamique, aérostatique et principes du vol";s:9:"contextid";s:3:"800";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+250513070312+NXXEgr";s:6:"parent";s:4:"1399";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:5:"17494";s:10:"questionid";s:5:"17501";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correc