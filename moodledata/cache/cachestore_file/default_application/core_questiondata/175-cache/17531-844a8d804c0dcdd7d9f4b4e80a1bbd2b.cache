O:8:"stdClass":26:{s:2:"id";s:5:"17531";s:8:"category";s:4:"1402";s:6:"parent";s:1:"0";s:4:"name";s:67:"La présence d'un réchauffage de carburateur est nécessaire pour:";s:12:"questiontext";s:67:"La présence d'un réchauffage de carburateur est nécessaire pour:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:970:"À la sortie du venturi, juste en avant du papillon des gaz, se produit un brutal refroidissement de l’air, dû à la combinaison de la détente de l’air, et de la chute de température consécutive à la vaporisation du carburant. L’abaissement de la température peut atteindre moins 30° C, et l'eau contenue dans le mélange air-carburant peut rapidement se transformer en givre et/ou en glace, et se déposer en périphérie du venturi et sur le papillon des gaz. Ce phénomène en obturant le venturi entraîne une perte de puissance et même l'arrêt du moteur.
La plupart des avions sont donc équipés de réchauffage carburateur pour aider à parer cette menace. Un dispositif admet de l'air réchauffé par circulation autour du collecteur d'échappement. Un papillon actionné par une manette dirige alors le flux d'air chaud vers le carburateur.<br><img width="100%" src='https://bia-caea.fr/images/Carburateur-Rechauf.png' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+250513070313+iNkBh4";s:11:"timecreated";s:10:"1747119793";s:12:"timemodified";s:10:"1747119793";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"800";s:6:"status";s:5:"ready";s:9:"versionid";s:5:"17531";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:5:"17490";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:4:"1402";s:4:"name";s:43:"Étude des aéronefs et des engins spatiaux";s:9:"contextid";s:3:"800";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+250513070313+cZa5jY";s:6:"parent";s:4:"1399";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:5:"17524";s:10:"questionid";s:5:"17531";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:68330;O:8:"stdClass":7:{s:2:"id";s:5:"68330";s:8:"question";s:5:"17531";s:6:"answer";s:38:"améliorer son fonctionnement à froid";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:68331;O:8:"stdClass":7:{s:2:"id";s:5:"68331";s:8:"question";s:5:"17531";s:6:"answer";s:47:"palier à la formation de glace dans le venturi";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:68332;O:8:"stdClass":7:{s:2:"id";s:5:"68332";s:8:"question";s:5:"17531";s:6:"answer";s:91:"échauffer le mélange avant d'entrer dans les cylindres, et donc, améliorer sa combustion";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:68333;O:8:"stdClass":7:{s:2:"id";s:5:"68333";s:8:"question";s:5:"17531";s:6:"answer";s:19:"démarrer le moteur";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}