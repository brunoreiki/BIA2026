O:8:"stdClass":26:{s:2:"id";s:5:"17520";s:8:"category";s:4:"1402";s:6:"parent";s:1:"0";s:4:"name";s:18:"Une montgolfière:";s:12:"questiontext";s:18:"Une montgolfière:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:663:"Selon les principes de la poussée d’Archimède, un ballon rempli d'un gaz plus léger que l'air s'élève dans celui-ci. En effet, plus l'air est chaud, moins il est dense donc, plus il est léger (sa masse volumique est inférieure à celle de l'air environnant) et plus le ballon s'élève. Les frères Montgolfier en 1782, ont eu l'idée de chauffer l'air un ballon avec un brûleur et il s'est élevé dans l'air.
Remarques :
- Les engins volants plus légers que l'air sont des aérostats. Les plus lourds que l'air sont des aérodynes
- le mouvement horizontal d'un aérostat dépend entièrement de la direction et la force du vent, pas d'une gouverne.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+250513070313+3voQzr";s:11:"timecreated";s:10:"1747119793";s:12:"timemodified";s:10:"1747119793";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"800";s:6:"status";s:5:"ready";s:9:"versionid";s:5:"17520";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:5:"17479";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:4:"1402";s:4:"name";s:43:"Étude des aéronefs et des engins spatiaux";s:9:"contextid";s:3:"800";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+250513070313+cZa5jY";s:6:"parent";s:4:"1399";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:5:"17513";s:10:"questionid";s:5:"17520";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:68286;O:8:"stdClass":7:{s:2:"id";s:5:"68286";s:8:"question";s:5:"17520";s:6:"answer";s:99:"s'élève dans l'air car la masse volumique de l'air chaud est plus faible que celle de l'air froid";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:68287;O:8:"stdClass":7:{s:2:"id";s:5:"68287";s:8:"question";s:5:"17520";s:6:"answer";s:84:"perd de l'altitude lorsque la température de l'air situé dans l'enveloppe augmente";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:68288;O:8:"stdClass":7:{s:2: