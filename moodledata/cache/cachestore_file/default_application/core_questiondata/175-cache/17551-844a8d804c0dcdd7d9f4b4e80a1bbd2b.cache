O:8:"stdClass":26:{s:2:"id";s:5:"17551";s:8:"category";s:4:"1403";s:6:"parent";s:1:"0";s:4:"name";s:71:"La fédération française qui prend en charge l’aéromodélisme est:";s:12:"questiontext";s:71:"La fédération française qui prend en charge l’aéromodélisme est:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:1102:"<font color="blue">FFA : la Fédération Française Aéronautique</font color="blue"> fondée en 1929 est une association qui regroupe, en France, la grande majorité des aéro-clubs pour, entre autre, développer et faciliter la connaissance et le rayonnement de l'aéronautique

<font color="blue">FFAM : Fédération Française d'AéroModélisme</font color="blue"> a été fondée en 1966

<font color="blue">FFVL : La Fédération Française de Vol Libre</font color="blue"> est une association fondée en 1974. Elle gère six activités : le deltaplane, le parapente, le cerf-volant, le kite terrestre, le speed riding et le boomerang.

<font color="blue">FNAM : Fédération Nationale de l'Aviation et de ses Métiers</font color="blue">, créée en 1990, est la principale organisation professionnelle dans le transport aérien français. Elle représente plus de 370 entreprises, soit 95 % du secteur aérien dont 6 compagnies aériennes Françaises. Elle a pour but de promouvoir le dialogue social, l'emploi, la formation, la sécurité, la sûreté aérienne, le développement durable.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+250513070313+sR9N12";s:11:"timecreated";s:10:"1747119793";s:12:"timemodified";s:10:"1747119793";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"800";s:6:"status";s:5:"ready";s:9:"versionid";s:5:"17551";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:5:"17510";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:4:"1403";s:4:"name";s:48:"Navigation, réglementation, sécurité des vols";s:9:"contextid";s:3:"800";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+250513070313+Pl4K3S";s:6:"parent";s:4:"1399";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:5:"17544";s:10:"questionid";s:5:"17551";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:68410;O:8:"stdClass":7:{s:2:"id";s:5:"68410";s:8:"question";s:5:"17551";s:6:"answer";s:6:"la FFA";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:68411;O:8:"stdClass":7:{s:2:"id";s:5:"68411";s:8:"question";s:5:"17551