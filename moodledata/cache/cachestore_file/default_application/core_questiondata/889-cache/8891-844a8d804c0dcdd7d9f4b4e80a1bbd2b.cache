O:8:"stdClass":26:{s:2:"id";s:4:"8891";s:8:"category";s:3:"518";s:6:"parent";s:1:"0";s:4:"name";s:133:"Examiner les instruments de l’avion dont il est question dans cette partie. Quel instrument correspond à l’indicateur de virage:";s:12:"questiontext";s:221:"Examiner les instruments de l’avion dont il est question dans cette partie. Quel instrument correspond à l’indicateur de virage:<br><img src='https://bia-caea.fr/images/aeronef-2-2021.jpg' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:954:"D) <font color="blue">Indicateur de virage</font color="blue">: Cet instrument est utilisé pour indiquer si l'avion est en train de virer et, si oui, dans quelle direction. Il affiche une aiguille qui montre la direction et l'intensité du virage ainsi qu'une bille pour la symétrie du virage.
Pour compléter, voici une brève description des autres instruments:
A) <font color="blue">Horizon artificiel</font color="blue">: Il indique l'attitude de l'avion par rapport à l'horizon, montrant les inclinaisons en roulis et en tangage.
B) <font color="blue">ILS (Instrument Landing System)</font color="blue">: Utilisé pour l'approche et l'atterrissage aux instruments, il fournit des informations de guidage vertical et horizontal pour approcher une piste.
C) <font color="blue">Conservateur de cap</font color="blue">: Aussi connu comme gyrocompas, il indique la direction de l'avion par rapport au nord magnétique ou géographique.
<b>Marin D.</b>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143230+nuVu5Z";s:11:"timecreated";s:10:"1732113150";s:12:"timemodified";s:10:"1732113150";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8891";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8886";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"518";s:4:"name";s:43:"Étude des aéronefs et des engins spatiaux";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143230+v1BKF5";s:6:"parent";s:3:"515";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8891";s:10:"questionid";s:4:"8891";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:33814;O:8:"stdClass":7:{s:2:"id";s:5:"33814";s:8:"question";s:4:"8891";s:6:"answer";s:1:"A";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33815;O:8:"stdClass":7:{s:2:"id";s:5:"33815";s:8:"question";s:4:"8891";s:6:"answer";s:1:"B";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33816;O:8:"stdClass":7:{s:2:"id";s:5:"33816";s:8:"question";s:4:"8891";s:6:"answer";s:1:"C";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33817;O:8:"stdClass":7:{s:2:"id";s:5:"33817";s:8:"question";s:4:"8891";s:6:"answer";s:1:"D";s:12:"answerformat";s:1:"1";s