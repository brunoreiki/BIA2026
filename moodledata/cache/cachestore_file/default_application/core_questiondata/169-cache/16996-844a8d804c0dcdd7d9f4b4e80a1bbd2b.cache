O:8:"stdClass":26:{s:2:"id";s:5:"16996";s:8:"category";s:4:"1373";s:6:"parent";s:1:"0";s:4:"name";s:68:"Sur ce profil d’aile, l’intrados est représenté par la lettre:";s:12:"questiontext";s:162:"Sur ce profil d’aile, l’intrados est représenté par la lettre:<br><img width="100%" src='https://bia-caea.fr/images/a1_2016.gif' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:916:"<font color="blue">Bord d'attaque</font color="blue">: c'est la partie avant de l'aile, la première à rencontrer l'air lors du vol. Sur une vue en coupe, c'est le côté arrondi à l'extrémité avant de l'aile.
<font color="blue">Bord de fuite</font color="blue">: c'est l'arrière de l'aile, où l'air quitte l'aile. Sur une vue en coupe, c'est le côté arrière de l'aile qui peut être plus fin et pointu.
<font color="blue">Extrados</font color="blue">: c'est la partie supérieure de l'aile. Sur une vue en coupe, c'est la surface courbe située au-dessus de la ligne médiane de l'aile. Elle est souvent plus bombée que l'intrados.
<font color="blue">Intrados</font color="blue">: c'est la partie inférieure de l'aile. Sur une vue en coupe, c'est la surface située sous la ligne médiane de l'aile. Elle peut être relativement plate ou légèrement courbée vers le haut ou vers le bas.
<b>Marin D.</b>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+250513070305+vxKz3C";s:11:"timecreated";s:10:"1747119785";s:12:"timemodified";s:10:"1747119785";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"800";s:6:"status";s:5:"ready";s:9:"versionid";s:5:"16996";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:5:"16955";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:4:"1373";s:4:"name";s:49:"Aérodynamique, aérostatique et principes du vol";s:9:"contextid";s:3:"800";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+250513070305+Kl5zqW";s:6:"parent";s:4:"1371";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:5:"16989";s:10:"questionid";s:5:"16996";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:66190;O:8:"stdClass":7:{s:2:"id";s:5:"66190";s:8:"question";s:5:"16996";s:6:"answer";s:1:"A";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:66191;O:8:"stdClass":7:{s:2:"id";s:5:"66191";s:8:"question";s:5:"16996";s:6:"answer";s:1:"B";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:66192;O:8:"stdClass":7:{s:2:"id";s:5:"66192";s:8:"question";s:5:"16996";s:6:"answer";s:1:"C";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:66193;O:8:"stdClass":7:{s:2:"id";s:5:"66193";s:8:"question";s:5:"16996";s:6:"answer";s:1:"D";s:12:"answerf