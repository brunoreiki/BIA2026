O:8:"stdClass":26:{s:2:"id";s:4:"5111";s:8:"category";s:3:"305";s:6:"parent";s:1:"0";s:4:"name";s:45:"Le fuselage de l’avion est générateur de:";s:12:"questiontext";s:45:"Le fuselage de l’avion est générateur de:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:1099:"Le fuselage d'un avion contribue à la fois à la <font color="blue">traînée de forme</font color="blue"> et à la <font color="blue">traînée de frottement</font color="blue">.
La <font color="blue">traînée de forme</font color="blue">, également connue sous le nom de traînée de pression, est causée par l'air qui s'écoule autour du fuselage de l'avion. Lorsque l'air rencontre le fuselage, il est dévié autour de lui, ce qui crée une zone de basse pression à l'arrière de l'avion. Cette différence de pression entre l'avant et l'arrière de l'avion génère une force qui résiste au mouvement de l'avion.
La <font color="blue">traînée de frottement</font color="blue">, également connue sous le nom de traînée de viscosité, est causée par le frottement de l'air contre la surface du fuselage. Plus la surface de l'avion est rugueuse, plus la traînée de frottement est importante.
<i>Remarque : la <font color="blue">traînée induite</font color="blue"> est associée à la création de portance par les ailes de l'avion, et non au fuselage.</i>
<b>Marin Descarrega</b>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241115093605+aBBSSs";s:11:"timecreated";s:10:"1731663365";s:12:"timemodified";s:10:"1731663365";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"801";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"5111";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"5106";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"305";s:4:"name";s:49:"Aérodynamique, aérostatique et principes du vol";s:9:"contextid";s:3:"801";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241115093605+vL9zEA";s:6:"parent";s:3:"303";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"5111";s:10:"questionid";s:4:"5111";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:18694;O:8:"stdClass":7:{s:2:"id";s:5:"18694";s:8:"question";s:4:"5111";s:6:"answer";s:46:"traînée de forme et traînée de frottements";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:18695;O:8:"stdClass":7:{s:2:"id";s:5:"18695";s:8:"question";s:4:"5111";s:6:"answer";s:35:"traînée de frottements uniquement";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:18696;O:8:"stdClass":7:{s:2:"id";s:5:"18696";s:8:"question";s:4:"5111";s:6:"answer";s:28:"traînée induite uniquement";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:18697;