O:8:"stdClass":26:{s:2:"id";s:4:"5253";s:8:"category";s:3:"312";s:6:"parent";s:1:"0";s:4:"name";s:134:"En observant du sol le lancement d'une fusée de Cap Kennedy (Floride), on constate que la trajectoire s'incurve vers l'Est. Pourquoi?";s:12:"questiontext";s:134:"En observant du sol le lancement d'une fusée de Cap Kennedy (Floride), on constate que la trajectoire s'incurve vers l'Est. Pourquoi?";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:653:"La Terre tourne d'Ouest en Est sur son axe, de gauche à droite sur le schéma.
Lorsqu'une fusée est lancée vers l'est (dans la direction de la rotation de la Terre), elle bénéficie de la vitesse de rotation de la planète. Plus le lancement est proche de l’équateur, plus la fusée est déjà en mouvement avec la vitesse de rotation terrestre. Cette vitesse initiale permet à la fusée d'atteindre plus facilement, plus rapidement et avec moins de carburant la vitesse requise pour se placer en orbite autour de la Terre ou pour entamer un voyage spatial.<br><img src='https://bia-caea.fr/images/rotation terre.jpg' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241115093606+jLJs02";s:11:"timecreated";s:10:"1731663366";s:12:"timemodified";s:10:"1731663366";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"5253";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"5248";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"312";s:4:"name";s:49:"Aérodynamique, aérostatique et principes du vol";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241115093606+wR1L4a";s:6:"parent";s:3:"310";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"5253";s:10:"questionid";s:4:"5253";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:19262;O:8:"stdClass":7:{s:2:"id";s:5:"19262";s:8:"question";s:4:"5253";s:6:"answer";s:79:"C'est une illusion d'optique due à la température des gaz des moteurs fusées";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:19263;O:8:"stdClass":7:{s:2:"id";s:5:"19263";s:8:"question";s:4:"5253";s:6:"answer";s:117:"On bénéficie ainsi de la vitesse de rotation de la Terre d'Ouest en Est pour atteindre la vitesse de mise en orbite";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:19264;O:8:"stdClass":7:{s:2:"id";s:5:"19264";s:8:"question";s:4:"5253";s:6:"answer";s:115:"C'est pour la sécurité en cas d'incident au décollage. Les débris du lanceur retombent dans l'océan Atlantique";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:19265;O:8:"stdClass":7:{s:2:"id";s:5:"19265";s:8:"question";s:4:"5253";s:6:"answer";s:62:"On préserve ainsi la couche d'ozone au-dessus des États-Unis";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}