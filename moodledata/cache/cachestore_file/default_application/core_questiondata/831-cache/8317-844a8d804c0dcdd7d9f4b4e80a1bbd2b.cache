O:8:"stdClass":26:{s:2:"id";s:4:"8317";s:8:"category";s:3:"490";s:6:"parent";s:1:"0";s:4:"name";s:96:"Le nid d’abeille que l’on rencontre dans les structures composites peut être constitué de:";s:12:"questiontext";s:96:"Le nid d’abeille que l’on rencontre dans les structures composites peut être constitué de:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:802:"Question annulée car trop imprécise. En effet, un panneau "sandwich" composite est composé de deux peaux entourant une âme. Les peaux sont des plaques de composites (fibre + résine). les fibres peuvent être en verre, carbone, kévlar ou autre, la résine peut être époxy, polyestère, ou autre. L'âme peut être une mousse, du bois léger (balsa), ou un nid d'abeille (en carton enduit, papier aramide enduit (nida-nomex) plastique PP ou aluminium).
La question concerne-t-elle toute la structure composite, l'âme, le nid d'abeille seul...?
Si la question concerne le composite: la réponse a peut être valable,
si la question concerne l'âme: la réponse c est la plus judicieuse,
si la question concerne uniquement le nid d'abeille,<font color="red"> aucune réponse n'est correcte!</font>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143225+HAt2xz";s:11:"timecreated";s:10:"1732113145";s:12:"timemodified";s:10:"1732113145";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"804";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8317";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8312";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"490";s:4:"name";s:43:"Étude des aéronefs et des engins spatiaux";s:9:"contextid";s:3:"804";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143225+MFrNeg";s:6:"parent";s:3:"487";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8317";s:10:"questionid";s:4:"8317";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:31518;O:8:"stdClass":7:{s:2:"id";s:5:"31518";s:8:"question";s:4:"8317";s:6:"answer";s:25:"fibre de verre et résine";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:31519;O:8:"stdClass":7:{s:2:"id";s:5:"31519";s:8:"question";s:4:"8317";s:6:"answer";s:23:"polyéthylène et acier";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:31520;O:8:"stdClass":7:{s:2:"id";s:5:"31520";s:8:"question";s:4:"8317";s:6:"answer";s:31:"bois aéronautique et aluminium";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"fee