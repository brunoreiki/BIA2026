O:8:"stdClass":26:{s:2:"id";s:4:"8925";s:8:"category";s:3:"519";s:6:"parent";s:1:"0";s:4:"name";s:20:"L’hypoxie est due:";s:12:"questiontext";s:20:"L’hypoxie est due:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:585:"<font color="blue">L'hypoxie est un phénomène qui survient lorsque le corps ou une région du corps ne reçoit pas suffisamment d'oxygène.</font color="blue"> En aviation, l'hypoxie peut être un risque à haute altitude où la pression partielle d'oxygène dans l'air ambiant est trop basse pour maintenir une saturation en oxygène normale dans le sang.
Pour le pilote, les conséquences de l'hypoxie sont une dégradation de ses capacités intellectuelles (défaut de jugement, mauvaise appréciation de la situation, perte de vigilance…) et un risque de perte de connaissance.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143231+QGlnH6";s:11:"timecreated";s:10:"1732113151";s:12:"timemodified";s:10:"1732113151";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8925";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8920";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"519";s:4:"name";s:48:"Navigation, réglementation, sécurité des vols";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143231+nXpM4x";s:6:"parent";s:3:"515";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8925";s:10:"questionid";s:4:"8925";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:33950;O:8:"stdClass":7:{s:2:"id";s:5:"33950";s:8:"question";s:4:"8925";s:6:"answer";s:40:"à une trop forte quantité d’oxygène";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33951;O:8:"stdClass":7:{s:2:"id";s:5:"33951";s:8:"question";s:4:"8925";s:6:"answer";s:41:"à une trop faible quantité d’oxygène";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33952;O:8:"stdClass":7:{s:2:"id";s:5