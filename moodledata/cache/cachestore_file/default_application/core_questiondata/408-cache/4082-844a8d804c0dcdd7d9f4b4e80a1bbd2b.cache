O:8:"stdClass":26:{s:2:"id";s:4:"4082";s:8:"category";s:3:"256";s:6:"parent";s:1:"0";s:4:"name";s:96:"Les dispositifs hypersustentateurs, utilisés par exemple sur les avions de ligne, ont pour but:";s:12:"questiontext";s:96:"Les dispositifs hypersustentateurs, utilisés par exemple sur les avions de ligne, ont pour but:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:1094:"<font color="blue">Le braquage des volets hypersustentateurs de bord de fuite</font color="blue"> sur les ailes d'un avion <font color="blue">augmente le coefficient de portance (Cz)</font color="blue">, ce qui permet à l'avion de voler à des vitesses plus basses et à des incidences plus fortes sans risque de décrochage, comme lors du décollage et de l'atterrissage. Cependant, cette augmentation de la portance s'accompagne également d'une <font color="blue">augmentation du coefficient de traînée (Cx)</font color="blue">, ce qui signifie que l'avion subit plus de résistance à son avancement dans l'air. <font color="blue">Sa finesse diminue</font color="blue">, car le coefficient de traînée (Cx) augmente plus que le coefficient de portance (Cz). En descente, <font color="blue">il lui devient possible de prendre une pente plus forte</font color="blue">. Enfin, la sortie des volets modifie le profil de l'aile et crée <font color="blue">un couple piqueur</font color="blue">.
<b>Marin D.</b><br><img src='https://bia-caea.fr/images/volet01.png' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241115093554+eCnnjy";s:11:"timecreated";s:10:"1731663354";s:12:"timemodified";s:10:"1731663354";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"801";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"4082";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"4077";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"256";s:4:"name";s:49:"Aérodynamique, aérostatique et principes du vol";s:9:"contextid";s:3:"801";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241115093554+48ZHV5";s:6:"parent";s:3:"254";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"4082";s:10:"questionid";s:4:"4082";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:14578;O:8:"stdClass":7:{s:2:"id";s:5:"14578";s:8:"question";s:4:"4082";s:6:"answer";s:87:"de diminuer la portance à vitesse élevée (par exemple : pour une descente d'urgence)";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:14579;O:8:"stdClass":7:{s:2:"id";s:5:"14579";s:8:"question";s:4:"4082";s:6:"answer";s:63:"d'augmenter la vitesse de décrochage pour certaines manoeuvres";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:14580;O:8:"stdClass":7:{s:2:"id";s:5:"14580";s:8:"question";s:4:"4082";s:6:"answer";s:50:"de diminuer la traînée pour certaines manoeuvres";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:14581;O:8:"stdClass":7:{s:2:"id";s:5:"14581";s:8:"question";s:4:"4082";s:6:"answer";s:117:"de diminuer la vitesse de décrochage dans certaines phases de vol (par exemple : au décollage et à l'atterrissage)";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}