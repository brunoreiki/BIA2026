O:8:"stdClass":26:{s:2:"id";s:4:"8796";s:8:"category";s:3:"513";s:6:"parent";s:1:"0";s:4:"name";s:106:"L'Aéropostale fut à l'origine de la création d'une grande compagnie aérienne en 1933, elle s'appelait:";s:12:"questiontext";s:106:"L'Aéropostale fut à l'origine de la création d'une grande compagnie aérienne en 1933, elle s'appelait:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:556:"À la suite de difficultés financières, la <font color="blue">Compagnie Générale Aéropostale</font color="blue"> est mise en liquidation judiciaire en 1931 et ses actifs sont repris par l'État français en 1933. <font color="blue">Le 30 août 1933 est fondée Air France.</font color="blue"> C'est la compagnie aérienne nationale française dont les activités principales sont le transport de passagers, de fret ainsi que la maintenance et l'entretien des avions.<br><img src='https://bia-caea.fr/images/airfrance01.jpg' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143229+MNVxyo";s:11:"timecreated";s:10:"1732113149";s:12:"timemodified";s:10:"1732113149";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8796";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8791";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"513";s:4:"name";s:54:"Histoire et culture de l’aéronautique et du spatial";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143229+oYmjEi";s:6:"parent";s:3:"508";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8796";s:10:"questionid";s:4:"8796";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:3