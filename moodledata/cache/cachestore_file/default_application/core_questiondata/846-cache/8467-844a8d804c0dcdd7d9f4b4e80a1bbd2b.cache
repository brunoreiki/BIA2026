O:8:"stdClass":26:{s:2:"id";s:4:"8467";s:8:"category";s:3:"498";s:6:"parent";s:1:"0";s:4:"name";s:230:"Pour commencer la préparation de votre navigation et après avoir identifié sur le document D1 le point central des aérodromes de départ et d'arrivée, calculer la distance réelle séparant ces deux aérodromes, vous obtenez:";s:12:"questiontext";s:230:"Pour commencer la préparation de votre navigation et après avoir identifié sur le document D1 le point central des aérodromes de départ et d'arrivée, calculer la distance réelle séparant ces deux aérodromes, vous obtenez:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:517:"Sur la carte, le rapport des mesures entre d’une part les aérodromes de départ et d’arrivée et d’autre part la distance correspondant à 1 cm sur l’échelle donne 9,3. Or, 1 cm sur une carte au 1/500 000 correspond à 500 000 cm soit 5 km sur le terrain. Donc 9,3 cm sur la carte correspond à: <font color="blue">(9,3 x 5)/1 = 46,5 km</font> sur le terrain. La réponse la plus approchante (on ne tombe pas exactement sur le résultat à cause des erreurs de mesure) étant la "b".
<b>Godefroy Reynaud</b>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143226+eI4TTR";s:11:"timecreated";s:10:"1732113146";s:12:"timemodified";s:10:"1732113146";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8467";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8462";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"498";s:4:"name";s:48:"Navigation, réglementation, sécurité des vols";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143226+sekjcP";s:6:"parent";s:3:"494";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8467";s:10:"questionid";s:4:"8467";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:32118;O:8:"stdClass":7:{s:2:"id";s:5:"32118";s:8:"question";s:4:"8467";s:6:"answer";s:5:"93 km";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:32119;O:8:"stdClass":7:{s:2:"id";s:5:"32119";s:8:"question";s:4:"8467";s:6:"answer";s:5:"46 km";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:32120;O:8:"stdClass":7:{s:2:"id";s:5:"32120";s:8:"question";s:4:"8467";s:6:"answer";s:6:"9,3 km";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:32121;O:8:"stdClass":7:{s:2:"id";s:5:"32121";s:8:"question";s:4:"8467";s:6:"answer";s:5:"46 NM";