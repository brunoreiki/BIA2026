O:8:"stdClass":26:{s:2:"id";s:4:"8868";s:8:"category";s:3:"517";s:6:"parent";s:1:"0";s:4:"name";s:31:"Un parachutiste en chute libre:";s:12:"questiontext";s:31:"Un parachutiste en chute libre:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:1014:"Lors d'une chute libre, la vitesse de chute augmente puis se stabilise à une vitesse dite vitesse limite. Cette vitesse limite est atteinte lorsque la force de traînée aérodynamique du parachutiste équilibre exactement la force gravitationnelle le tirant vers le bas. En position horizontale, ou à plat ventre, la surface exposée à l'air est plus grande, ce qui augmente la traînée et permet d'atteindre la vitesse limite plus rapidement que dans une position verticale, où la surface exposée est moindre (la vitesse limite en position verticale est très supérieure à celle de la position horizontale).
Les autres options ne sont pas tout à fait correctes:
A) ne prend pas en compte la vitesse limite,
B) est inexacte car, la position verticale permet d'atteindre une vitesse limite plus élevée que la position horizontale,
D) est incorrecte car, une fois la vitesse limite atteinte, elle ne diminue pas sauf si la position ou la résistance aérodynamique du parachutiste change.
<b>Marin D.</b>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143230+oWCVxD";s:11:"timecreated";s:10:"1732113150";s:12:"timemodified";s:10:"1732113150";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8868";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8863";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"517";s:4:"name";s:49:"Aérodynamique, aérostatique et principes du vol";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143230+hz2NrD";s:6:"parent";s:3:"515";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8868";s:10:"questionid";s:4:"8868";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:33722;O:8:"stdClass":7:{s:2:"id";s:5:"33722";s:8:"question";s:4:"8868";s:6:"answer";s:94:"ira de plus en plus vite quelle que soit sa position pendant toute la durée de la chute libre";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33723;O:8:"stdClass":7:{s:2:"id";s:5:"33723";s:8:"question";s:4:"8868";s:6:"answer";s:72:"atteindra une vitesse limite très tôt s’il est en position verticale";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33724;O:8:"stdClass":7:{s:2:"id";s:5:"33724";s:8:"question";s:4:"8868";s:6:"answer";s:91:"atteindra une vitesse limite très tôt s’il est en position horizontale (à plat ventre)";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33725;O:8:"stdClass":7:{s:2:"id";s:5:"33725";s:8:"question";s:4:"8868";s:6:"answer";s:68:"verra sa vitesse augmenter puis diminuer quelle que soit sa position";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}