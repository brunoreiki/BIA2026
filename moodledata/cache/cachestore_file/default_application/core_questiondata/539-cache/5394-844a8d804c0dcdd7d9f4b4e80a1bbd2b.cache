O:8:"stdClass":26:{s:2:"id";s:4:"5394";s:8:"category";s:3:"318";s:6:"parent";s:1:"0";s:4:"name";s:168:"Le ciel est clair, la température au sol est de +4° C. La prévision météorologique indique que le point de rosée sera à +2° C dans 30 minutes, vous en concluez:";s:12:"questiontext";s:168:"Le ciel est clair, la température au sol est de +4° C. La prévision météorologique indique que le point de rosée sera à +2° C dans 30 minutes, vous en concluez:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:1319:"La température de l'air est 2° supérieure à celle du point de rosée. Cela signifie que l'air est proche de la saturation en eau. Or, une forte humidité de l'air combinée à une température basse sont les conditions propices au givrage du carburateur. Dans le carburateur, à la sortie du venturi, juste en avant du papillon des gaz, se produit un brutal refroidissement de l’air, dû à la combinaison de la détente de l’air, et de la chute de température consécutive à la vaporisation du carburant. L’abaissement de la température peut atteindre moins 30°C, et l'eau contenue dans le mélange air-carburant peut rapidement se transformer en givre et/ou en glace, et se déposer en périphérie du venturi et sur le papillon des gaz. Ce phénomène en obturant le venturi entraîne une perte de puissance et même l'arrêt du moteur.
<font color="blue">Le givrage carburateur peut se produire dès une température de 30°C avec une humidité relative de seulement 50 %. Les conditions idéales de givrage sont une température extérieure comprise entre +5°C et 21°C et une humidité relative de 80 % ou plus. La possibilité de givrage diminue à partir de 0°C.</font color="blue">
<b>Source : l'Avionnaire.</b><br><img src='https://bia-caea.fr/images/givre02.png' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241115093608+cctxoy";s:11:"timecreated";s:10:"1731663368";s:12:"timemodified";s:10:"1731663368";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"5394";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"5389";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"318";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241115093607+1Ixc6W";s:6:"parent";s:3:"317";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"5394";s:10:"questionid";s:4:"5394";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:19826;O:8:"stdClass":7:{s:2:"id";s:5:"19826";s:8:"question";s:4:"5394";s:6:"answer";s:78:"qu'en vol, il faudra être très attentif au givrage du carburateur de l'avion";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:19827;O:8:"stdClass":7:{s:2:"id";s:5:"19827";s:8:"question";s:4:"5394";s:6:"answer";s:30:"que du brouillard va se former";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:19828;O:8:"stdClass":7:{s:2:"id";s:5:"19828";s:8:"question";s:4:"5394";s:6:"answer";s:34:"que la visibilité va rester bonne";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:19829;O:8:"stdClass":7:{s:2:"id";s:5:"19829";s:8:"question";s:4:"5394";s:6:"answer";s:50:"que la température de la rosée au sol va baisser";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}