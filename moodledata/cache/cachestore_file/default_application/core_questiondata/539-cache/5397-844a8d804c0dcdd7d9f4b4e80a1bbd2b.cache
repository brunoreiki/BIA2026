s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:19841;O:8:"stdClass":7:{s:2:"id";s:5:"19841";s:8:"question";s:4:"5397";s:6:"answer";s:29:"le facteur de charge augmente";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}