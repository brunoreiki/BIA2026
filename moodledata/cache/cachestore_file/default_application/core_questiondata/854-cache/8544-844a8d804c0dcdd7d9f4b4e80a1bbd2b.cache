O:8:"stdClass":26:{s:2:"id";s:4:"8544";s:8:"category";s:3:"502";s:6:"parent";s:1:"0";s:4:"name";s:97:"D’une manière générale, lorsque le ballon sonde poursuit son ascension dans la troposphère:";s:12:"questiontext";s:97:"D’une manière générale, lorsque le ballon sonde poursuit son ascension dans la troposphère:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:583:"<font color="blue">En atmosphère standard</font color="blue">, au niveau de la mer, <font color="blue">la température</font color="blue"> est de 15°C et elle <font color="blue">baisse de 2°C tous les mille ft</font color="blue">. D’autre part, <font color="blue">la baisse de pression est de 1hPa pour 28 ft</font color="blue">. <font color="blue">La densité de l'air</font color="blue"> (sa masse volumique) est de 1,22kg.m-3 au niveau de la mer et est directement liée à la pression : <font color="blue">lorsque la pression baisse, la densité baisse.</font color="blue">";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143227+b7uwYS";s:11:"timecreated";s:10:"1732113147";s:12:"timemodified";s:10:"1732113147";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8544";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8539";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"502";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143227+vkuTWX";s:6:"parent";s:3:"501";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8544";s:10:"questionid";s:4:"8544";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfe