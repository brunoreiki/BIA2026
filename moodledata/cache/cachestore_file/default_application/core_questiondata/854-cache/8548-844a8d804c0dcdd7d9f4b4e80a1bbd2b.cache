O:8:"stdClass":26:{s:2:"id";s:4:"8548";s:8:"category";s:3:"502";s:6:"parent";s:1:"0";s:4:"name";s:100:"La température et le point de rosée fournis par l’ATIS permettent au pilote d’en conclure que:";s:12:"questiontext";s:100:"La température et le point de rosée fournis par l’ATIS permettent au pilote d’en conclure que:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:482:"Qu'est ce que la température du point de rosée?
C'est la température sous laquelle la vapeur d'eau se condense en eau liquide sur des surfaces solides comme des brins d'herbe ou autour de particules solides dans l'atmosphère comme de la poussière. Ce phénomène peut se produire au cours du refroidissement nocturne ou au petit matin et provoquer de la rosée ou des brouillards. La température du point de rosée est variable et dépend de la pression et de l'hygrométrie.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143227+6ErETR";s:11:"timecreated";s:10:"1732113147";s:12:"timemodified";s:10:"1732113147";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8548";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8543";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"502";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143227+vkuTWX";s:6:"parent";s:3:"501";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8548";s:10:"questionid";s:4:"8548";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:32442;O:8:"stdClass":7:{s:2:"id";s:5:"32442";s:8:"question";s:4:"8548";s:6:"answer";s:76:"l’air est sec car la température et le point de rosée sont très proches";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:32443;O:8:"stdClass":7:{s:2:"id";s:5:"32443";s: