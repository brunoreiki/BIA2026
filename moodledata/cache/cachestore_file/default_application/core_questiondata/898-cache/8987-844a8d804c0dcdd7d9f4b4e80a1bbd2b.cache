O:8:"stdClass":26:{s:2:"id";s:4:"8987";s:8:"category";s:3:"523";s:6:"parent";s:1:"0";s:4:"name";s:111:"En plaine, les vélivoles profitent d'un phénomène météorologique pour gagner de l'altitude. Il s'agit des:";s:12:"questiontext";s:111:"En plaine, les vélivoles profitent d'un phénomène météorologique pour gagner de l'altitude. Il s'agit des:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:723:"Lorsque l’atmosphère est instable, des bulles d’air chauffées par le sol, lui-même chauffé par le soleil, s’élèvent en se dilatant et se refroidissant jusqu’à ce que leur température soit la même que celle de l’air les environnant. Ces bulles sont des ascendances thermiques utilisées par les oiseaux, planeurs, deltaplanes et parapente pour monter en l’altitude.
Si la montée des bulles s’arrête avant qu’il y ait saturation de l’eau qu’elles contiennent, il n’y a pas d’apparition de nuage. Si la montée continue bien au-delà de la saturation de l’eau, il y a un risque d’apparition d’orages.<br><img src='https://bia-caea.fr/images/meteo2022_2.png' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143231+hQQctM";s:11:"timecreated";s:10:"1732113151";s:12:"timemodified";s:10:"1732113151";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8987";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8982";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"523";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143231+LlVDIj";s:6:"parent";s:3:"522";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8987";s:10:"questionid";s:4:"8987";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:34198;O:8:"stdClass":7:{s:2:"id";s:5:"34198";s:8:"question";s:4:"8987";s:6:"answer";s:17:"brises de vallée";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34199;O:8:"stdClass":7:{s:2:"id";s:5:"34199";s:8:"question";s:4:"8987";s:6:"answer";s:11:"ascendances";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:3420