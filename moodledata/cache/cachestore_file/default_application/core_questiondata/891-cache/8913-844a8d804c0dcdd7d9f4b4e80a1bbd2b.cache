O:8:"stdClass":26:{s:2:"id";s:4:"8913";s:8:"category";s:3:"519";s:6:"parent";s:1:"0";s:4:"name";s:142:"Le contrôleur transmet le QNH de 1000 hPa par radio aux deux pilotes qui règlent leurs altimètres à cette valeur. Ceux-ci affichent alors:";s:12:"questiontext";s:226:"Le contrôleur transmet le QNH de 1000 hPa par radio aux deux pilotes qui règlent leurs altimètres à cette valeur. Ceux-ci affichent alors:<br><img src='https://bia-caea.fr/images/nav-1-2021.jpg' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:681:"Il faut comprendre que l'altitude indiquée par un altimètre varie en fonction du calage altimétrique (pression atmosphérique au niveau de la mer dans les conditions standard). Si deux avions volent avec des calages altimétriques différents, leurs altitudes indiquées peuvent être trompeuses lorsqu'on les compare directement. La loi de diminution de la pression avec l'altitude est de 1 hPa tous les 28 ft.
On ne touche pas au 1er altimètre car il est déjà calé à 1000 hPa. Par contre, on retranche 280 ft (10 hPa) au second, ce qui donne 1020 ft que l’on va arrondir à 1000 ft. Les 2 appareils volent donc quasiment à la même altitude de 1000 ft.
<b>Marin D.</b>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143231+rK38OU";s:11:"timecreated";s:10:"1732113151";s:12:"timemodified";s:10:"1732113151";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8913";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8908";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"519";s:4:"name";s:48:"Navigation, réglementation, sécurité des vols";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143231+nXpM4x";s:6:"parent";s:3:"515";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8913";s:10:"questionid";s:4:"8913";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:33902;O:8:"stdClass":7:{s:2:"id";s:5:"33902";s:8:"question";s:4:"8913";s:6:"answer";s:14:"1300 ft chacun";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33903;O:8:"stdClass":7:{s:2:"id";s:5:"33903";s:8:"question";s:4:"8913";s:6:"answer";s:14:"1000 ft chacun";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33904;O:8:"stdClass":7:{s:2:"id";s:5:"33904";s:8:"question";s:4:"8913";s:6:"answer";s:49:"altimètre 1 : 1300 ft – Altimètre 2 : 1000 ft";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33905;O:8:"stdClass":7:{s:2:"id";s:5:"33905"