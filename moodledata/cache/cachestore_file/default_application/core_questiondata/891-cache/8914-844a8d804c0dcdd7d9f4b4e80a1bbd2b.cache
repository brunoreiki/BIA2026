O:8:"stdClass":26:{s:2:"id";s:4:"8914";s:8:"category";s:3:"519";s:6:"parent";s:1:"0";s:4:"name";s:112:"Compte tenu des règles de priorité, quelle manœuvre doivent réaliser chaque pilote pour éviter un accident:";s:12:"questiontext";s:196:"Compte tenu des règles de priorité, quelle manœuvre doivent réaliser chaque pilote pour éviter un accident:<br><img src='https://bia-caea.fr/images/nav-1-2021.jpg' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:547:"Règles de priorité en vol :
- priorité à l'aéronef venant de la droite
- dépassement par la droite d'un autre aéronef
- à la même altitude et face à face l'évitement se fait par un dégagement des 2 appareils par la droite.
- priorité à l'aéronef le plus bas
- priorité à l'aéronef le moins manœuvrant. Dans l'ordre : les ballons, les planeurs, les dirigeables, les avions remorquant, les avions en formation, les avions seuls.<br><img src='https://bia-caea.fr/images/evitement1.png' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143231+YjUBkB";s:11:"timecreated";s:10:"1732113151";s:12:"timemodified";s:10:"1732113151";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8914";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8909";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"519";s:4:"name";s:48:"Navigation, réglementation, sécurité des vols";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143231+nXpM4x";s:6:"parent";s:3:"515";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8914";s:10:"questionid";s:4:"8914";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:33906;O:8:"stdClass":7:{s:2:"id";s:5:"33906";s:8:"question";s:4:"8914";s:6:"answer";s:21:"chacun vire à gauche";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33907;O:8:"stdClass":7:{s:2:"id";s:5:"33907";s:8:"question";s:4:"8914";s:6:"answer";s:21:"chacun vire à droite";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33908;O:8:"stdClass":7:{s:2:"id