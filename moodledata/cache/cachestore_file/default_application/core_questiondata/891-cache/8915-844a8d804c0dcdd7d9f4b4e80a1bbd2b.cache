O:8:"stdClass":26:{s:2:"id";s:4:"8915";s:8:"category";s:3:"519";s:6:"parent";s:1:"0";s:4:"name";s:254:"Le calage de 1000 hPa étant affiché sur les deux appareils, 1 se rapproche d’une masse d’air froide tandis que 2 se rapproche d’une masse d’air chaude. A altitude indiquée constante, comment va évoluer l’altitude réelle des deux appareils:";s:12:"questiontext";s:338:"Le calage de 1000 hPa étant affiché sur les deux appareils, 1 se rapproche d’une masse d’air froide tandis que 2 se rapproche d’une masse d’air chaude. A altitude indiquée constante, comment va évoluer l’altitude réelle des deux appareils:<br><img src='https://bia-caea.fr/images/nav-1-2021.jpg' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:1140:"<font color="blue">L'altitude indiquée sur un altimètre est affectée par la pression atmosphérique</font color="blue">, qui change avec la température de l'air. Lorsqu'un avion se rapproche d'une masse d'air froide avec un calage altimétrique constant, la pression atmosphérique augmentera pour une altitude donnée, car l'air froid est plus dense. Cela fera lire une altitude plus élevée sur l'altimètre, donc si l'altitude indiquée reste constante, l'avion, en réalité, sera descendu. Inversement, si l'avion entre dans une masse d'air chaud, moins dense, la pression atmosphérique sera plus basse pour une altitude donnée, ce qui fera lire une altitude plus basse sur l'altimètre, donc si l'altitude indiquée reste constante, l'avion, en réalité, sera monté.
Si dans chacun des ULM, l'altitude indiquée reste constante alors l’altitude réelle de 1 diminue (en entrant dans une masse d'air froide) et l’altitude réelle de 2 augmente (en entrant dans une masse d'air chaude). D'où le dicton mnémotechnique : <font color="blue">"Plus chaud, plus haut, plus froid, plus bas."</font color="blue">
<b>Marin D.</b>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143231+An5xeQ";s:11:"timecreated";s:10:"1732113151";s:12:"timemodified";s:10:"1732113151";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8915";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8910";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"519";s:4:"name";s:48:"Navigation, réglementation, sécurité des vols";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143231+nXpM4x";s:6:"parent";s:3:"515";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8915";s:10:"questionid";s:4:"8915";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:33910;O:8:"stdClass":7:{s:2:"id";s:5:"33910";s:8:"question";s:4:"8915";s:6:"answer";s:71:"l’altitude réelle de 1 diminue et l’altitude réelle de 2 augmente";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33911;O:8:"stdClass":7:{s:2:"id";s:5:"33911";s:8:"question";s:4:"8915";s:6:"answer";s:71:"l’altitude réelle de 1 augmente et l’altitude réelle de 2 diminue";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33912;O:8:"stdClass":7:{s:2:"id";s:5:"33912";s:8:"question";s:4:"8915";s:6:"answer";s:51:"les altitudes réelles de 1 et 2 restent constantes";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33913;O:8:"stdClass":7:{s:2:"id";s:5:"33913";s:8:"question";s:4:"8915";s:6:"answer";s:58:"les deux altitudes réelles évoluent de la même manière";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}