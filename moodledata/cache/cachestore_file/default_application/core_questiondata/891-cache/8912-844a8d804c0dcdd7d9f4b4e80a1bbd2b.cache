O:8:"stdClass":26:{s:2:"id";s:4:"8912";s:8:"category";s:3:"519";s:6:"parent";s:1:"0";s:4:"name";s:126:"Pour afficher leur altitude par rapport au niveau moyen de la mer, les pilotes doivent afficher sur leur altimètre un calage:";s:12:"questiontext";s:210:"Pour afficher leur altitude par rapport au niveau moyen de la mer, les pilotes doivent afficher sur leur altimètre un calage:<br><img src='https://bia-caea.fr/images/nav-1-2021.jpg' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:1182:"<font color="blue">Le QNH est un calage altimétrique qui correspond à la pression atmosphérique au niveau de la mer</font color="blue"> dans les conditions météorologiques du moment. En réglant l'altimètre sur le QNH local fourni par les services météorologiques de l'aéroport ou de la région, l'altimètre indiquera l'altitude au-dessus du niveau moyen de la mer (AMSL).
Les autres options ne sont pas des calages altimétriques pour afficher l'altitude par rapport au niveau moyen de la mer: 
B) QFE est le calage qui affiche l'altitude par rapport au niveau de la piste de l'aéroport ;
C) AMSL n'est pas un calage, mais une abréviation pour "Above Mean Sea Level" ;
D) 1013 est le calage standard de pression (1013 mb ou hPa) utilisé pour voler en niveau de vol, pas pour afficher l'altitude par rapport au niveau de la mer.
<b>Dans l'exemple ci-contre</b>, le QNH et le QFE ont des valeurs plus petites que 1013 hPa. Parfois, le QNH peut être supérieur à 1013 hPa et pour des aérodromes à faible altitude le QFE peut aussi être supérieur à 1013 hPa.
<b>Marin D.</b><br><img src='https://bia-caea.fr/images/2021-anglais-03.jpg' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143231+0tO8pc";s:11:"timecreated";s:10:"1732113151";s:12:"timemodified";s:10:"1732113151";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8912";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8907";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"519";s:4:"name";s:48:"Navigation, réglementation, sécurité des vols";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143231+nXpM4x";s:6:"parent";s:3:"515";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8912";s:10:"questionid";s:4:"8912";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:33898;O:8:"stdClass":7:{s:2:"id";s:5:"33898";s:8:"question";s:4:"8912";s:6:"answer";s:3:"QNH";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33899;O:8:"stdClass":7:{s:2:"id";s:5:"33899";s:8:"question";s:4:"8912";s:6:"answer";s:3:"QFE";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33900;O:8:"stdClass":7:{s:2:"id";s:5:"33900";s:8:"question";s:4:"8912";s:6:"answer";s:4:"AMSL";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:33901;O:8:"stdClass":