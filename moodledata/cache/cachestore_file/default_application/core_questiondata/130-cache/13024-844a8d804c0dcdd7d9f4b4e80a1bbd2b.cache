O:8:"stdClass":26:{s:2:"id";s:5:"13024";s:8:"category";s:3:"746";s:6:"parent";s:1:"0";s:4:"name";s:73:"La première traversée de la Manche avec un aéronef a été réalisée:";s:12:"questiontext";s:73:"La première traversée de la Manche avec un aéronef a été réalisée:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:867:"Le vendredi 7 janvier <font color="blue">1785</font color="blue"> à 13h15, <font color="blue">Jean-Pierre Blanchard</font color="blue"> (français), fils d’ouvrier et autodidacte accompagné de son ami et mécène <font color="blue">John Jefferies</font color="blue"> (américain), décollent du château de Douvres, en Angleterre, à bord d’un <font color="blue">ballon gonflé à l’hydrogène</font color="blue">. Pour gagner en hauteur, ils jettent par-dessus bord presque tous les objets contenus dans la nacelle et même une partie de leurs vêtements. Les aéronautes finissent par s’échouer dans la forêt de Guînes, en France, vers 15h30. Ils viennent de réaliser la <font color="blue">première traversée aérienne de la manche</font color="blue">.<br><img src='https://bia-caea.fr/images/Jean-Pierre Blanchard01.jpg' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120145553+qxJOjA";s:11:"timecreated";s:10:"1732114553";s:12:"timemodified";s:10:"1732114553";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"805";s:6:"status";s:5:"ready";s:9:"versionid";s:5:"13024";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:5:"13019";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"746";s:4:"name";s:54:"Histoire et culture de l’aéronautique et du spatial";s:9:"contextid";s:3:"805";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120145553+ojby2M";s:6:"parent";s:3:"741";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id