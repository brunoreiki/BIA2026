O:8:"stdClass":26:{s:2:"id";s:5:"17482";s:8:"category";s:4:"1400";s:6:"parent";s:1:"0";s:4:"name";s:49:"Le nuage figurant sur la photo ci-dessous est un:";s:12:"questiontext";s:143:"Le nuage figurant sur la photo ci-dessous est un:<br><img width="100%" src='https://bia-caea.fr/images/m2_2017.jpg' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:727:"Lorsque l’atmosphère est instable, des bulles d’air chauffées par le sol, lui-même chauffé par le soleil, s’élèvent en se dilatant et se refroidissant jusqu’à ce que leur température soit la même que celle de l’air les environnant. Ces bulles sont des ascendances thermiques utilisées par les oiseaux, planeurs, deltaplanes et parapente pour monter en l’altitude.
Si la montée des bulles s’arrête avant qu’il y ait saturation de l’eau qu’elles contiennent, il n’y a pas d’apparition de nuage.
Si la montée continue au-delà de la saturation de l’eau, il y a apparition de cumulus.<br><img width="100%" src='https://bia-caea.fr/images/classification-nuages.jpg' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+250513070312+acFzYg";s:11:"timecreated";s:10:"1747119792";s:12:"timemodified";s:10:"1747119792";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"800";s:6:"status";s:5:"ready";s:9:"versionid";s:5:"17482";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:5:"17441";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:4:"1400";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"800";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+250513070312+IzB6AB";s:6:"parent";s:4:"1399";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:5:"17475";s:10:"questionid";s:5:"17482";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:68134;O:8:"stdClass":7:{s:2:"id";s:5:"68134";s:8:"question";s:5:"17482";s:6:"answer";s:12:"cumulonimbus";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:68135;O:8:"stdClass":7:{s:2:"id";s:5:"68135";s:8:"question";s:5:"17482";s:6:"answer";s:7:"cumulus";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:68136;O:8:"stdClass":7:{s:2:"id";s:5:"68136";s:8:"question";s:5:"17482";s:6:"answer";s:7:"stratus";s:12:"answerformat";s:1:"1"