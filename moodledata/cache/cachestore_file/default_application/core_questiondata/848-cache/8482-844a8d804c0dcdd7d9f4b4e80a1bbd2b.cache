O:8:"stdClass":26:{s:2:"id";s:4:"8482";s:8:"category";s:3:"498";s:6:"parent";s:1:"0";s:4:"name";s:69:"A proximité d'Amiens, vous apercevez la ville de Villers-Bretonneux:";s:12:"questiontext";s:69:"A proximité d'Amiens, vous apercevez la ville de Villers-Bretonneux:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:1380:"Sauf pour les besoins du décollage ou de l’atterrissage, les aéronefs monomoteur, à l’exclusion des hélicoptères, doivent se maintenir à une hauteur minimale de <font color="blue">500 ft (150m)</font> au-dessus du sol.  Cas particuliers : - <font color="blue">1000 ft (300m)</font> pour le survol d’usines isolées ; d’installations à caractère industriel ; d’hôpitaux, de centres de repos ou de tout autre établissement ou exploitation portant une marque distincte ; pour les vols suivant une direction parallèle à une autoroute et à proximité de celle-ci. - <font color="blue">1700 ft (500 m)</font> pour le survol de tout rassemblement de personnes < 10 000 ou d’animaux (plages, stades, réunions publiques, hippodromes, parcs à bestiaux, etc.) ; pour le survol de toute agglomération dont la largeur moyenne ne dépasse pas 1 200 mètres. - <font color="blue">3300 ft (1000 m)</font> pour le survol de tout rassemblement de 10 000 < personnes < 100 000 ; de toute ville dont la largeur moyenne est comprise entre 1 200 et 3 600 mètres. - <font color="blue">5000 ft (1500 m)</font> pour le survol de tout rassemblement de personnes > 100 000 ; de toute ville (Paris excepté car son survol est interdit) dont la largeur moyenne est supérieure à 3 600 mètres. <br><img src='https://bia-caea.fr/images/ville01.jpg' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143226+CLMU5Y";s:11:"timecreated";s:10:"1732113146";s:12:"timemodified";s:10:"1732113146";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8482";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8477";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"498";s:4:"name";s:48:"Navigation, réglementation, sécurité des vols";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143226+sekjcP";s:6:"parent";s:3:"494";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8482";s:10:"questionid";s:4:"8482";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:32178;O:8:"stdClass":7:{s:2:"id";s:5:"32178";s:8:"question";s:4:"8482";s:6:"answer";s:67:"vous pouvez la survoler à moins de 150 m pour saluer les habitants";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:32179;O:8:"stdClass":7:{s:2:"id";s:5:"32179";s:8:"question";s:4:"8482";s:6:"answer";s:88:"vous pouvez la survoler en vous maintenant exactement à 150 m au dessus des habitations";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:32180;O:8:"stdClass":7:{s:2:"id";s:5:"32180";s:8:"question";s:4:"8482";s:6:"answer";s:49:"vous devez obligatoirement éviter de la survoler";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:32181;O:8:"stdClass":7:{s:2:"id";s:5:"32181";s:8:"question";s:4:"8482";s:6:"answer";s:90:"vous pouvez la survoler mais à une altitude minimale dépendant de l'étendue de la ville";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}