O:8:"stdClass":26:{s:2:"id";s:4:"8477";s:8:"category";s:3:"498";s:6:"parent";s:1:"0";s:4:"name";s:207:"Au décollage de Péronne, votre instructeur vous demande d'être vigilant vis à vis des aéromodéles évoluant à proximité de l'aérodrome. En France, la fédération qui gère les aéromodéles est la:";s:12:"questiontext";s:207:"Au décollage de Péronne, votre instructeur vous demande d'être vigilant vis à vis des aéromodéles évoluant à proximité de l'aérodrome. En France, la fédération qui gère les aéromodéles est la:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:932:"<font color="blue">FFAM : Fédération Française d'AéroModélisme</font color="blue"> a été fondée en 1966

<font color="blue">FFA : la Fédération Française Aéronautique</font color="blue"> fondée en 1929 est une association qui regroupe, en France, la grande majorité des aéro-clubs pour, entre autre, développer et faciliter la connaissance et le rayonnement de l'aéronautique

<font color="blue">FFVP : La Fédération française de vol en planeur</font color="blue"> est une association regroupant les club de vol en planeur. La Fédération française de vol à voile est créée en 1966. En 2018, elle prend le nom de fédération française de vol en planeur.
<font color="blue">FFVL : La Fédération Française de Vol Libre</font color="blue"> est une association fondée en 1974. Elle gère six activités : le deltaplane, le parapente, le cerf-volant, le kite terrestre, le speed riding et le boomerang.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143226+pWVzp0";s:11:"timecreated";s:10:"1732113146";s:12:"timemodified";s:10:"1732113146";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8477";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8472";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"498";s:4:"name";s:48:"Navigation, réglementation, sécurité des vols";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143226+sekjcP";s:6:"parent";s:3:"494";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8477";s:10:"questionid";s:4:"8477";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:32158;O:8:"stdClass":7:{s:2:"id";s:5:"32158";s:8:"question";s:4:"8477";s:6:"answer";s:4:"FFAM";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:32159;O:8:"stdClass":7:{s:2:"id";s:5:"32159";s:8:"question";s:4:"8477";s:6:"answer";s:3:"FFA";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:32160;O:8:"stdClass":7:{s:2:"id";s:5:"32160";s:8:"question";s:4:"8477";s:6:"answ