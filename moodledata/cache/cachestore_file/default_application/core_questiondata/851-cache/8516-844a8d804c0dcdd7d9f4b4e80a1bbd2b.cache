O:8:"stdClass":26:{s:2:"id";s:4:"8516";s:8:"category";s:3:"499";s:6:"parent";s:1:"0";s:4:"name";s:168:"Un vaisseau spatial conçu pour emmener un équipage d’astronautes sur un astéroïde et
éventuellement sur Mars est mis au point pas la NASA. Il s’agit du projet:";s:12:"questiontext";s:168:"Un vaisseau spatial conçu pour emmener un équipage d’astronautes sur un astéroïde et
éventuellement sur Mars est mis au point pas la NASA. Il s’agit du projet:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:943:"<font color="blue">Le projet Orion</font color="blue"> fut la première étude de conception d'un véhicule spatial mû par propulsion nucléaire pulsée. Le projet, amorcé dans les années 1950, était mené par une équipe d'ingénieurs et de physiciens de General Atomics. En se basant sur l'énergie nucléaire, Orion aurait théoriquement permis d'obtenir à la fois une forte poussée et une importante impulsion spécifique, le Graal de la propulsion spatiale. En théorie, les performances offertes dépassaient de loin celles des meilleures fusées conventionnelles ou nucléaires alors à l'étude. <font color="blue">L'objectif était de permettre les voyages interplanétaires à bas coût.</font color="blue"> Pourtant, le projet perdit son soutien politique à cause des inquiétudes au sujet des contaminations provoquées par la propulsion. Le traité d'interdiction partielle des essais nucléaires de 1963 mit fin au projet.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143227+Cdhw8m";s:11:"timecreated";s:10:"1732113147";s:12:"timemodified";s:10:"1732113147";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8516";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8511";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"499";s:4:"name";s:54:"Histoire et culture de l’aéronautique et du spatial";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143226+a3mYq0";s:6:"parent";s:3:"494";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8516";s:10:"questionid";s:4:"8516";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15