O:8:"stdClass":26:{s:2:"id";s:4:"8401";s:8:"category";s:3:"495";s:6:"parent";s:1:"0";s:4:"name";s:92:"Le moyen le plus courant de mesure de la vitesse et de la direction du vent en altitude est:";s:12:"questiontext";s:92:"Le moyen le plus courant de mesure de la vitesse et de la direction du vent en altitude est:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:719:"Le vent est caractérisé par la mesure de deux grandeurs: celle de sa direction, qui correspond à sa direction angulaire par rapport nord, et celle de sa vitesse. La girouette pour mesurer sa direction et l’anémomètre pour mesurer sa vitesse sont utilisés au niveau du sol. Les ballons captifs, réutilisables, prennent ces mesures à quelques centaines de mètres. Les radiosondes, ballons gonflés à l’hélium, équipés d’instruments et qui transmettent les données au sol par radio atteignent une altitude de 30 km. Certains radars, les SODAR ainsi que les LIDAR, permettent par effet Doppler, depuis le sol ou l’espace, des mesures en continu des caractéristiques du vent à différentes altitudes.";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143226+dedpLz";s:11:"timecreated";s:10:"1732113146";s:12:"timemodified";s:10:"1732113146";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"8401";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"8396";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"495";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143226+4acbSE";s:6:"parent";s:3:"494";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"8401";s:10:"questionid";s:4:"8401";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"c