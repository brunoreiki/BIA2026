O:8:"stdClass":26:{s:2:"id";s:4:"9010";s:8:"category";s:3:"523";s:6:"parent";s:1:"0";s:4:"name";s:143:"Lorsque je navigue au QNH vers une dépression, et que je n'ai pas pu obtenir le nouveau QNH, quelle attitude dois-je adopter face aux reliefs:";s:12:"questiontext";s:143:"Lorsque je navigue au QNH vers une dépression, et que je n'ai pas pu obtenir le nouveau QNH, quelle attitude dois-je adopter face aux reliefs:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:798:"Lorsqu'un avion vole à une <font color="blue">altitude-pression</font color="blue"> constante indiquée par son altimètre, réglé par exemple à 1013,2 hPa (niveau de vol), il suit la surface isobarique 1013,2 hPA. Si l'altitude vraie de cette surface diminue, l'altitude vraie de l'avion diminue également. C'est le cas d'un avion volant d’une zone anticyclonique (Haute Pression) vers une zone dépressionnaire (Basse Pression).
L'explication de ce phénomène est que l'altimètre, qui est un baromètre, mesure le poids de la colonne d'air au-dessus de lui. Or, en entrant dans une dépression, pour obtenir un poids identique d'air au-dessus de lui, il lui faut se situer à une altitude plus basse.<br><img src='https://bia-caea.fr/images/PressionAvion.png' alt='Image de la solution'>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143231+gRZuE7";s:11:"timecreated";s:10:"1732113151";s:12:"timemodified";s:10:"1732113151";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"9010";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"9005";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"523";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143231+LlVDIj";s:6:"parent";s:3:"522";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"9010";s:10:"questionid";s:4:"9010";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:34290;O:8:"stdClass":7:{s:2:"id";s:5:"34290";s:8:"question";s:4:"9010";s:6:"answer";s:73:"aucune attitude particulière , la dépression ne modifie pas les reliefs";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34291;O:8:"stdClass":7:{s:2:"id";s:5:"34291";s:8:"question";s:4:"9010";s:6:"answer";s:124:"je sais que j'ai une marge de sécurité supplémentaire car mon altimètre indique une altitude supérieure à la réalité";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34292;O:8:"stdClass":7:{s:2:"id";s:5:"34292";s:8:"question";s:4:"9010";s:6:"answer";s:90:"je dois être vigilant car mon altimètre indique une altitude inférieure à la réalité";s:12:"answerformat";s:1:"1";s:8:"fraction";d:1;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34293;O:8:"stdClass":7:{s:2:"id";s:5:"34293";s:8:"question";s:4:"9010";s:6:"answer";s:27:"je passe en calage 1013 hPa";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}}}s:5:"hints";a:0:{}}