O:8:"stdClass":26:{s:2:"id";s:4:"9011";s:8:"category";s:3:"524";s:6:"parent";s:1:"0";s:4:"name";s:180:"En vol plané à une hauteur d'un mètre, celui-ci parcourt une distance de 5 mètres avant de tomber à terre, le sol étant horizontal. Que vaut sa finesse lors de ce vol plané:";s:12:"questiontext";s:268:"En vol plané à une hauteur d'un mètre, celui-ci parcourt une distance de 5 mètres avant de tomber à terre, le sol étant horizontal. Que vaut sa finesse lors de ce vol plané:<br><img src='https://bia-caea.fr/images/aerody_01_2022.jpg' alt='Image de la question'>";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:565:"La finesse d'un aéronef peut s'exprimer par les rapports:
<font color="blue">- vitesse horizontale / vitesse verticale
- portance/traînée
- distance horizontale parcourue / hauteur perdue</font color="blue">

Utilisons la formule avec les distances :
<font color="blue">finesse = distance horizontale parcourue / hauteur perdue</font color="blue">
<font color="red">finesse =</font color="red"> (5 mètres parcourus horizontalement) / (1 mètre de hauteur perdue) = <font color="red">5</font color="red">
<i>Remarque : la finesse est un nombre sans unité.</i>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+241120143232+r9aOX7";s:11:"timecreated";s:10:"1732113152";s:12:"timemodified";s:10:"1732113152";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"803";s:6:"status";s:5:"ready";s:9:"versionid";s:4:"9011";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:4:"9006";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:3:"524";s:4:"name";s:49:"Aérodynamique, aérostatique et principes du vol";s:9:"contextid";s:3:"803";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+241120143232+lQX3gP";s:6:"parent";s:3:"522";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:4:"9011";s:10:"questionid";s:4:"9011";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s:14:"shownumcorrect";s:1:"0";s:23:"showstandardinstruction";s:1:"1";s:7:"answers";a:4:{i:34294;O:8:"stdClass":7:{s:2:"id";s:5:"34294";s:8:"question";s:4:"9011";s:6:"answer";s:3:"0,5";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34295;O:8:"stdClass":7:{s:2:"id";s:5:"34295";s:8:"question";s:4:"9011";s:6:"answer";s:1:"1";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34296;O:8:"stdClass":7:{s:2:"id";s:5:"34296";s:8:"question";s:4:"9011";s:6:"answer";s:1:"2";s:12:"answerformat";s:1:"1";s:8:"fraction";d:0;s:8:"feedback";s:0:"";s:14:"feedbackformat";s:1:"1";}i:34297;O:8:"stdClass":7:{s:2:"id";s:5:"34297";s:8:"question";s:4:"9011";s:6