O:8:"stdClass":26:{s:2:"id";s:5:"17232";s:8:"category";s:4:"1386";s:6:"parent";s:1:"0";s:4:"name";s:129:"Dans un message aéronautique, le groupe de température indique +12°C sous abri, et +4°C de point de rosée. On peut dire que:";s:12:"questiontext";s:129:"Dans un message aéronautique, le groupe de température indique +12°C sous abri, et +4°C de point de rosée. On peut dire que:";s:18:"questiontextformat";s:1:"1";s:15:"generalfeedback";s:384:"<font color="blue">Le point de rosée</font color="blue"> est la température à laquelle l'air doit être refroidi pour atteindre la saturation (100% d'humidité) sans changer la pression ou le contenu en vapeur d'eau. Si l'air est à +12°C et le point de rosée est à +4°C, cela signifie que si la température de l'air descend à +4°C, l'air deviendra saturé. <b>Marin D.</b>";s:21:"generalfeedbackformat";s:1:"1";s:11:"defaultmark";d:1;s:7:"penalty";d:0.3333333;s:5:"qtype";s:11:"multichoice";s:6:"length";s:1:"1";s:5:"stamp";s:33:"bia-facile.fr+250513070309+MjiPmG";s:11:"timecreated";s:10:"1747119789";s:12:"timemodified";s:10:"1747119789";s:9:"createdby";s:1:"2";s:10:"modifiedby";s:1:"2";s:8:"idnumber";N;s:9:"contextid";s:3:"800";s:6:"status";s:5:"ready";s:9:"versionid";s:5:"17232";s:7:"version";s:1:"1";s:19:"questionbankentryid";s:5:"17191";s:14:"categoryobject";O:8:"stdClass":9:{s:2:"id";s:4:"1386";s:4:"name";s:28:"Météorologie et aérologie";s:9:"contextid";s:3:"800";s:4:"info";s:0:"";s:10:"infoformat";s:1:"0";s:5:"stamp";s:33:"bia-facile.fr+250513070308+be9Hd3";s:6:"parent";s:4:"1385";s:9:"sortorder";s:3:"999";s:8:"idnumber";N;}s:7:"options";O:8:"stdClass":15:{s:2:"id";s:5:"17225";s:10:"questionid";s:5:"17232";s:6:"layout";s:1:"0";s:6:"single";s:1:"1";s:14:"shuffleanswers";s:1:"0";s:15:"correctfeedback";s:0:"";s:21:"correctfeedbackformat";s:1:"1";s:24:"partiallycorrectfeedback";s:0:"";s:30:"partiallycorrectfeedbackformat";s:1:"1";s:17:"incorrectfeedback";s:0:"";s:23:"incorrectfeedbackformat";s:1:"1";s:15:"answernumbering";s:3:"abc";s